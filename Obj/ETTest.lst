  495: 2D01       	MOV A, #01h
  496: 370F       	B0MOV 0x87, #0Fh
  497: 1903       	OR 0x03, A
L662:
                  	                  	            lcd_bat_lack_en();
  498: 2903       	AND 0x03, A
L668:
                  	                  	            lcd_bat_lack_en();
  499: 2D04       	MOV A, #04h
  49A: 1903       	OR 0x03, A
L669:
                  	                  	        }
                  	                  	    #endif
                  	                  	}
  49B: 0E00       	RET
