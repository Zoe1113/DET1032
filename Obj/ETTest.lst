                  	                  		if( !Port_Debug && Port_Cal )
  C48: 74D5       	B0BTS0 0xD5.4
  C49: 8C5A       	JMP 0x0C5A
  C4A: 7BD5       	B0BTS1 0xD5.3
  C4B: 8C5A       	JMP 0x0C5A
L41:
                  	                  		{
                  	                  			if ( eTestmode_num == Insptectmode )
  C4C: 3701       	B0MOV 0x87, #01h
  C4D: 1E58       	MOV A, 0x58
  C4E: 0604       	CMPRS A, #04h
  C4F: 8C55       	JMP 0x0C55
L44:
                  	                  			{
                  	                  				 #if ParamModif
                  	                  				LED_CloseAll();
  C50: CBBD       	CALL 0x0BBD
L47:
                  	                  				eMain_Task = Task_ParamModifymode;	//生产模式短路debug口则进入系数调整模式
  C51: 2D07       	MOV A, #07h
  C52: 3700       	B0MOV 0x87, #00h
  C53: 1F33       	MOV 0x33, A
L48:
                  	                  	            #endif
