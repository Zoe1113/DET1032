_Function_main_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	ETH_2988_SJ_V1.0_20200704.c
                  	                  	说    明：	耳套可选,单位焊接选择,背光可选,物温可选
                  	                  	程序编码：	详见Variable.h
                  	                  	版    本：	V1.0
                  	                  	适用 PCB:	ETH PCB(A)
                  	                  	芯	  片:	SN8P2988
                  	                  	作    者:	Liaoy
                  	                  	修订记录：
                  	                  	1、在ET215-2988-242-V1.0-20190821基础上生成ETH程序；
                  	                  	V1.0：
                  	                  	采用宏定义合并程序，版本不升级，廖彦20200704
                  	                  	V1.0:
                  	                  	传感器表格也进行宏定义，与之PGA放大倍数也必须宏定义，版本升级为V1.6，廖彦20200723
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	
                  	                  	//主程序
                  	                  	void main(void)
                  	                  	{
                  	                  		//系统时钟设定
                  	                  	  	OSCM = 0x00;		//开启内置IHRC=8M，外置低速晶振32768，Fcpu=Normal mode
  CB8: 3700       	B0MOV 0x87, #00h
  CB9: 2BCA       	CLR 0xCA
L126:
                  	                  		Delay50us(100);
  CBA: 2D64       	MOV A, #64h
  CBB: 3702       	B0MOV 0x87, #02h
  CBC: 1FA3       	MOV 0xA3, A
  CBD: C77E       	CALL 0x077E
L127:
                  	                  	
                  	                  		//部分参数设置，如年月日时分秒
                  	                  		g_Hour = 0;
  CBE: 3700       	B0MOV 0x87, #00h
  CBF: 2B78       	CLR 0x78
L128:
                  	                  		g_Minute = 0;
  CC0: 2B79       	CLR 0x79
L129:
                  	                  		g_Day = 1;
  CC1: 2D01       	MOV A, #01h
  CC2: 1F7A       	MOV 0x7A, A
L130:
                  	                  		g_Month = 1;
  CC3: 1F7B       	MOV 0x7B, A
L131:
                  	                  		g_Year = Default_Year;
  CC4: 2DE7       	MOV A, #e7h
  CC5: 1F7C       	MOV 0x7C, A
  CC6: 2D07       	MOV A, #07h
  CC7: 1F7D       	MOV 0x7D, A
L132:
                  	                  		g_Second = 0;
  CC8: 2B7E       	CLR 0x7E
L133:
                  	                  		uSetFlag.bits.TimeFormat = TimeFormat_24H;	//默认24小时制
  CC9: 417F       	BCLR 0x7F.1
L134:
                  	                  		uSetFlag.bits.Unit = Unit_C;	//默认C单位
  CCA: 407F       	BCLR 0x7F.0
L135:
                  	                  	
                  	                  		#if CF_Change_Enable == 1
                  	                  			uSetFlag.bits.Unit_Change = Unit_Change_En;	//默认单位可切换
  CCB: 427F       	BCLR 0x7F.2
L136:
                  	                  		#else
                  	                  			uSetFlag.bits.Unit_Change = Unit_Change_Dis;	//默认单位可切换
                  	                  		#endif
                  	                  	
                  	                  		uSetFlag.bits.VoiceEnable = 1;        //默认开启语音
  CCC: 4B7F       	BSET 0x7F.3
L137:
                  	                  	
                  	                  		#if Func_Ble
                  	                  			uSetFlag.bits.BleEnable = Enable;
  CCD: 4D7F       	BSET 0x7F.5
L138:
                  	                  		#endif
                  	                  		
                  	                  		GPIO_Init();//IO口设置
  CCE: CC6C       	CALL 0x0C6C
L139:
                  	                  		Lcd_Init();	//Lcd设置
  CCF: E355       	CALL 0x2355
