  CCE: 2D02       	MOV A, #02h
  CCF: 3702       	B0MOV 0x87, #02h
  CD0: 1F4A       	MOV 0x4A, A
L143:
                  	                  		#endif
                  	                  	
                  	                  		eTestmode_num = Earmode;	//默认耳温模式
  CD1: 3701       	B0MOV 0x87, #01h
  CD2: 2B67       	CLR 0x67
L144:
                  	                  	    eAgemode_num = BigAge;
  CD3: 3700       	B0MOV 0x87, #00h
  CD4: 1F33       	MOV 0x33, A
L145:
                  	                  	
                  	                  		//低电压检测
                  	                  		#if Second_LVD == 1
                  	                  			LBT_Chk();
  CD5: CB77       	CALL 0x0B77
L146:
                  	                  		#else
                  	                  			LVD_Init();	//低电压设置
                  	                  			LVD_Chk();
                  	                  		#endif
                  	                  		if( uStaFlag.bits.LowBat )
  CD6: 5935       	BTS1 0x35.1
  CD7: 8CE8       	JMP 0x0CE8
L147:
                  	                  		{
                  	                  			Clr_Disp();
