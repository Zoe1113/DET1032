L44:
                  	                  		URCR1 = B9600 ;
  BED: 2DE6       	MOV A, #e6h
  BEE: 2F8D       	B0MOV URCR1, A
L45:
                  	                  		URRX1 = 0x84 ;		//Fuart (Fhosc=8Hz)=Fhosc/16，Enable UART RX，Disable UART RX parity bit function.
  BEF: 2D84       	MOV A, #84h
  BF0: 2F8C       	B0MOV URRX1, A
L46:
                  	                  		FURX1IEN = 1;		//RX必须在中断里接收
  BF1: 6DC9       	B0BSET INTEN0.5
L47:
                  	                  	}
  BF2: 0E00       	RET
