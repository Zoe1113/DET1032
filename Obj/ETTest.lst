_Function_HalKey_KeyClr_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void HalKey_KeyClr(void)
                  	                  	函数功能：	清除所有按键信息（非所有，重点部分）
                  	                  	输入参数：	g_KeyHold_Flag、g_KeyPress_Flag、g_KeyRelease_Flag、g_KeyContinue_Flag、g_Key_Val（键值）、g_Key_Status（按键状态）
                  	                  	输出参数：	g_KeyHold_Flag、g_KeyPress_Flag、g_KeyRelease_Flag、g_KeyContinue_Flag、g_Key_Val（键值）、g_Key_Status（按键状态）
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void HalKey_KeyClr(void)
                  	                  	{
                  	                  	    uKeyHold.g_KeyHold_Flag = 0;
  B45: 3701       	B0MOV 0x87, #01h
  B46: 2B16       	CLR 0x16
L749:
                  	                  	    uKeyPress.g_KeyPress_Flag = 0;
  B47: 2B17       	CLR 0x17
L750:
                  	                  	    uKeyRelease.g_KeyRelease_Flag = 0;
  B48: 2B15       	CLR 0x15
L751:
                  	                  	    uKeyContinue.g_KeyContinue_Flag = 0;
  B49: 2B14       	CLR 0x14
L752:
                  	                  	
                  	                  	    sMemKey.g_Key_Val = 0;
  B4A: 2B10       	CLR 0x10
L753:
                  	                  	    sTestKey.g_Key_Val = 0;
  B4B: 2B0B       	CLR 0x0B
L754:
                  	                  	    sSetKey.g_Key_Val = 0;
  B4C: 2B06       	CLR 0x06
L755:
                  	                  	#if Func_Probecover
                  	                  	    sEarcapKey.g_Key_Val = 0;
  B4D: 2B01       	CLR 0x01
L756:
                  	                  	#endif
                  	                  	
                  	                  	    sMemKey.g_Key_Status = 0;
  B4E: 2B11       	CLR 0x11
L757:
                  	                  	    sTestKey.g_Key_Status = 0;
  B4F: 2B0C       	CLR 0x0C
L758:
                  	                  	    sSetKey.g_Key_Status = 0;
  B50: 2B07       	CLR 0x07
L759:
                  	                  	#if Func_Probecover
                  	                  	    sEarcapKey.g_Key_Status = 0;
  B51: 2B02       	CLR 0x02
L760:
                  	                  	#endif
                  	                  	}
  B52: 0E00       	RET
_Function_LVD_Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LVD.c
                  	                  	说    明：	低电压处理函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Init(void)
                  	                  	函数功能：	low voltage初始化设置
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LVD_Init(void)
                  	                  	{
                  	                  		//internal lvd
                  	                  		LBTM = 0x10 ;		//低电压<2.6V，内部电压检测
  B53: 2D10       	MOV A, #10h
  B54: 2F95       	B0MOV LBTM, A
L35:
                  	                  		Delay50us(1) ;
  B55: 2D01       	MOV A, #01h
  B56: 3702       	B0MOV 0x87, #02h
  B57: 1FA3       	MOV 0xA3, A
  B58: C77E       	CALL 0x077E
L36:
                  	                  		FLBTEN = 1 ;		//enable low-voltage detect
  B59: 6895       	B0BSET 0x95.0
L37:
                  	                  	}
  B5A: 0E00       	RET
_Function_LVD_Chk_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Chk(void)
                  	                  	函数功能：	low voltage检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	100ms（Fcup=2M）
                  	                  	**************************************************************************/
                  	                  	void LVD_Chk(void)
                  	                  	{
                  	                  		uint8 i ;		//count with low-voltage
                  	                  	
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B5B: 3702       	B0MOV 0x87, #02h
  B5C: 2BA7       	CLR 0xA7
  B5D: 8B6C       	JMP 0x0B6C
L40:
                  	                  		{
                  	                  			Delay10ms(1) ;		//延迟10ms稳定
  B5E: 2D01       	MOV A, #01h
  B5F: 1FA3       	MOV 0xA3, A
  B60: C7A3       	CALL 0x07A3
L57:
                  	                  			if( FLBTO )			//FLBTO 1:低电压 0：正常电压
  B61: 7995       	B0BTS1 0x95.1
  B62: 8B66       	JMP 0x0B66
L58:
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 1 ;
  B63: 3700       	B0MOV 0x87, #00h
  B64: 4932       	BSET 0x32.1
L61:
                  	                  			}
  B65: 8B69       	JMP 0x0B69
L44:
                  	                  			else
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 0 ;
  B66: 3700       	B0MOV 0x87, #00h
  B67: 4132       	BCLR 0x32.1
L66:
                  	                  				break;
  B68: 8B70       	JMP 0x0B70
L67:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B69: 3702       	B0MOV 0x87, #02h
  B6A: 16A7       	INCMS 0xA7
  B6B: 0000       	NOP
L43:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B6C: 1EA7       	MOV A, 0xA7
  B6D: 240A       	SUB A, #0ah
  B6E: 7A86       	B0BTS1 0x86.2
  B6F: 8B5E       	JMP 0x0B5E
L42:
                  	                  			}
                  	                  		}
                  	                  	}
  B70: 0E00       	RET
_Function_LBT_Chk_code:
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LBT_Chk(void)
                  	                  	函数功能：	二级电压检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat,uStaFlag.bits.MidBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LBT_Chk(void)
                  	                  	{
                  	                  		// uStaFlag.bits.MidBat = 0;		
                  	                  		// uStaFlag.bits.LowBat = 1 ;
                  	                  		// return;		
                  	                  		uint8 i=0 ;				
  B71: 3702       	B0MOV 0x87, #02h
  B72: 2BA7       	CLR 0xA7
L109:
                  	                  		
                  	                  		/*先用2.7V的比较电压检测*/
                  	                  		LBTM = 0x14 ;		
  B73: 2D14       	MOV A, #14h
  B74: 2F95       	B0MOV LBTM, A
L110:
                  	                  		Delay50us(1) ;
  B75: 2D01       	MOV A, #01h
  B76: 1FA3       	MOV 0xA3, A
  B77: C77E       	CALL 0x077E
L111:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  B78: 6895       	B0BSET 0x95.0
L112:
                  	                  	
                  	                  		/*若低电压连续有十次，则置低电压标志为1，清低电压计数*/
                  	                  		for( i=0; i<10; i++ )	
  B79: 2BA7       	CLR 0xA7
  B7A: 8B8A       	JMP 0x0B8A
L78:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;		
  B7B: 2D01       	MOV A, #01h
  B7C: 1FA3       	MOV 0xA3, A
  B7D: C7A3       	CALL 0x07A3
L117:
                  	                  			/* FLBTO 1:低电压 0：正常电压 */
                  	                  			if( FLBTO )			
  B7E: 7995       	B0BTS1 0x95.1
  B7F: 8B83       	JMP 0x0B83
L118:
                  	                  			{
                  	                  				/*二级电压第一级标志位打开*/
                  	                  				uStaFlag.bits.MidBat = 1;
  B80: 3700       	B0MOV 0x87, #00h
  B81: 4D32       	BSET 0x32.5
L121:
                  	                  			}
  B82: 8B87       	JMP 0x0B87
L82:
                  	                  			/*如果有一次未检测到*/
                  	                  			else
                  	                  			{
                  	                  				/*清除标志位并返回*/
                  	                  				uStaFlag.bits.MidBat = 0;		
  B83: 3700       	B0MOV 0x87, #00h
  B84: 4532       	BCLR 0x32.5
L126:
                  	                  				uStaFlag.bits.LowBat = 0 ;
  B85: 4132       	BCLR 0x32.1
L127:
                  	                  				return;		
  B86: 8BAC       	JMP 0x0BAC
L128:
                  	                  		for( i=0; i<10; i++ )	
  B87: 3702       	B0MOV 0x87, #02h
  B88: 16A7       	INCMS 0xA7
  B89: 0000       	NOP
L81:
                  	                  		for( i=0; i<10; i++ )	
  B8A: 1EA7       	MOV A, 0xA7
  B8B: 240A       	SUB A, #0ah
  B8C: 7A86       	B0BTS1 0x86.2
  B8D: 8B7B       	JMP 0x0B7B
L134:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果连续十次小于2.7v，判断有没有低于2.6v*/
                  	                  		/*选择2.6v作为比较电压*/
                  	                  		LBTM = 0x10 ;		
  B8E: 2D10       	MOV A, #10h
  B8F: 2F95       	B0MOV LBTM, A
L137:
                  	                  		Delay50us(1) ;
  B90: 2D01       	MOV A, #01h
  B91: 1FA3       	MOV 0xA3, A
  B92: C77E       	CALL 0x077E
L138:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  B93: 6895       	B0BSET 0x95.0
L139:
                  	                  	
                  	                  		for( i=0; i<10; i++ )	
  B94: 2BA7       	CLR 0xA7
  B95: 8BA4       	JMP 0x0BA4
L90:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;	
  B96: 2D01       	MOV A, #01h
  B97: 1FA3       	MOV 0xA3, A
  B98: C7A3       	CALL 0x07A3
L144:
                  	                  			/*FLBTO 1:低电压 0：正常电压*/
                  	                  			if( FLBTO )			
  B99: 7995       	B0BTS1 0x95.1
  B9A: 8B9E       	JMP 0x0B9E
L145:
                  	                  			{
                  	                  				/*二级电压第二级标志位打开*/
                  	                  				uStaFlag.bits.LowBat = 1 ;	
  B9B: 3700       	B0MOV 0x87, #00h
  B9C: 4932       	BSET 0x32.1
L148:
                  	                  			}
  B9D: 8BA1       	JMP 0x0BA1
L94:
                  	                  			else
                  	                  			{
                  	                  				/*如果有一次大于2.6V*/
                  	                  				uStaFlag.bits.LowBat = 0 ;
  B9E: 3700       	B0MOV 0x87, #00h
  B9F: 4132       	BCLR 0x32.1
L153:
                  	                  				return;		
  BA0: 8BAC       	JMP 0x0BAC
L154:
                  	                  		for( i=0; i<10; i++ )	
  BA1: 3702       	B0MOV 0x87, #02h
  BA2: 16A7       	INCMS 0xA7
  BA3: 0000       	NOP
L93:
                  	                  		for( i=0; i<10; i++ )	
  BA4: 1EA7       	MOV A, 0xA7
  BA5: 240A       	SUB A, #0ah
  BA6: 7A86       	B0BTS1 0x86.2
  BA7: 8B96       	JMP 0x0B96
L160:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果二级电压第二级标志位打开*/
                  	                  		if(uStaFlag.bits.LowBat == 1)
  BA8: 3700       	B0MOV 0x87, #00h
  BA9: 5932       	BTS1 0x32.1
  BAA: 8BAC       	JMP 0x0BAC
L163:
                  	                  		{
                  	                  			/*二级电压第一级标志位关闭*/
                  	                  			uStaFlag.bits.MidBat = 0;
  BAB: 4532       	BCLR 0x32.5
L166:
                  	                  		}
                  	                  		return;
                  	                  	}
  BAC: 0E00       	RET
_Function_Drv_Led_Set_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LED.c
                  	                  	说    明：	LED驱动函数集合（中间层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	
                  	                  	//底层驱动（io is sink mode）
                  	                  	void Drv_Led_Set(void)
                  	                  	{
                  	                  		FP55M = 1;		//输出为0
  BAD: 6DC5       	B0BSET 0xC5.5
L35:
                  	                  		FP56M = 1;		//输出为0
  BAE: 6EC5       	B0BSET 0xC5.6
L36:
                  	                  		FP57M = 1;		//输出为0
  BAF: 6FC5       	B0BSET 0xC5.7
L37:
                  	                  		LED_CloseAll();
  BB0: CBB2       	CALL 0x0BB2
L38:
                  	                  	}
  BB1: 0E00       	RET
