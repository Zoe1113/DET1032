  C89: 728B       	B0BTS0 URTX1.2
  C8A: 8C89       	JMP 0x0C89
L105:
                  	                  		if(FUTX1BZ==0)
  C8B: 728B       	B0BTS0 URTX1.2
  C8C: 8C92       	JMP 0x0C92
L106:
                  	                  			UTX1D = data >> 8 ;
  C8D: 2D00       	MOV A, #00h
  C8E: 2F19       	B0MOV 0x19, A
  C8F: 3702       	B0MOV 0x87, #02h
  C90: 1EA6       	MOV A, 0xA6
  C91: 2F8E       	B0MOV UTX1D, A
L79:
                  	                  			NOP(5);
  C92: 0000       	NOP
  C93: 0000       	NOP
  C94: 0000       	NOP
  C95: 0000       	NOP
  C96: 0000       	NOP
L108:
                  	                  		while(FUTX1BZ);
  C97: 728B       	B0BTS0 URTX1.2
  C98: 8C97       	JMP 0x0C97
L111:
                  	                  		if(FUTX1BZ==0)
  C99: 728B       	B0BTS0 URTX1.2
  C9A: 8C9E       	JMP 0x0C9E
L112:
                  	                  			UTX1D = data ;
  C9B: 3702       	B0MOV 0x87, #02h
  C9C: 1EA5       	MOV A, 0xA5
  C9D: 2F8E       	B0MOV UTX1D, A
L84:
                  	                  			NOP(5);
  C9E: 0000       	NOP
  C9F: 0000       	NOP
  CA0: 0000       	NOP
  CA1: 0000       	NOP
  CA2: 0000       	NOP
L114:
                  	                  		while(FUTX1BZ);
  CA3: 728B       	B0BTS0 URTX1.2
  CA4: 8CA3       	JMP 0x0CA3
L117:
                  	                  	}
  CA5: 0E00       	RET
_Function_Uart_Send_Wakeup_code:
                  	                  	void Uart_Send_Wakeup(void)
                  	                  	{
                  	                  		char Count = 0;
  CA6: 2BA4       	CLR 0xA4
L120:
                  	                  		while(FUTX1BZ);
  CA7: 728B       	B0BTS0 0x8B.2
  CA8: 8CA7       	JMP 0x0CA7
L137:
                  	                  		for(Count=0;Count<10;Count++)
  CA9: 2BA4       	CLR 0xA4
L123:
                  	                  		{
                  	                  			if(FUTX1BZ==0)
  CAA: 728B       	B0BTS0 0x8B.2
  CAB: 8CAE       	JMP 0x0CAE
L142:
                  	                  				UTX1D = 0xFF ;
  CAC: 2DFF       	MOV A, #ffh
  CAD: 2F8E       	B0MOV UTX1D, A
L127:
                  	                  			NOP(5);
  CAE: 0000       	NOP
  CAF: 0000       	NOP
  CB0: 0000       	NOP
  CB1: 0000       	NOP
  CB2: 0000       	NOP
L144:
                  	                  			while(FUTX1BZ);
  CB3: 728B       	B0BTS0 URTX1.2
  CB4: 8CB3       	JMP 0x0CB3
L147:
                  	                  		for(Count=0;Count<10;Count++)
  CB5: 16A4       	INCMS 0xA4
  CB6: 0000       	NOP
L150:
                  	                  		for(Count=0;Count<10;Count++)
  CB7: 1EA4       	MOV A, 0xA4
  CB8: 1D80       	XOR A, #80h
  CB9: 248A       	SUB A, #8ah
  CBA: 7A86       	B0BTS1 0x86.2
  CBB: 8CAA       	JMP 0x0CAA
L151:
                  	                  		}
                  	                  	}
  CBC: 0E00       	RET
_Function_Cal_Inspect_Detect_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_GPIO.c
                  	                  	说    明：	GPIO初始化函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	Cal_Inspect_Detect()
                  	                  	函数功能：	校准模式、绑定模式入口检测
                  	                  	输入参数：	Port_Debug、Port_Cal
                  	                  	输出参数：	uSetFlag
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Cal_Inspect_Detect(void)
                  	                  	{
                  	                  		//绑定检测模式、校温检测模式、系数调整模式判断
                  	                  		if( !Port_Debug && Port_Cal )
  CBD: 74D5       	B0BTS0 0xD5.4
  CBE: 8CCF       	JMP 0x0CCF
  CBF: 7BD5       	B0BTS1 0xD5.3
  CC0: 8CCF       	JMP 0x0CCF
L41:
                  	                  		{
                  	                  			if ( eTestmode_num == Insptectmode )
  CC1: 3701       	B0MOV 0x87, #01h
  CC2: 1E66       	MOV A, 0x66
  CC3: 0604       	CMPRS A, #04h
  CC4: 8CCA       	JMP 0x0CCA
L44:
                  	                  			{
                  	                  				 #if ParamModif
                  	                  				LED_CloseAll();
  CC5: CC33       	CALL 0x0C33
L47:
                  	                  				eMain_Task = Task_ParamModifymode;	//生产模式短路debug口则进入系数调整模式
  CC6: 2D07       	MOV A, #07h
  CC7: 3700       	B0MOV 0x87, #00h
  CC8: 1F33       	MOV 0x33, A
L48:
                  	                  	            #endif
                  	                  	        }
  CC9: 8CCF       	JMP 0x0CCF
L34:
                  	                  			else
                  	                  			{
                  	                  				eSetTask = Set_Unit;		//设置态恢复状态
  CCA: 2B6A       	CLR 0x6A
L53:
                  	                  				F_FirstEnter_SetMode = 0;
  CCB: 3700       	B0MOV 0x87, #00h
  CCC: 4220       	BCLR 0x20.2
L54:
                  	                  				eMain_Task = Task_BondTestmode;	//用户模式下短路debug进入绑定检测模式
  CCD: 2D06       	MOV A, #06h
  CCE: 1F33       	MOV 0x33, A
L55:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		//设置态决不允许进入校温，汇编和C的程序结构不一样，未初始化adc
                  	                  		if( !Port_Cal && !Port_Debug && eMain_Task == Task_ReadyMode )
  CCF: 73D5       	B0BTS0 0xD5.3
  CD0: 8CDA       	JMP 0x0CDA
  CD1: 74D5       	B0BTS0 0xD5.4
  CD2: 8CDA       	JMP 0x0CDA
  CD3: 3700       	B0MOV 0x87, #00h
  CD4: 2533       	DECS 0x33
  CD5: 8CDA       	JMP 0x0CDA
L60:
                  	                  		{
                  	                  	        #if Func_Ble
                  	                  	            F_Ble_En = Disable;         //进入校准关闭蓝牙
  CD6: 4348       	BCLR 0x48.3
L63:
                  	                  	            Port_Ble_En = 0;            //蓝牙失能
  CD7: 63D2       	B0BCLR 0xD2.3
L64:
                  	                  	        #endif
                  	                  			eMain_Task = Task_Calimode;		//用户模式下短路debug和cal进入校温模式
  CD8: 2D05       	MOV A, #05h
  CD9: 1F33       	MOV 0x33, A
L65:
                  	                  		}
                  	                  	}
  CDA: 0E00       	RET
_Function_CF_Check_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	CF_Check()
                  	                  	函数功能：	单位状态、单位可切换状态查询
                  	                  	输入参数：	Port_CF、Port_Change_CF
                  	                  	输出参数：	uSetFlag
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void CF_Check(void)
                  	                  	{
                  	                  		//单位状态检测
                  	                  		uSetFlag.bits.Unit = Unit_C;
  CDB: 3700       	B0MOV 0x87, #00h
  CDC: 407F       	BCLR 0x7F.0
L79:
                  	                  		if( !Port_CF )
  CDD: 72D5       	B0BTS0 0xD5.2
  CDE: 8CE0       	JMP 0x0CE0
L80:
                  	                  		{
                  	                  			uSetFlag.bits.Unit = Unit_F;
  CDF: 487F       	BSET 0x7F.0
L83:
                  	                  		}
                  	                  	
                  	                  	}
  CE0: 0E00       	RET
_Function_GPIO_Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	GPIO_Init()
                  	                  	函数功能：	IO口初始化设置
                  	                  	输入参数：	P0、P1、P2、P3、P4、P5
                  	                  	输出参数：	P0、P1、P2、P3、P4、P5
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void GPIO_Init(void)
                  	                  	{
                  	                  		//SDA/SCL输出为0(因为采用的是硬体I2C),按键输入上拉高电平,XIN/XOUT输入不上拉0
                  	                  		//0: input mode, 1: output mode
                  	                  		P0M = 0x0C;			//0b 0000 1100
  CE1: 2D0C       	MOV A, #0ch
  CE2: 2FC0       	B0MOV P0M, A
L91:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P0UR = 0x13;		//0b 0001 0011
  CE3: 2D13       	MOV A, #13h
  CE4: 2FE0       	B0MOV P0UR, A
L92:
                  	                  		//0: low level, 1: high level
                  	                  		P0 = 0x1F;			//0b 0001 1111
  CE5: 2D1F       	MOV A, #1fh
  CE6: 2FD0       	B0MOV P0, A
L93:
                  	                  	 
                  	                  		//白灯输出不上拉高电平,MOSI输出不上拉高电平,MISO输入不上拉高电平,SCK输出不上拉高电平,TX输入不上拉高电平（防止向BLE供电）,RX输入不上拉,VOC_EN,BLE_LINK输入不上拉1
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0x4F;			//0b0100 1111
  CE7: 2D4F       	MOV A, #4fh
  CE8: 2FC1       	B0MOV P1M, A
L94:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
  CE9: 2DFF       	MOV A, #ffh
  CEA: 2FB5       	B0MOV P1SEG, A
L95:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0xC0;		//0b1100 0000
  CEB: 2DC0       	MOV A, #c0h
  CEC: 2FE1       	B0MOV P1UR, A
L96:
                  	                  		//0: low level, 1: high lDevel
                  	                  		P1 = 0xB9;			//0b1011 1001
  CED: 2DB9       	MOV A, #b9h
  CEE: 2FD1       	B0MOV P1, A
L97:
                  	                  	
                  	                  		//P25-P27为seg口，LINK脚输入 不上拉 高,EN输出 上拉 低，BUSY输入不上拉高，G320_EN输出不上拉高，VOC_EN输出不上拉低
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x0B;			//0b0000 1011
  CEF: 2D0B       	MOV A, #0bh
  CF0: 2FC2       	B0MOV P2M, A
L98:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b0001 1111,P25-P27均为LCD口
  CF1: 2D1F       	MOV A, #1fh
  CF2: 2FB2       	B0MOV P2SEG, A
L99:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x08;		//0b0000 1000
  CF3: 2D08       	MOV A, #08h
  CF4: 2FDD       	B0MOV P2UR, A
L100:
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x16;			//0b0001 0110
  CF5: 2D16       	MOV A, #16h
  CF6: 2FD2       	B0MOV P2, A
L101:
                  	                  	
                  	                  		//C/、CF、CAL、Debug输入上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P5M = 0xE0;			//0b1110 0000
  CF7: 2DE0       	MOV A, #e0h
  CF8: 2FC5       	B0MOV P5M, A
L102:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P5SEG = 0xFF;		//0b1111 1111
  CF9: 2DFF       	MOV A, #ffh
  CFA: 2FB7       	B0MOV P5SEG, A
L103:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P5UR = 0x1E;		//0b0001 1110
  CFB: 2D1E       	MOV A, #1eh
  CFC: 2FD7       	B0MOV P5UR, A
L104:
                  	                  		//0: low level, 1: high level
                  	                  		P5 = 0xFE;			//0b1111 1110
  CFD: 2DFE       	MOV A, #feh
  CFE: 2FD5       	B0MOV P5, A
L105:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P3M = 0x00;			//均为LCD口
  CFF: 3700       	B0MOV 0x87, #00h
  D00: 2BC3       	CLR 0xC3
L106:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P3SEG = 0x00;		//均为LCD口
  D01: 2BB3       	CLR 0xB3
L107:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P3UR = 0x00;		//均为LCD口
  D02: 2BDE       	CLR 0xDE
L108:
                  	                  		//0: low level, 1: high level
                  	                  		P3 = 0x00;			//均为LCD口
  D03: 2BD3       	CLR 0xD3
L109:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P4M = 0x00;			//均为LCD口
  D04: 2BC4       	CLR 0xC4
L110:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P4SEG = 0x00;		//均为LCD口
  D05: 2BB6       	CLR 0xB6
L111:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P4UR = 0x00;		//均为LCD口
  D06: 2BD6       	CLR 0xD6
L112:
                  	                  		//0: low level, 1: high level
                  	                  		P4 = 0x00;			//均为LCD口
  D07: 2BD4       	CLR 0xD4
L113:
                  	                  	}
  D08: 0E00       	RET
_Function_GPIO_PowerDown_code:
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	GPIO_PowerDown()
                  	                  	函数功能：	IO口初始化设置
                  	                  	输入参数：	P0、P1、P2、P3、P4、P5
                  	                  	输出参数：	P0、P1、P2、P3、P4、P5
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void GPIO_PowerDown( void )
                  	                  	{
                  	                  		//按键输入上拉高电平,XIN/XOUT输入不上拉0,E2供电口输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P0M = 0x2C;			//0b0010 1100
  D09: 2D2C       	MOV A, #2ch
  D0A: 2FC0       	B0MOV P0M, A
L119:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P0UR = 0x13;		//0b0001 0011
  D0B: 2D13       	MOV A, #13h
  D0C: 2FE0       	B0MOV P0UR, A
L120:
                  	                  		//0: low level, 1: high level
                  	                  		P0 = 0x1F;			//0b0001 1111
  D0D: 2D1F       	MOV A, #1fh
  D0E: 2FD0       	B0MOV P0, A
L121:
                  	                  	
                  	                  		//BZ不上拉输出0,TX输出不上拉低电平,RX为I2C供电口不上拉输出0,其余未使用输入上拉高
                  	                  	
                  	                  	#if !Func_Ble
                  	                  		//白灯输入上拉高，按键输入上拉高电平,BZ/MOSI/MISO/TX/RX/SCK均输出不上拉低，
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0xFE;			//0b 1111 1110
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0x01;		//0b 0100 0001
                  	                  		//0: low level, 1: high level
                  	                  		P1 = 0x01;			//0b 0100 0001
                  	                  	
                  	                  		//P25-P27为seg口，BLE_Link、BLE_EN、BLE_BUSY、G320_EN输出不上拉低，VOC_EN输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x03;			//0b 0000 0011
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b 0001 1111,P25-P27均为LCD口
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x1D;		//0b 0001 1101
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x1D;			//0b 0001 1101
                  	                  	#else
                  	                  		//按键输出不上拉低,，SCK/RX1/TX1/MISO/MOSI/BZ输出不上拉低,白灯输入上拉高，
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0xFE;			//0b 1111 1110
  D0F: 2DFE       	MOV A, #feh
  D10: 2FC1       	B0MOV P1M, A
L122:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
  D11: 2DFF       	MOV A, #ffh
  D12: 2FB5       	B0MOV P1SEG, A
L123:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0x01;		//0b 0000 0001
  D13: 2D01       	MOV A, #01h
  D14: 2FE1       	B0MOV P1UR, A
L124:
                  	                  		//0: low level, 1: high level
                  	                  		P1 = 0x01;			//0b 0000 0001
  D15: 2FD1       	B0MOV P1, A
L125:
                  	                  	
                  	                  		//P25-P27为seg口，BLE_Link、BLE_EN、BLE_BUSY、G320_EN输出不上拉低，VOC_EN输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x1F;			//0b 0001 1111
  D16: 2D1F       	MOV A, #1fh
  D17: 2FC2       	B0MOV P2M, A
L126:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b 0001 1111,P25-P27均为LCD口
  D18: 2FB2       	B0MOV P2SEG, A
L127:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x01;		//0b 0000 0001
  D19: 2D01       	MOV A, #01h
  D1A: 2FDD       	B0MOV P2UR, A
L128:
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x01;			//0b 0000 0001
  D1B: 2FD2       	B0MOV P2, A
L129:
                  	                  	#endif
                  	                  	
                  	                  		//RGB输入上拉高，CAL/Debug输入上拉高电平,C/F、CF输出不上拉0，MOTOR输出不上拉低
                  	                  	    //0: input mode, 1: output mode
                  	                  	    P5M = 0x07;			//0b0000 0111
  D1C: 2D07       	MOV A, #07h
  D1D: 2FC5       	B0MOV P5M, A
L130:
                  	                  	    //0: LCD functon pin, 1: IO pin
                  	                  	    P5SEG = 0xFF;		//0b1111 1111
  D1E: 2DFF       	MOV A, #ffh
  D1F: 2FB7       	B0MOV P5SEG, A
L131:
                  	                  	    //0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  	    P5UR = 0xF8;		//0b1111 1000
  D20: 2DF8       	MOV A, #f8h
  D21: 2FD7       	B0MOV P5UR, A
L132:
                  	                  	    //0: low level, 1: high level
                  	                  	    P5 = 0xF8;			//0b1111 1000
  D22: 2FD5       	B0MOV P5, A
L133:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P3M = 0x00;			//均为LCD口
  D23: 3700       	B0MOV 0x87, #00h
  D24: 2BC3       	CLR 0xC3
L134:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P3SEG = 0x00;		//均为LCD口
  D25: 2BB3       	CLR 0xB3
L135:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P3UR = 0x00;		//均为LCD口
  D26: 2BDE       	CLR 0xDE
L136:
                  	                  		//0: low level, 1: high level
