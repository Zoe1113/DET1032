 2AE0: 2B5B       	CLR 0x5B
L661:
                  	                  		nb_FourSecTick  = 0;
 2AE1: 2B5C       	CLR 0x5C
L662:
                  	                  		nb_FourSecCycle = 0;
 2AE2: 2B5D       	CLR 0x5D
L663:
                  	                  		nb_FourSecTotal = g_5s_Count / 100;
 2AE3: 3100       	B0MOV 0x81, #00h
 2AE4: 3018       	B0MOV 0x80, #18h
 2AE5: 3402       	B0MOV 0x84, #02h
 2AE6: 3351       	B0MOV 0x83, #51h
 2AE7: 3200       	B0MOV 0x82, #00h
 2AE8: 2D64       	MOV A, #64h
 2AE9: FBD0       	CALL 0x3BD0
 2AEA: F97E       	CALL 0x397E
 2AEB: 2E18       	B0MOV A, 0x18
 2AEC: 3702       	B0MOV 0x87, #02h
 2AED: 1F5E       	MOV 0x5E, A
L664:
