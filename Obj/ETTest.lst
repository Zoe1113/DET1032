L54:
                  	                  		FP14M = 0;			//TX输入
  C3E: 64C1       	B0BCLR 0xC1.4
L55:
                  	                  	}
  C3F: 0E00       	RET
_Function_Drv_UartRX_Disable_code:
                  	                  	
                  	                  	/**************************************************************************
