  C67: 0000       	NOP
  C68: 0000       	NOP
L108:
                  	                  		while(FUTX1BZ);
  C69: 728B       	B0BTS0 URTX1.2
  C6A: 8C69       	JMP 0x0C69
L111:
                  	                  		if(FUTX1BZ==0)
  C6B: 728B       	B0BTS0 URTX1.2
  C6C: 8C70       	JMP 0x0C70
L112:
                  	                  			UTX1D = data ;
  C6D: 3702       	B0MOV 0x87, #02h
