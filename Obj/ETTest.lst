  2DC: 1819       	OR A, 0x19
  2DD: 7886       	B0BTS1 0x86.0
  2DE: 82E1       	JMP 0x02E1
L398:
                  	                  				return 1;
  2DF: 2D01       	MOV A, #01h
  2E0: 82E2       	JMP 0x02E2
L382:
                  	                  			else
                  	                  				return 0;
  2E1: 2D00       	MOV A, #00h
L400:
                  	                  		}
                  	                  	}
  2E2: 0E00       	RET
