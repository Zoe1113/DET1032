_Function_LVD_Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LVD.c
                  	                  	说    明：	低电压处理函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Init(void)
                  	                  	函数功能：	low voltage初始化设置
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LVD_Init(void)
                  	                  	{
                  	                  		//internal lvd
                  	                  		LBTM = 0x10 ;		//低电压<2.6V，内部电压检测
  B5E: 2D10       	MOV A, #10h
  B5F: 2F95       	B0MOV LBTM, A
L35:
                  	                  		Delay50us(1) ;
  B60: 2D01       	MOV A, #01h
  B61: 3702       	B0MOV 0x87, #02h
  B62: 1FA3       	MOV 0xA3, A
  B63: C77E       	CALL 0x077E
L36:
                  	                  		FLBTEN = 1 ;		//enable low-voltage detect
  B64: 6895       	B0BSET 0x95.0
L37:
                  	                  	}
  B65: 0E00       	RET
_Function_LVD_Chk_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Chk(void)
                  	                  	函数功能：	low voltage检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	100ms（Fcup=2M）
                  	                  	**************************************************************************/
                  	                  	void LVD_Chk(void)
                  	                  	{
                  	                  		uint8 i ;		//count with low-voltage
                  	                  	
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B66: 3702       	B0MOV 0x87, #02h
  B67: 2BA7       	CLR 0xA7
  B68: 8B77       	JMP 0x0B77
L40:
                  	                  		{
                  	                  			Delay10ms(1) ;		//延迟10ms稳定
  B69: 2D01       	MOV A, #01h
  B6A: 1FA3       	MOV 0xA3, A
  B6B: C7A3       	CALL 0x07A3
L57:
                  	                  			if( FLBTO )			//FLBTO 1:低电压 0：正常电压
  B6C: 7995       	B0BTS1 0x95.1
  B6D: 8B71       	JMP 0x0B71
L58:
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 1 ;
  B6E: 3700       	B0MOV 0x87, #00h
  B6F: 4932       	BSET 0x32.1
L61:
                  	                  			}
  B70: 8B74       	JMP 0x0B74
L44:
                  	                  			else
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 0 ;
  B71: 3700       	B0MOV 0x87, #00h
  B72: 4132       	BCLR 0x32.1
L66:
                  	                  				break;
  B73: 8B7B       	JMP 0x0B7B
L67:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B74: 3702       	B0MOV 0x87, #02h
  B75: 16A7       	INCMS 0xA7
  B76: 0000       	NOP
L43:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B77: 1EA7       	MOV A, 0xA7
  B78: 240A       	SUB A, #0ah
  B79: 7A86       	B0BTS1 0x86.2
  B7A: 8B69       	JMP 0x0B69
L42:
                  	                  			}
                  	                  		}
                  	                  	}
  B7B: 0E00       	RET
