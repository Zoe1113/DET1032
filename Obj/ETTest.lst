  C4D: 4448       	BCLR 0x48.4
L55:
                  	                  					Port_Ble_En = 0;
  C4E: 63D2       	B0BCLR 0xD2.3
L56:
                  	                  				#endif
                  	                  				eMain_Task = Task_BondTestmode;	//用户模式下短路debug进入绑定检测模式
  C4F: 2D06       	MOV A, #06h
  C50: 1F33       	MOV 0x33, A
L57:
                  	                  			}
