L154:
                  	                  		for( i=0; i<10; i++ )	
  BA1: 3702       	B0MOV 0x87, #02h
  BA2: 16A7       	INCMS 0xA7
  BA3: 0000       	NOP
L93:
                  	                  		for( i=0; i<10; i++ )	
  BA4: 1EA7       	MOV A, 0xA7
  BA5: 240A       	SUB A, #0ah
  BA6: 7A86       	B0BTS1 0x86.2
  BA7: 8B96       	JMP 0x0B96
L160:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果二级电压第二级标志位打开*/
                  	                  		if(uStaFlag.bits.LowBat == 1)
  BA8: 3700       	B0MOV 0x87, #00h
  BA9: 5932       	BTS1 0x32.1
  BAA: 8BAC       	JMP 0x0BAC
L163:
                  	                  		{
                  	                  			/*二级电压第一级标志位关闭*/
                  	                  			uStaFlag.bits.MidBat = 0;
  BAB: 4532       	BCLR 0x32.5
L166:
                  	                  		}
                  	                  		return;
                  	                  	}
  BAC: 0E00       	RET
_Function_Drv_Led_Set_code:
                  	                  	/**************************************************************************
