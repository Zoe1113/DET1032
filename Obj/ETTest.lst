 2ADC: 2B5B       	CLR 0x5B
L661:
                  	                  		nb_FourSecTick  = 0;
 2ADD: 2B5C       	CLR 0x5C
L662:
                  	                  		nb_FourSecCycle = 0;
 2ADE: 2B5D       	CLR 0x5D
L663:
                  	                  		nb_FourSecTotal = g_5s_Count / 100;
