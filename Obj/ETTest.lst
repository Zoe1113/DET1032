                  	                  	    //0: input mode, 1: output mode
                  	                  	    P5M = 0x07;			//0b0000 0111
  CA7: 2D07       	MOV A, #07h
  CA8: 2FC5       	B0MOV P5M, A
L130:
                  	                  	    //0: LCD functon pin, 1: IO pin
                  	                  	    P5SEG = 0xFF;		//0b1111 1111
  CA9: 2DFF       	MOV A, #ffh
  CAA: 2FB7       	B0MOV P5SEG, A
L131:
                  	                  	    //0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  	    P5UR = 0xF8;		//0b1111 1000
  CAB: 2DF8       	MOV A, #f8h
  CAC: 2FD7       	B0MOV P5UR, A
L132:
                  	                  	    //0: low level, 1: high level
                  	                  	    P5 = 0xF8;			//0b1111 1000
  CAD: 2FD5       	B0MOV P5, A
L133:
                  	                  	
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P3M = 0x00;			//均为LCD口
  CAE: 3700       	B0MOV 0x87, #00h
  CAF: 2BC3       	CLR 0xC3
L134:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P3SEG = 0x00;		//均为LCD口
  CB0: 2BB3       	CLR 0xB3
L135:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P3UR = 0x00;		//均为LCD口
  CB1: 2BDE       	CLR 0xDE
L136:
                  	                  		//0: low level, 1: high level
                  	                  		P3 = 0x00;			//均为LCD口
  CB2: 2BD3       	CLR 0xD3
L137:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P4M = 0x00;			//均为LCD口
  CB3: 2BC4       	CLR 0xC4
L138:
