                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  		Timer 0 initialize(RTC，需使能外置32768 crystal)
                  	                  	**************************************************************************/
                  	                  	void T0Init( void )
                  	                  	{
                  	                  		FT0EN = 0;
  BB7: 67D8       	B0BCLR 0xD8.7
L35:
                  	                  		T0M = 0x00;
  BB8: 3700       	B0MOV 0x87, #00h
  BB9: 2BD8       	CLR 0xD8
L36:
                  	                  		FT0TB = 1;			//set RTC mode
  BBA: 68D8       	B0BSET 0xD8.0
L37:
                  	                  		FT0IEN = 0;
  BBB: 60C7       	B0BCLR 0xC7.0
L38:
                  	                  		FT0IRQ = 0;			//停止T0计时/中断/中断请求位
  BBC: 60C6       	B0BCLR 0xC6.0
L39:
                  	                  		FT0EN = 1;			//开启0.5s计时
  BBD: 6FD8       	B0BSET 0xD8.7
L40:
                  	                  	}
  BBE: 0E00       	RET
_Function_TC1Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  		TC1 initialize(10ms)
                  	                  		TC1R initial value = 65536 - (TC1 interrupt interval time * TC1 clock rate)
                  	                  		TC1D initial value = TC1R + (PWM high pulse width period / TC1 clock rate)
                  	                  	**************************************************************************/
                  	                  	void TC1Init( void )
                  	                  	{
                  	                  		TC1M = 0x40 ;		//0b01000000，Disable,Fcpu/8
  BBF: 2D40       	MOV A, #40h
  BC0: 2FE9       	B0MOV TC1M, A
L46:
                  	                  		TC1CL = 0x3C ;
  BC1: 2D3C       	MOV A, #3ch
  BC2: 2FEA       	B0MOV TC1CL, A
L47:
                  	                  		TC1RL = 0x3C ;		//10ms（Fcpu = 2M)
  BC3: 2FEB       	B0MOV TC1RL, A
L48:
                  	                  		TC1CH = 0xF6 ;
  BC4: 2DF6       	MOV A, #f6h
  BC5: 2F9D       	B0MOV TC1CH, A
L49:
                  	                  		TC1RH = 0xF6 ;		//10ms（Fcpu = 2M)
  BC6: 2F9E       	B0MOV TC1RH, A
L50:
                  	                  		FTC1IRQ = 0;		//清TC1中断请求位
  BC7: 62C6       	B0BCLR INTRQ1.2
L51:
                  	                  		FTC1IEN = 1;		//enable TC1中断
  BC8: 6AC7       	B0BSET INTEN1.2
L52:
                  	                  		FTC1ENB = 1 ;		//使能TC1定时器
  BC9: 6FE9       	B0BSET TC1M.7
L53:
                  	                  	}
  BCA: 0E00       	RET
_Function_TC2Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  		TC2 initialize(Buzzer 4KHZ，PT11口)
                  	                  		TC2R initial value = 65536 - (TC2 interrupt interval time * TC2 clock rate)
                  	                  		TC2D initial value = TC2R + (PWM high pulse width period / TC2 clock rate)
                  	                  	**************************************************************************/
                  	                  	void TC2Init( void )
                  	                  	{
                  	                  		TC2M = 0x40 ;		//0b01000000，Disable,Fcpu/8
  BCB: 2D40       	MOV A, #40h
  BCC: 2FEC       	B0MOV TC2M, A
L59:
                  	                  		TC2CL = 0xC1 ;
  BCD: 2DC1       	MOV A, #c1h
  BCE: 2FED       	B0MOV TC2CL, A
L60:
                  	                  		TC2RL = 0xC1 ;		//250us
  BCF: 2FEE       	B0MOV TC2RL, A
L61:
                  	                  		TC2CH = 0xFF ;
  BD0: 2DFF       	MOV A, #ffh
  BD1: 2FAC       	B0MOV TC2CH, A
L62:
                  	                  		TC2RH = 0xFF ;		//250us
  BD2: 2FAD       	B0MOV TC2RH, A
L63:
                  	                  		TC2DL6 = 0xE0 ;
  BD3: 2DE0       	MOV A, #e0h
  BD4: 370E       	B0MOV 0x87, #0Eh
  BD5: 1F0A       	MOV 0x0A, A
L64:
                  	                  		TC2DH6 = 0xFF ;		//125us（1/2 duty)
  BD6: 2DFF       	MOV A, #ffh
  BD7: 1F0B       	MOV 0x0B, A
L65:
                  	                  	}
  BD8: 0E00       	RET
_Function_Drv_UartTX_Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_Uart.c
                  	                  	说    明：	串口函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void Drv_UartTX_Init(void)
                  	                  	函数功能：	UART TX初始化
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Drv_UartTX_Init(void)
                  	                  	{
                  	                  		FP14M = 1;			//TX输出
  BD9: 6CC1       	B0BSET 0xC1.4
L35:
                  	                  		URCR1 = B9600 ;
  BDA: 2DE6       	MOV A, #e6h
  BDB: 2F8D       	B0MOV URCR1, A
L36:
                  	                  		URRX1 = 0x04 ;		//Fuart (Fhosc=8Hz)=Fhosc/16，Disable UART RX，Disable UART RX parity bit function.	
  BDC: 2D04       	MOV A, #04h
  BDD: 2F8C       	B0MOV URRX1, A
L37:
                  	                  		URTX1 = 0x84 ;		//Enable UART TX, Disable UART TX parity bit function.
  BDE: 2D84       	MOV A, #84h
  BDF: 2F8B       	B0MOV URTX1, A
L38:
                  	                  	}
  BE0: 0E00       	RET
_Function_Drv_UartRX_Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void Drv_UartRX_Init(void)
                  	                  	函数功能：	UART RX初始化
