  46F: 0C00       	DAA
L610:
                  	                  			 	MOV	_Hex2Bcd,A
  470: 1F5F       	MOV 0x5F, A
L611:
                  	                  				MOV	A,_Hex2Bcd+1
  471: 1E60       	MOV A, 0x60
L612:
