  602: 2D68       	MOV A, #68h
  603: 2F93       	B0MOV ADCM1, A
L40:
                  	                  		ADCM2 = 0x46 ;			//ADC时钟源250khz、4096osr、61hz输出及偏移选择
  604: 2D46       	MOV A, #46h
  605: 2F94       	B0MOV ADCM2, A
L41:
                  	                  		Delay50us( 6 ) ;
  606: 2D06       	MOV A, #06h
  607: 3702       	B0MOV 0x87, #02h
  608: 1FA3       	MOV 0xA3, A
  609: C77E       	CALL 0x077E
L42:
                  	                  	}
  60A: 0E00       	RET
