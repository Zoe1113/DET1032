L599:
                  	                  				MOV	CNameToAsmLabel(loopnum),A
  471: 1FA7       	MOV 0xA7, A
L600:
                  	                  			LOOPHEX:
                  	                  				B0BCLR	FC
  472: 6286       	B0BCLR 0x86.2
L602:
                  	                  	
                  	                  				SelectBank(k0)
                  	                  				RLCM	CNameToAsmLabel(k0)
  473: 0BA5       	RLCM 0xA5
L604:
                  	                  				SelectBank(k1)
                  	                  				RLCM	CNameToAsmLabel(k1)
  474: 0BA6       	RLCM 0xA6
L606:
                  	                  	
