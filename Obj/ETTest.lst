_Function_LowTemp_Compensate_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	App_FTOffset.c
                  	                  	说    明：	额温修正相关函数集合（应用层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.2
                  	                  	芯	  片:	SN8P29XX
                  	                  	适用机型：	ET206、ET306、ET205、ET305、ET3010~12、ET3017~19、ET3021~24
                  	                  	备	  注：
                  	                  	修订记录：
                  	                  	V1.0：宏康芯片人体修正；
                  	                  	V1.1：按照疫情情况将国内外统一为2020519的修正，其他历史记录看excel；
                  	                  	V1.2：根据棒米要求再次抬高低温修正20200815，ly20200815
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	#if Nation == 1
                  	                  	//只在本文件内使用的宏定义
                  	                  	#define Close_Temp  272		//CloseTable表格起始温度常量
                  	                  	/**************************************************************************
                  	                  	//Close Table(27.2-36.9)，低温度在前，高温度在后
                  	                  	**************************************************************************/
                  	                  	uint16 __ROM CloseTable[49] = {	0xC8C8, 0xC8C8, 0xC8C8, 0xC8C8, 0xC8C8, 0xC8C8, 0xC8C8, 0xC8C8, 0xC8C8, 0xC8C8,
