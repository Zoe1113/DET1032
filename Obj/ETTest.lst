_Function_LVD_Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LVD.c
                  	                  	说    明：	低电压处理函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Init(void)
                  	                  	函数功能：	low voltage初始化设置
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LVD_Init(void)
                  	                  	{
                  	                  		//internal lvd
                  	                  		LBTM = 0x10 ;		//低电压<2.6V，内部电压检测
  BD2: 2D10       	MOV A, #10h
  BD3: 2F95       	B0MOV LBTM, A
L35:
                  	                  		Delay50us(1) ;
  BD4: 2D01       	MOV A, #01h
  BD5: 3702       	B0MOV 0x87, #02h
  BD6: 1FA4       	MOV 0xA4, A
  BD7: C77E       	CALL 0x077E
L36:
                  	                  		FLBTEN = 1 ;		//enable low-voltage detect
  BD8: 6895       	B0BSET 0x95.0
L37:
                  	                  	}
  BD9: 0E00       	RET
_Function_LVD_Chk_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Chk(void)
                  	                  	函数功能：	low voltage检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	100ms（Fcup=2M）
                  	                  	**************************************************************************/
                  	                  	void LVD_Chk(void)
                  	                  	{
                  	                  		uint8 i ;		//count with low-voltage
                  	                  	
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  BDA: 3702       	B0MOV 0x87, #02h
  BDB: 2BA8       	CLR 0xA8
  BDC: 8BEB       	JMP 0x0BEB
L40:
                  	                  		{
                  	                  			Delay10ms(1) ;		//延迟10ms稳定
  BDD: 2D01       	MOV A, #01h
  BDE: 1FA4       	MOV 0xA4, A
  BDF: C7A3       	CALL 0x07A3
L57:
                  	                  			if( FLBTO )			//FLBTO 1:低电压 0：正常电压
  BE0: 7995       	B0BTS1 0x95.1
  BE1: 8BE5       	JMP 0x0BE5
L58:
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 1 ;
  BE2: 3700       	B0MOV 0x87, #00h
  BE3: 4932       	BSET 0x32.1
L61:
                  	                  			}
  BE4: 8BE8       	JMP 0x0BE8
L44:
                  	                  			else
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 0 ;
  BE5: 3700       	B0MOV 0x87, #00h
  BE6: 4132       	BCLR 0x32.1
L66:
                  	                  				break;
  BE7: 8BEF       	JMP 0x0BEF
L67:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  BE8: 3702       	B0MOV 0x87, #02h
  BE9: 16A8       	INCMS 0xA8
  BEA: 0000       	NOP
L43:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  BEB: 1EA8       	MOV A, 0xA8
  BEC: 240A       	SUB A, #0ah
  BED: 7A86       	B0BTS1 0x86.2
  BEE: 8BDD       	JMP 0x0BDD
L42:
                  	                  			}
                  	                  		}
                  	                  	}
  BEF: 0E00       	RET
_Function_LBT_Chk_code:
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LBT_Chk(void)
                  	                  	函数功能：	二级电压检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat,uStaFlag.bits.MidBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LBT_Chk(void)
                  	                  	{
                  	                  		uint8 i=0 ;				
  BF0: 3702       	B0MOV 0x87, #02h
  BF1: 2BA8       	CLR 0xA8
L109:
                  	                  	
                  	                  		/*先用2.7V的比较电压检测*/
                  	                  		LBTM = 0x14 ;		
  BF2: 2D14       	MOV A, #14h
  BF3: 2F95       	B0MOV LBTM, A
L110:
                  	                  		Delay50us(1) ;
  BF4: 2D01       	MOV A, #01h
  BF5: 1FA4       	MOV 0xA4, A
  BF6: C77E       	CALL 0x077E
L111:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  BF7: 6895       	B0BSET 0x95.0
L112:
                  	                  	
                  	                  		/*若低电压连续有十次，则置低电压标志为1，清低电压计数*/
                  	                  		for( i=0; i<10; i++ )	
  BF8: 2BA8       	CLR 0xA8
  BF9: 8C09       	JMP 0x0C09
L78:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;		
  BFA: 2D01       	MOV A, #01h
  BFB: 1FA4       	MOV 0xA4, A
  BFC: C7A3       	CALL 0x07A3
L117:
                  	                  			/* FLBTO 1:低电压 0：正常电压 */
                  	                  			if( FLBTO )			
  BFD: 7995       	B0BTS1 0x95.1
  BFE: 8C02       	JMP 0x0C02
L118:
                  	                  			{
                  	                  				/*二级电压第一级标志位打开*/
                  	                  				uStaFlag.bits.MidBat = 1;
  BFF: 3700       	B0MOV 0x87, #00h
  C00: 4D32       	BSET 0x32.5
L121:
                  	                  			}
  C01: 8C06       	JMP 0x0C06
L82:
                  	                  			/*如果有一次未检测到*/
                  	                  			else
                  	                  			{
                  	                  				/*清除标志位并返回*/
                  	                  				uStaFlag.bits.MidBat = 0;		
  C02: 3700       	B0MOV 0x87, #00h
  C03: 4532       	BCLR 0x32.5
L126:
                  	                  				uStaFlag.bits.LowBat = 0 ;
  C04: 4132       	BCLR 0x32.1
L127:
                  	                  				return;		
  C05: 8C2B       	JMP 0x0C2B
L128:
                  	                  		for( i=0; i<10; i++ )	
  C06: 3702       	B0MOV 0x87, #02h
  C07: 16A8       	INCMS 0xA8
  C08: 0000       	NOP
L81:
                  	                  		for( i=0; i<10; i++ )	
  C09: 1EA8       	MOV A, 0xA8
  C0A: 240A       	SUB A, #0ah
  C0B: 7A86       	B0BTS1 0x86.2
  C0C: 8BFA       	JMP 0x0BFA
L134:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果连续十次小于2.7v，判断有没有低于2.6v*/
                  	                  		/*选择2.6v作为比较电压*/
                  	                  		LBTM = 0x10 ;		
  C0D: 2D10       	MOV A, #10h
  C0E: 2F95       	B0MOV LBTM, A
L137:
                  	                  		Delay50us(1) ;
  C0F: 2D01       	MOV A, #01h
  C10: 1FA4       	MOV 0xA4, A
  C11: C77E       	CALL 0x077E
L138:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  C12: 6895       	B0BSET 0x95.0
L139:
                  	                  	
                  	                  		for( i=0; i<10; i++ )	
  C13: 2BA8       	CLR 0xA8
  C14: 8C23       	JMP 0x0C23
L90:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;	
  C15: 2D01       	MOV A, #01h
  C16: 1FA4       	MOV 0xA4, A
  C17: C7A3       	CALL 0x07A3
L144:
                  	                  			/*FLBTO 1:低电压 0：正常电压*/
                  	                  			if( FLBTO )			
  C18: 7995       	B0BTS1 0x95.1
  C19: 8C1D       	JMP 0x0C1D
L145:
                  	                  			{
                  	                  				/*二级电压第二级标志位打开*/
                  	                  				uStaFlag.bits.LowBat = 1 ;	
  C1A: 3700       	B0MOV 0x87, #00h
  C1B: 4932       	BSET 0x32.1
L148:
                  	                  			}
  C1C: 8C20       	JMP 0x0C20
L94:
                  	                  			else
                  	                  			{
                  	                  				/*如果有一次大于2.6V*/
                  	                  				uStaFlag.bits.LowBat = 0 ;
  C1D: 3700       	B0MOV 0x87, #00h
  C1E: 4132       	BCLR 0x32.1
L153:
                  	                  				return;		
  C1F: 8C2B       	JMP 0x0C2B
L154:
                  	                  		for( i=0; i<10; i++ )	
  C20: 3702       	B0MOV 0x87, #02h
  C21: 16A8       	INCMS 0xA8
  C22: 0000       	NOP
L93:
                  	                  		for( i=0; i<10; i++ )	
  C23: 1EA8       	MOV A, 0xA8
  C24: 240A       	SUB A, #0ah
  C25: 7A86       	B0BTS1 0x86.2
  C26: 8C15       	JMP 0x0C15
L160:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果二级电压第二级标志位打开*/
                  	                  		if(uStaFlag.bits.LowBat == 1)
  C27: 3700       	B0MOV 0x87, #00h
  C28: 5932       	BTS1 0x32.1
  C29: 8C2B       	JMP 0x0C2B
L163:
                  	                  		{
                  	                  			/*二级电压第一级标志位关闭*/
                  	                  			uStaFlag.bits.MidBat = 0;
  C2A: 4532       	BCLR 0x32.5
L166:
                  	                  		}
                  	                  		return;
                  	                  	}
  C2B: 0E00       	RET
_Function_Drv_Led_Set_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LED.c
                  	                  	说    明：	LED驱动函数集合（中间层）
                  	                  	作    者:	Liaoy
