  605: 2F94       	B0MOV ADCM2, A
L41:
                  	                  		Delay50us( 6 ) ;
  606: 2D06       	MOV A, #06h
  607: 3702       	B0MOV 0x87, #02h
  608: 1FA3       	MOV 0xA3, A
  609: C77E       	CALL 0x077E
L42:
                  	                  	}
  60A: 0E00       	RET
