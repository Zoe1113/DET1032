_Function_App_BleMode_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	App_Ble.c
                  	                  	说    明：	蓝牙相关函数集合（应用层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	备    注：	适用公司的ET蓝牙
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/*****************************
                  	                  	1、北大蓝牙模块初始化时间为200ms，需等待；
                  	                  	2、转发型指令由App应答，特殊型指令由BLE应答，具体详见模块要求和协议；
                  	                  	3、如果连接成功后断线，不报错，蓝牙标志由静止显示变为闪烁；
                  	                  	4、如果busy30s未空闲则报错，但依然可以重新连接蓝牙；
                  	                  	5、第3条和第4条均要复位蓝牙让其重启一次；
                  	                  	****************************/
                  	                  	eBleModeTask eBle_Sta;
                  	                  	
                  	                  	#if Func_Ble
                  	                  	
                  	                  	
                  	                  	
