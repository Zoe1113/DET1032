L53:
                  	                  		URTX1 = 0x00 ;		//关闭GPIO作为TX功能
  BE9: 3700       	B0MOV 0x87, #00h
  BEA: 2B8B       	CLR 0x8B
L54:
                  	                  		FP14M = 0;			//TX输入
  BEB: 64C1       	B0BCLR 0xC1.4
L55:
                  	                  	}
  BEC: 0E00       	RET
_Function_Drv_UartRX_Disable_code:
                  	                  	
