 30A6: 1E0A       	MOV A, 0x0A
 30A7: 2207       	SUB A, 0x07
 30A8: 1F4D       	MOV 0x4D, A
 30A9: 1E0B       	MOV A, 0x0B
 30AA: 2008       	SBC A, 0x08
 30AB: 1F4E       	MOV 0x4E, A
