                  	                  	函数功能：	二级电压检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat,uStaFlag.bits.MidBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LBT_Chk(void)
                  	                  	{
                  	                  		uint8 i=0 ;				
  BC4: 3702       	B0MOV 0x87, #02h
  BC5: 2BA7       	CLR 0xA7
L113:
                  	                  	
                  	                  		/*先用2.7V的比较电压检测*/
                  	                  		LBTM = 0x14 ;		
  BC6: 2D14       	MOV A, #14h
  BC7: 2F95       	B0MOV LBTM, A
L114:
                  	                  		Delay50us(1) ;
  BC8: 2D01       	MOV A, #01h
  BC9: 1FA3       	MOV 0xA3, A
  BCA: C77E       	CALL 0x077E
L115:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  BCB: 6895       	B0BSET 0x95.0
L116:
                  	                  	
                  	                  		/*若低电压连续有十次，则置低电压标志为1，清低电压计数*/
                  	                  		for( i=0; i<10; i++ )	
  BCC: 2BA7       	CLR 0xA7
  BCD: 8BDD       	JMP 0x0BDD
L78:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;		
  BCE: 2D01       	MOV A, #01h
  BCF: 1FA3       	MOV 0xA3, A
  BD0: C7A3       	CALL 0x07A3
L121:
                  	                  			/* FLBTO 1:低电压 0：正常电压 */
                  	                  			if( FLBTO )			
  BD1: 7995       	B0BTS1 0x95.1
  BD2: 8BD6       	JMP 0x0BD6
L122:
                  	                  			{
                  	                  				/*二级电压第一级标志位打开*/
                  	                  				uStaFlag.bits.MidBat = 1;
  BD3: 3700       	B0MOV 0x87, #00h
  BD4: 4D35       	BSET 0x35.5
L125:
                  	                  			}
  BD5: 8BDA       	JMP 0x0BDA
L82:
                  	                  			/*如果有一次未检测到*/
                  	                  			else
                  	                  			{
                  	                  				/*清除标志位并返回*/
                  	                  				uStaFlag.bits.MidBat = 0;		
  BD6: 3700       	B0MOV 0x87, #00h
  BD7: 4535       	BCLR 0x35.5
L130:
                  	                  				uStaFlag.bits.LowBat = 0 ;
  BD8: 4135       	BCLR 0x35.1
L131:
                  	                  				return;		
  BD9: 8C01       	JMP 0x0C01
L132:
                  	                  		for( i=0; i<10; i++ )	
  BDA: 3702       	B0MOV 0x87, #02h
  BDB: 16A7       	INCMS 0xA7
  BDC: 0000       	NOP
L81:
                  	                  		for( i=0; i<10; i++ )	
  BDD: 1EA7       	MOV A, 0xA7
  BDE: 240A       	SUB A, #0ah
  BDF: 7A86       	B0BTS1 0x86.2
  BE0: 8BCE       	JMP 0x0BCE
L138:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果连续十次小于2.7v，判断有没有低于2.6v*/
                  	                  		/*选择2.6v作为比较电压*/
                  	                  		LBTM = 0x10 ;		
  BE1: 2D10       	MOV A, #10h
  BE2: 2F95       	B0MOV LBTM, A
L141:
                  	                  		Delay50us(1) ;
  BE3: 2D01       	MOV A, #01h
  BE4: 1FA3       	MOV 0xA3, A
  BE5: C77E       	CALL 0x077E
L142:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  BE6: 6895       	B0BSET 0x95.0
L143:
                  	                  	
                  	                  		for( i=0; i<10; i++ )	
  BE7: 2BA7       	CLR 0xA7
  BE8: 8BF7       	JMP 0x0BF7
L90:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;	
  BE9: 2D01       	MOV A, #01h
  BEA: 1FA3       	MOV 0xA3, A
  BEB: C7A3       	CALL 0x07A3
L148:
                  	                  			/*FLBTO 1:低电压 0：正常电压*/
                  	                  			if( FLBTO )			
  BEC: 7995       	B0BTS1 0x95.1
  BED: 8BF1       	JMP 0x0BF1
L149:
                  	                  			{
                  	                  				/*二级电压第二级标志位打开*/
                  	                  				uStaFlag.bits.LowBat = 1 ;	
  BEE: 3700       	B0MOV 0x87, #00h
  BEF: 4935       	BSET 0x35.1
L152:
                  	                  			}
  BF0: 8BF4       	JMP 0x0BF4
L94:
                  	                  			else
                  	                  			{
                  	                  				/*如果有一次大于2.6V*/
                  	                  				uStaFlag.bits.LowBat = 0 ;
  BF1: 3700       	B0MOV 0x87, #00h
  BF2: 4135       	BCLR 0x35.1
L157:
                  	                  				return;		
  BF3: 8C01       	JMP 0x0C01
L158:
                  	                  		for( i=0; i<10; i++ )	
  BF4: 3702       	B0MOV 0x87, #02h
  BF5: 16A7       	INCMS 0xA7
  BF6: 0000       	NOP
L93:
                  	                  		for( i=0; i<10; i++ )	
  BF7: 1EA7       	MOV A, 0xA7
  BF8: 240A       	SUB A, #0ah
  BF9: 7A86       	B0BTS1 0x86.2
  BFA: 8BE9       	JMP 0x0BE9
L164:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果二级电压第二级标志位打开*/
                  	                  		if(uStaFlag.bits.LowBat == 1)
  BFB: 3700       	B0MOV 0x87, #00h
  BFC: 5935       	BTS1 0x35.1
  BFD: 8BFF       	JMP 0x0BFF
L167:
                  	                  		{
                  	                  			/*二级电压第一级标志位关闭*/
                  	                  			uStaFlag.bits.MidBat = 0;
  BFE: 4535       	BCLR 0x35.5
L170:
                  	                  		}
                  	                  		uStaFlag.bits.LowBat=1;
  BFF: 4935       	BSET 0x35.1
L173:
                  	                  		uStaFlag.bits.MidBat = 0;
  C00: 4535       	BCLR 0x35.5
L174:
                  	                  		return;
                  	                  	}
  C01: 0E00       	RET
_Function_Drv_Led_Set_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LED.c
                  	                  	说    明：	LED驱动函数集合（中间层）
                  	                  	作    者:	Liaoy
