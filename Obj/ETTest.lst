                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	//只在本文件内使用的宏定义
                  	                  	#define FilterNum 0x04		//ADC滤波个数
                  	                  	
                  	                  	//变量定义
                  	                  	int16 g_AdcData;		//ADC输出缓冲区高字节
                  	                  	uint8 g_AdcCount;		//ADC计数单元
                  	                  	int32 g_AdcSum;			//ADC COUNT之和的高字节
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	Drv_Adc_Init()
                  	                  	函数功能：	ADC初始化设置(只设置，不使能)
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Drv_Adc_Init( void )
                  	                  	{
                  	                  		FADC1EN = 0 ;			//关闭AD
  5FA: 6093       	B0BCLR 0x93.0
L35:
                  	                  		VREG = 0xED ;			//使能稳压器，使能AVDDR=2.4V,使能ACM=1.0V,AVE=1.5V
  5FB: 2DED       	MOV A, #edh
  5FC: 2F90       	B0MOV VREG, A
L36:
                  	                  		VREG2 = 0x03 ;
  5FD: 2D03       	MOV A, #03h
  5FE: 2F85       	B0MOV VREG2, A
L37:
