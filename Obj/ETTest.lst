_Function_LVD_Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LVD.c
                  	                  	说    明：	低电压处理函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Init(void)
                  	                  	函数功能：	low voltage初始化设置
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LVD_Init(void)
                  	                  	{
                  	                  		//internal lvd
                  	                  		LBTM = 0x10 ;		//低电压<2.6V，内部电压检测
  B55: 2D10       	MOV A, #10h
  B56: 2F95       	B0MOV LBTM, A
L35:
                  	                  		Delay50us(1) ;
  B57: 2D01       	MOV A, #01h
  B58: 3702       	B0MOV 0x87, #02h
  B59: 1FA3       	MOV 0xA3, A
  B5A: C77E       	CALL 0x077E
L36:
                  	                  		FLBTEN = 1 ;		//enable low-voltage detect
  B5B: 6895       	B0BSET 0x95.0
L37:
                  	                  	}
  B5C: 0E00       	RET
_Function_LVD_Chk_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Chk(void)
                  	                  	函数功能：	low voltage检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	100ms（Fcup=2M）
                  	                  	**************************************************************************/
                  	                  	void LVD_Chk(void)
                  	                  	{
                  	                  		uint8 i ;		//count with low-voltage
                  	                  	
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B5D: 3702       	B0MOV 0x87, #02h
  B5E: 2BA7       	CLR 0xA7
  B5F: 8B6E       	JMP 0x0B6E
L40:
                  	                  		{
                  	                  			Delay10ms(1) ;		//延迟10ms稳定
  B60: 2D01       	MOV A, #01h
  B61: 1FA3       	MOV 0xA3, A
  B62: C7A3       	CALL 0x07A3
L57:
                  	                  			if( FLBTO )			//FLBTO 1:低电压 0：正常电压
  B63: 7995       	B0BTS1 0x95.1
  B64: 8B68       	JMP 0x0B68
L58:
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 1 ;
  B65: 3700       	B0MOV 0x87, #00h
  B66: 4935       	BSET 0x35.1
L61:
                  	                  			}
  B67: 8B6B       	JMP 0x0B6B
L44:
                  	                  			else
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 0 ;
  B68: 3700       	B0MOV 0x87, #00h
  B69: 4135       	BCLR 0x35.1
L66:
                  	                  				break;
  B6A: 8B72       	JMP 0x0B72
L67:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B6B: 3702       	B0MOV 0x87, #02h
  B6C: 16A7       	INCMS 0xA7
  B6D: 0000       	NOP
L43:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B6E: 1EA7       	MOV A, 0xA7
  B6F: 240A       	SUB A, #0ah
  B70: 7A86       	B0BTS1 0x86.2
  B71: 8B60       	JMP 0x0B60
L42:
                  	                  			}
                  	                  		}
                  	                  	}
  B72: 0E00       	RET
_Function_LBT_Chk_code:
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LBT_Chk(void)
                  	                  	函数功能：	二级电压检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat,uStaFlag.bits.MidBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LBT_Chk(void)
                  	                  	{
                  	                  		uint8 i=0 ;				
  B73: 3702       	B0MOV 0x87, #02h
  B74: 2BA7       	CLR 0xA7
L109:
                  	                  	
                  	                  		/*先用2.7V的比较电压检测*/
                  	                  		LBTM = 0x14 ;		
  B75: 2D14       	MOV A, #14h
  B76: 2F95       	B0MOV LBTM, A
L110:
                  	                  		Delay50us(1) ;
  B77: 2D01       	MOV A, #01h
  B78: 1FA3       	MOV 0xA3, A
  B79: C77E       	CALL 0x077E
L111:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  B7A: 6895       	B0BSET 0x95.0
L112:
                  	                  	
                  	                  		/*若低电压连续有十次，则置低电压标志为1，清低电压计数*/
                  	                  		for( i=0; i<10; i++ )	
  B7B: 2BA7       	CLR 0xA7
  B7C: 8B8C       	JMP 0x0B8C
L78:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;		
  B7D: 2D01       	MOV A, #01h
  B7E: 1FA3       	MOV 0xA3, A
  B7F: C7A3       	CALL 0x07A3
L117:
                  	                  			/* FLBTO 1:低电压 0：正常电压 */
                  	                  			if( FLBTO )			
  B80: 7995       	B0BTS1 0x95.1
  B81: 8B85       	JMP 0x0B85
L118:
                  	                  			{
                  	                  				/*二级电压第一级标志位打开*/
                  	                  				uStaFlag.bits.MidBat = 1;
  B82: 3700       	B0MOV 0x87, #00h
  B83: 4D35       	BSET 0x35.5
L121:
                  	                  			}
  B84: 8B89       	JMP 0x0B89
L82:
                  	                  			/*如果有一次未检测到*/
                  	                  			else
                  	                  			{
                  	                  				/*清除标志位并返回*/
                  	                  				uStaFlag.bits.MidBat = 0;		
  B85: 3700       	B0MOV 0x87, #00h
  B86: 4535       	BCLR 0x35.5
L126:
                  	                  				uStaFlag.bits.LowBat = 0 ;
  B87: 4135       	BCLR 0x35.1
L127:
                  	                  				return;		
  B88: 8BAE       	JMP 0x0BAE
L128:
                  	                  		for( i=0; i<10; i++ )	
  B89: 3702       	B0MOV 0x87, #02h
  B8A: 16A7       	INCMS 0xA7
  B8B: 0000       	NOP
L81:
                  	                  		for( i=0; i<10; i++ )	
  B8C: 1EA7       	MOV A, 0xA7
  B8D: 240A       	SUB A, #0ah
  B8E: 7A86       	B0BTS1 0x86.2
  B8F: 8B7D       	JMP 0x0B7D
L134:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果连续十次小于2.7v，判断有没有低于2.6v*/
                  	                  		/*选择2.6v作为比较电压*/
                  	                  		LBTM = 0x10 ;		
  B90: 2D10       	MOV A, #10h
  B91: 2F95       	B0MOV LBTM, A
L137:
                  	                  		Delay50us(1) ;
  B92: 2D01       	MOV A, #01h
  B93: 1FA3       	MOV 0xA3, A
  B94: C77E       	CALL 0x077E
L138:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  B95: 6895       	B0BSET 0x95.0
L139:
                  	                  	
                  	                  		for( i=0; i<10; i++ )	
  B96: 2BA7       	CLR 0xA7
  B97: 8BA6       	JMP 0x0BA6
L90:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;	
  B98: 2D01       	MOV A, #01h
  B99: 1FA3       	MOV 0xA3, A
  B9A: C7A3       	CALL 0x07A3
L144:
                  	                  			/*FLBTO 1:低电压 0：正常电压*/
                  	                  			if( FLBTO )			
  B9B: 7995       	B0BTS1 0x95.1
  B9C: 8BA0       	JMP 0x0BA0
L145:
                  	                  			{
                  	                  				/*二级电压第二级标志位打开*/
                  	                  				uStaFlag.bits.LowBat = 1 ;	
  B9D: 3700       	B0MOV 0x87, #00h
  B9E: 4935       	BSET 0x35.1
L148:
                  	                  			}
  B9F: 8BA3       	JMP 0x0BA3
L94:
                  	                  			else
                  	                  			{
                  	                  				/*如果有一次大于2.6V*/
                  	                  				uStaFlag.bits.LowBat = 0 ;
  BA0: 3700       	B0MOV 0x87, #00h
  BA1: 4135       	BCLR 0x35.1
L153:
                  	                  				return;		
  BA2: 8BAE       	JMP 0x0BAE
L154:
                  	                  		for( i=0; i<10; i++ )	
  BA3: 3702       	B0MOV 0x87, #02h
  BA4: 16A7       	INCMS 0xA7
  BA5: 0000       	NOP
L93:
                  	                  		for( i=0; i<10; i++ )	
  BA6: 1EA7       	MOV A, 0xA7
  BA7: 240A       	SUB A, #0ah
  BA8: 7A86       	B0BTS1 0x86.2
  BA9: 8B98       	JMP 0x0B98
L160:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果二级电压第二级标志位打开*/
                  	                  		if(uStaFlag.bits.LowBat == 1)
  BAA: 3700       	B0MOV 0x87, #00h
  BAB: 5935       	BTS1 0x35.1
  BAC: 8BAE       	JMP 0x0BAE
L163:
                  	                  		{
                  	                  			/*二级电压第一级标志位关闭*/
                  	                  			uStaFlag.bits.MidBat = 0;
  BAD: 4535       	BCLR 0x35.5
L166:
                  	                  		}
                  	                  		return;
                  	                  	}
