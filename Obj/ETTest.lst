                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LBT_Chk(void)
                  	                  	{
                  	                  		uint8 i=0 ;				
  BC3: 3702       	B0MOV 0x87, #02h
  BC4: 2BA6       	CLR 0xA6
L109:
                  	                  	
                  	                  		/*先用2.7V的比较电压检测*/
                  	                  		LBTM = 0x14 ;		
  BC5: 2D14       	MOV A, #14h
  BC6: 2F95       	B0MOV LBTM, A
L110:
                  	                  		Delay50us(1) ;
  BC7: 2D01       	MOV A, #01h
  BC8: 1FA2       	MOV 0xA2, A
  BC9: C775       	CALL 0x0775
L111:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  BCA: 6895       	B0BSET 0x95.0
L112:
                  	                  	
                  	                  		/*若低电压连续有十次，则置低电压标志为1，清低电压计数*/
                  	                  		for( i=0; i<10; i++ )	
  BCB: 2BA6       	CLR 0xA6
  BCC: 8BDC       	JMP 0x0BDC
L78:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;		
  BCD: 2D01       	MOV A, #01h
  BCE: 1FA2       	MOV 0xA2, A
  BCF: C79A       	CALL 0x079A
L117:
                  	                  			/* FLBTO 1:低电压 0：正常电压 */
                  	                  			if( FLBTO )			
  BD0: 7995       	B0BTS1 0x95.1
  BD1: 8BD5       	JMP 0x0BD5
L118:
                  	                  			{
                  	                  				/*二级电压第一级标志位打开*/
                  	                  				uStaFlag.bits.MidBat = 1;
  BD2: 3700       	B0MOV 0x87, #00h
  BD3: 4D32       	BSET 0x32.5
L121:
                  	                  			}
  BD4: 8BD9       	JMP 0x0BD9
L82:
                  	                  			/*如果有一次未检测到*/
                  	                  			else
                  	                  			{
                  	                  				/*清除标志位并返回*/
                  	                  				uStaFlag.bits.MidBat = 0;		
  BD5: 3700       	B0MOV 0x87, #00h
  BD6: 4532       	BCLR 0x32.5
L126:
                  	                  				uStaFlag.bits.LowBat = 0 ;
  BD7: 4132       	BCLR 0x32.1
L127:
                  	                  				return;		
  BD8: 8BFE       	JMP 0x0BFE
L128:
                  	                  		for( i=0; i<10; i++ )	
  BD9: 3702       	B0MOV 0x87, #02h
  BDA: 16A6       	INCMS 0xA6
  BDB: 0000       	NOP
L81:
                  	                  		for( i=0; i<10; i++ )	
  BDC: 1EA6       	MOV A, 0xA6
  BDD: 240A       	SUB A, #0ah
  BDE: 7A86       	B0BTS1 0x86.2
  BDF: 8BCD       	JMP 0x0BCD
L134:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果连续十次小于2.7v，判断有没有低于2.6v*/
                  	                  		/*选择2.6v作为比较电压*/
                  	                  		LBTM = 0x10 ;		
  BE0: 2D10       	MOV A, #10h
  BE1: 2F95       	B0MOV LBTM, A
L137:
                  	                  		Delay50us(1) ;
  BE2: 2D01       	MOV A, #01h
  BE3: 1FA2       	MOV 0xA2, A
  BE4: C775       	CALL 0x0775
L138:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  BE5: 6895       	B0BSET 0x95.0
L139:
                  	                  	
                  	                  		for( i=0; i<10; i++ )	
  BE6: 2BA6       	CLR 0xA6
  BE7: 8BF6       	JMP 0x0BF6
L90:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;	
  BE8: 2D01       	MOV A, #01h
  BE9: 1FA2       	MOV 0xA2, A
  BEA: C79A       	CALL 0x079A
L144:
                  	                  			/*FLBTO 1:低电压 0：正常电压*/
                  	                  			if( FLBTO )			
  BEB: 7995       	B0BTS1 0x95.1
  BEC: 8BF0       	JMP 0x0BF0
L145:
                  	                  			{
                  	                  				/*二级电压第二级标志位打开*/
                  	                  				uStaFlag.bits.LowBat = 1 ;	
  BED: 3700       	B0MOV 0x87, #00h
  BEE: 4932       	BSET 0x32.1
L148:
                  	                  			}
  BEF: 8BF3       	JMP 0x0BF3
L94:
                  	                  			else
                  	                  			{
                  	                  				/*如果有一次大于2.6V*/
                  	                  				uStaFlag.bits.LowBat = 0 ;
  BF0: 3700       	B0MOV 0x87, #00h
  BF1: 4132       	BCLR 0x32.1
L153:
                  	                  				return;		
  BF2: 8BFE       	JMP 0x0BFE
L154:
                  	                  		for( i=0; i<10; i++ )	
  BF3: 3702       	B0MOV 0x87, #02h
  BF4: 16A6       	INCMS 0xA6
  BF5: 0000       	NOP
L93:
                  	                  		for( i=0; i<10; i++ )	
  BF6: 1EA6       	MOV A, 0xA6
  BF7: 240A       	SUB A, #0ah
  BF8: 7A86       	B0BTS1 0x86.2
  BF9: 8BE8       	JMP 0x0BE8
L160:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果二级电压第二级标志位打开*/
                  	                  		if(uStaFlag.bits.LowBat == 1)
  BFA: 3700       	B0MOV 0x87, #00h
  BFB: 5932       	BTS1 0x32.1
  BFC: 8BFE       	JMP 0x0BFE
L163:
                  	                  		{
                  	                  			/*二级电压第一级标志位关闭*/
                  	                  			uStaFlag.bits.MidBat = 0;
  BFD: 4532       	BCLR 0x32.5
L166:
                  	                  		}
                  	                  		return;
                  	                  	}
  BFE: 0E00       	RET
_Function_Drv_Led_Set_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LED.c
                  	                  	说    明：	LED驱动函数集合（中间层）
                  	                  	作    者:	Liaoy
