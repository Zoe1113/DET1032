                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果二级电压第二级标志位打开*/
                  	                  		if(uStaFlag.bits.LowBat == 1)
  BB3: 3700       	B0MOV 0x87, #00h
  BB4: 5932       	BTS1 0x32.1
  BB5: 8BB7       	JMP 0x0BB7
L163:
                  	                  		{
                  	                  			/*二级电压第一级标志位关闭*/
                  	                  			uStaFlag.bits.MidBat = 0;
  BB6: 4532       	BCLR 0x32.5
L166:
                  	                  		}
                  	                  		return;
                  	                  	}
  BB7: 0E00       	RET
_Function_Drv_Led_Set_code:
                  	                  	/**************************************************************************
