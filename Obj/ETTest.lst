  C39: 248A       	SUB A, #8ah
  C3A: 7A86       	B0BTS1 0x86.2
  C3B: 8C2A       	JMP 0x0C2A
L151:
                  	                  		}
                  	                  	}
  C3C: 0E00       	RET
_Function_Cal_Inspect_Detect_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_GPIO.c
                  	                  	说    明：	GPIO初始化函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	Cal_Inspect_Detect()
                  	                  	函数功能：	校准模式、绑定模式入口检测
                  	                  	输入参数：	Port_Debug、Port_Cal
                  	                  	输出参数：	uSetFlag
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Cal_Inspect_Detect(void)
                  	                  	{
                  	                  		//绑定检测模式、校温检测模式、系数调整模式判断
                  	                  		if( !Port_Debug && Port_Cal )
  C3D: 74D5       	B0BTS0 0xD5.4
  C3E: 8C51       	JMP 0x0C51
  C3F: 7BD5       	B0BTS1 0xD5.3
  C40: 8C51       	JMP 0x0C51
L41:
                  	                  		{
                  	                  			if ( eTestmode_num == Insptectmode )
  C41: 3701       	B0MOV 0x87, #01h
  C42: 1E58       	MOV A, 0x58
  C43: 0604       	CMPRS A, #04h
  C44: 8C4A       	JMP 0x0C4A
L44:
                  	                  			{
                  	                  				 #if ParamModif
                  	                  				LED_CloseAll();
  C45: CBB2       	CALL 0x0BB2
L47:
                  	                  				eMain_Task = Task_ParamModifymode;	//生产模式短路debug口则进入系数调整模式
  C46: 2D07       	MOV A, #07h
  C47: 3700       	B0MOV 0x87, #00h
  C48: 1F33       	MOV 0x33, A
L48:
                  	                  	            #endif
                  	                  	        }
  C49: 8C51       	JMP 0x0C51
L34:
                  	                  			else
                  	                  			{
                  	                  				eSetTask = Set_Unit;		//设置态恢复状态
  C4A: 2B5C       	CLR 0x5C
L53:
                  	                  				F_FirstEnter_SetMode = 0;
  C4B: 3700       	B0MOV 0x87, #00h
  C4C: 4217       	BCLR 0x17.2
L54:
                  	                  				#if Func_Ble
                  	                  					F_Ble_En = Disable;
  C4D: 4448       	BCLR 0x48.4
L55:
                  	                  					Port_Ble_En = 0;
  C4E: 63D2       	B0BCLR 0xD2.3
L56:
                  	                  				#endif
                  	                  				eMain_Task = Task_BondTestmode;	//用户模式下短路debug进入绑定检测模式
  C4F: 2D06       	MOV A, #06h
  C50: 1F33       	MOV 0x33, A
L57:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		//设置态决不允许进入校温，汇编和C的程序结构不一样，未初始化adc
                  	                  		if( !Port_Cal && !Port_Debug && eMain_Task == Task_ReadyMode )
  C51: 73D5       	B0BTS0 0xD5.3
  C52: 8C5C       	JMP 0x0C5C
  C53: 74D5       	B0BTS0 0xD5.4
  C54: 8C5C       	JMP 0x0C5C
  C55: 3700       	B0MOV 0x87, #00h
  C56: 2533       	DECS 0x33
  C57: 8C5C       	JMP 0x0C5C
L62:
                  	                  		{
