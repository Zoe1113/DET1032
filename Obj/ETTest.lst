_Function_App_TestingMode_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	App_TestMode.c
                  	                  	说    明：	测量模式（应用层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	备    注:
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	//测量模式状态
                  	                  	enum eTestmode_Status
                  	                  	{
                  	                  	    Test_Init = 0,
                  	                  	    Test_Get_Tp ,
                  	                  	    Test_Get_Ntc ,
                  	                  	    Test_Calculate ,
