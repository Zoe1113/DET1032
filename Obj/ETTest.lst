                  	                  	#include "Include.h"
                  	                  	
                  	                  	//只在本文件内使用的宏定义
                  	                  	//温度分段阈值
                  	                  	#define SlightTempC	0x0E92		//37.3
                  	                  	#define FeverTempC	0x0EC4		//37.8
                  	                  	#define SlightTempF	0x26B6		//99.1
                  	                  	#define FeverTempF	0x2710		//100.0
                  	                  	
                  	                  	//0-3月年龄分段的发烧报警范围
                  	                  	#define SlightTempC0	0x0E9C		//37.4
                  	                  	#define FeverTempC0	    0x0E9C		//37.4
                  	                  	#define SlightTempF0	0x26CA		//99.3
                  	                  	#define FeverTempF0 	0x26CA		//99.3
                  	                  	
                  	                  	//3-36月年龄分段的发烧报警范围
                  	                  	#define SlightTempC3	0x0EB0		//37.6
                  	                  	#define FeverTempC3	    0x0F0A		//38.5
