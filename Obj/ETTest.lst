 2AE0: 3018       	B0MOV 0x80, #18h
 2AE1: 3402       	B0MOV 0x84, #02h
 2AE2: 3351       	B0MOV 0x83, #51h
 2AE3: 3200       	B0MOV 0x82, #00h
 2AE4: 2D64       	MOV A, #64h
 2AE5: FBD5       	CALL 0x3BD5
 2AE6: F979       	CALL 0x3979
 2AE7: 2E18       	B0MOV A, 0x18
 2AE8: 3702       	B0MOV 0x87, #02h
 2AE9: 1F5E       	MOV 0x5E, A
L664:
                  	                  		if(nb_FourSecTotal == 0) nb_FourSecTotal = 1;
