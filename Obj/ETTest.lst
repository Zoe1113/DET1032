  C96: 2D23       	MOV A, #23h
  C97: 2FE0       	B0MOV P0UR, A
L120:
                  	                  		//0: low level, 1: high level
                  	                  		P0 = 0x2F;			//0b0010 1111
  C98: 2D2F       	MOV A, #2fh
  C99: 2FD0       	B0MOV P0, A
L121:
                  	                  	
                  	                  	#if !Func_Ble
