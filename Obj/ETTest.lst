  C58: 0000       	NOP
  C59: 0000       	NOP
  C5A: 0000       	NOP
L102:
                  	                  		while(FUTX1BZ);
  C5B: 728B       	B0BTS0 URTX1.2
  C5C: 8C5B       	JMP 0x0C5B
L105:
                  	                  		if(FUTX1BZ==0)
