_Function_HalKey_KeyClr_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void HalKey_KeyClr(void)
                  	                  	函数功能：	清除所有按键信息（非所有，重点部分）
                  	                  	输入参数：	g_KeyHold_Flag、g_KeyPress_Flag、g_KeyRelease_Flag、g_KeyContinue_Flag、g_Key_Val（键值）、g_Key_Status（按键状态）
                  	                  	输出参数：	g_KeyHold_Flag、g_KeyPress_Flag、g_KeyRelease_Flag、g_KeyContinue_Flag、g_Key_Val（键值）、g_Key_Status（按键状态）
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void HalKey_KeyClr(void)
                  	                  	{
                  	                  	    uKeyHold.g_KeyHold_Flag = 0;
  B42: 3701       	B0MOV 0x87, #01h
  B43: 2B15       	CLR 0x15
L747:
                  	                  	    uKeyPress.g_KeyPress_Flag = 0;
  B44: 2B16       	CLR 0x16
L748:
                  	                  	    uKeyRelease.g_KeyRelease_Flag = 0;
  B45: 2B14       	CLR 0x14
L749:
                  	                  	    uKeyContinue.g_KeyContinue_Flag = 0;
  B46: 3700       	B0MOV 0x87, #00h
  B47: 2B77       	CLR 0x77
L750:
                  	                  	
                  	                  	    sMemKey.g_Key_Val = 0;
  B48: 3701       	B0MOV 0x87, #01h
  B49: 2B10       	CLR 0x10
L751:
                  	                  	    sTestKey.g_Key_Val = 0;
  B4A: 2B0B       	CLR 0x0B
L752:
                  	                  	    sSetKey.g_Key_Val = 0;
  B4B: 2B06       	CLR 0x06
L753:
                  	                  	    sEarcapKey.g_Key_Val = 0;
  B4C: 2B01       	CLR 0x01
L754:
                  	                  	
                  	                  	    sMemKey.g_Key_Status = 0;
  B4D: 2B11       	CLR 0x11
L755:
                  	                  	    sTestKey.g_Key_Status = 0;
  B4E: 2B0C       	CLR 0x0C
L756:
                  	                  	    sSetKey.g_Key_Status = 0;
  B4F: 2B07       	CLR 0x07
L757:
                  	                  	    sEarcapKey.g_Key_Status = 0;
  B50: 2B02       	CLR 0x02
L758:
                  	                  	}
  B51: 0E00       	RET
_Function_LVD_Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LVD.c
                  	                  	说    明：	低电压处理函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Init(void)
                  	                  	函数功能：	low voltage初始化设置
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LVD_Init(void)
                  	                  	{
                  	                  		//internal lvd
                  	                  		LBTM = 0x10 ;		//低电压<2.6V，内部电压检测
  B52: 2D10       	MOV A, #10h
  B53: 2F95       	B0MOV LBTM, A
L35:
                  	                  		Delay50us(1) ;
  B54: 2D01       	MOV A, #01h
  B55: 3702       	B0MOV 0x87, #02h
  B56: 1FA3       	MOV 0xA3, A
  B57: C77E       	CALL 0x077E
L36:
                  	                  		FLBTEN = 1 ;		//enable low-voltage detect
  B58: 6895       	B0BSET 0x95.0
L37:
                  	                  	}
  B59: 0E00       	RET
_Function_LVD_Chk_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Chk(void)
                  	                  	函数功能：	low voltage检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	100ms（Fcup=2M）
                  	                  	**************************************************************************/
                  	                  	void LVD_Chk(void)
                  	                  	{
                  	                  		uint8 i ;		//count with low-voltage
                  	                  	
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B5A: 3702       	B0MOV 0x87, #02h
  B5B: 2BA7       	CLR 0xA7
  B5C: 8B6B       	JMP 0x0B6B
L40:
                  	                  		{
                  	                  			Delay10ms(1) ;		//延迟10ms稳定
  B5D: 2D01       	MOV A, #01h
  B5E: 1FA3       	MOV 0xA3, A
  B5F: C7A3       	CALL 0x07A3
L57:
                  	                  			if( FLBTO )			//FLBTO 1:低电压 0：正常电压
  B60: 7995       	B0BTS1 0x95.1
  B61: 8B65       	JMP 0x0B65
L58:
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 1 ;
  B62: 3700       	B0MOV 0x87, #00h
  B63: 4935       	BSET 0x35.1
L61:
                  	                  			}
  B64: 8B68       	JMP 0x0B68
L44:
                  	                  			else
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 0 ;
  B65: 3700       	B0MOV 0x87, #00h
  B66: 4135       	BCLR 0x35.1
L66:
                  	                  				break;
  B67: 8B6F       	JMP 0x0B6F
L67:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B68: 3702       	B0MOV 0x87, #02h
  B69: 16A7       	INCMS 0xA7
  B6A: 0000       	NOP
L43:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B6B: 1EA7       	MOV A, 0xA7
  B6C: 240A       	SUB A, #0ah
  B6D: 7A86       	B0BTS1 0x86.2
  B6E: 8B5D       	JMP 0x0B5D
L42:
                  	                  			}
                  	                  		}
                  	                  	}
  B6F: 0E00       	RET
_Function_LBT_Chk_code:
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LBT_Chk(void)
                  	                  	函数功能：	二级电压检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat,uStaFlag.bits.MidBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LBT_Chk(void)
                  	                  	{
                  	                  		uint8 i=0 ;				
  B70: 3702       	B0MOV 0x87, #02h
  B71: 2BA7       	CLR 0xA7
L109:
                  	                  	
                  	                  		/*先用2.7V的比较电压检测*/
                  	                  		LBTM = 0x14 ;		
  B72: 2D14       	MOV A, #14h
  B73: 2F95       	B0MOV LBTM, A
L110:
                  	                  		Delay50us(1) ;
  B74: 2D01       	MOV A, #01h
  B75: 1FA3       	MOV 0xA3, A
  B76: C77E       	CALL 0x077E
L111:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  B77: 6895       	B0BSET 0x95.0
L112:
                  	                  	
                  	                  		/*若低电压连续有十次，则置低电压标志为1，清低电压计数*/
                  	                  		for( i=0; i<10; i++ )	
  B78: 2BA7       	CLR 0xA7
  B79: 8B89       	JMP 0x0B89
L78:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;		
  B7A: 2D01       	MOV A, #01h
  B7B: 1FA3       	MOV 0xA3, A
  B7C: C7A3       	CALL 0x07A3
L117:
                  	                  			/* FLBTO 1:低电压 0：正常电压 */
                  	                  			if( FLBTO )			
  B7D: 7995       	B0BTS1 0x95.1
  B7E: 8B82       	JMP 0x0B82
L118:
                  	                  			{
                  	                  				/*二级电压第一级标志位打开*/
                  	                  				uStaFlag.bits.MidBat = 1;
  B7F: 3700       	B0MOV 0x87, #00h
  B80: 4D35       	BSET 0x35.5
L121:
                  	                  			}
  B81: 8B86       	JMP 0x0B86
L82:
                  	                  			/*如果有一次未检测到*/
                  	                  			else
                  	                  			{
                  	                  				/*清除标志位并返回*/
                  	                  				uStaFlag.bits.MidBat = 0;		
  B82: 3700       	B0MOV 0x87, #00h
  B83: 4535       	BCLR 0x35.5
L126:
                  	                  				uStaFlag.bits.LowBat = 0 ;
  B84: 4135       	BCLR 0x35.1
L127:
                  	                  				return;		
  B85: 8BAB       	JMP 0x0BAB
L128:
                  	                  		for( i=0; i<10; i++ )	
  B86: 3702       	B0MOV 0x87, #02h
  B87: 16A7       	INCMS 0xA7
  B88: 0000       	NOP
L81:
                  	                  		for( i=0; i<10; i++ )	
  B89: 1EA7       	MOV A, 0xA7
  B8A: 240A       	SUB A, #0ah
  B8B: 7A86       	B0BTS1 0x86.2
  B8C: 8B7A       	JMP 0x0B7A
L134:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果连续十次小于2.7v，判断有没有低于2.6v*/
                  	                  		/*选择2.6v作为比较电压*/
                  	                  		LBTM = 0x10 ;		
  B8D: 2D10       	MOV A, #10h
  B8E: 2F95       	B0MOV LBTM, A
L137:
                  	                  		Delay50us(1) ;
  B8F: 2D01       	MOV A, #01h
  B90: 1FA3       	MOV 0xA3, A
  B91: C77E       	CALL 0x077E
L138:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  B92: 6895       	B0BSET 0x95.0
L139:
                  	                  	
                  	                  		for( i=0; i<10; i++ )	
  B93: 2BA7       	CLR 0xA7
  B94: 8BA3       	JMP 0x0BA3
L90:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;	
  B95: 2D01       	MOV A, #01h
  B96: 1FA3       	MOV 0xA3, A
  B97: C7A3       	CALL 0x07A3
L144:
                  	                  			/*FLBTO 1:低电压 0：正常电压*/
                  	                  			if( FLBTO )			
  B98: 7995       	B0BTS1 0x95.1
  B99: 8B9D       	JMP 0x0B9D
L145:
                  	                  			{
                  	                  				/*二级电压第二级标志位打开*/
                  	                  				uStaFlag.bits.LowBat = 1 ;	
  B9A: 3700       	B0MOV 0x87, #00h
  B9B: 4935       	BSET 0x35.1
L148:
                  	                  			}
  B9C: 8BA0       	JMP 0x0BA0
L94:
                  	                  			else
                  	                  			{
                  	                  				/*如果有一次大于2.6V*/
                  	                  				uStaFlag.bits.LowBat = 0 ;
  B9D: 3700       	B0MOV 0x87, #00h
  B9E: 4135       	BCLR 0x35.1
L153:
                  	                  				return;		
  B9F: 8BAB       	JMP 0x0BAB
L154:
                  	                  		for( i=0; i<10; i++ )	
  BA0: 3702       	B0MOV 0x87, #02h
  BA1: 16A7       	INCMS 0xA7
  BA2: 0000       	NOP
L93:
                  	                  		for( i=0; i<10; i++ )	
  BA3: 1EA7       	MOV A, 0xA7
  BA4: 240A       	SUB A, #0ah
  BA5: 7A86       	B0BTS1 0x86.2
  BA6: 8B95       	JMP 0x0B95
L160:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果二级电压第二级标志位打开*/
                  	                  		if(uStaFlag.bits.LowBat == 1)
  BA7: 3700       	B0MOV 0x87, #00h
  BA8: 5935       	BTS1 0x35.1
  BA9: 8BAB       	JMP 0x0BAB
L163:
                  	                  		{
                  	                  			/*二级电压第一级标志位关闭*/
                  	                  			uStaFlag.bits.MidBat = 0;
  BAA: 4535       	BCLR 0x35.5
L166:
                  	                  		}
                  	                  		return;
                  	                  	}
  BAB: 0E00       	RET
_Function_Drv_Led_Set_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LED.c
                  	                  	说    明：	LED驱动函数集合（中间层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	
                  	                  	//底层驱动（io is sink mode）
                  	                  	void Drv_Led_Set(void)
                  	                  	{
                  	                  		FP55M = 1;		//输出为0
  BAC: 6DC5       	B0BSET 0xC5.5
L35:
                  	                  		FP56M = 1;		//输出为0
  BAD: 6EC5       	B0BSET 0xC5.6
L36:
                  	                  		FP57M = 1;		//输出为0
  BAE: 6FC5       	B0BSET 0xC5.7
L37:
                  	                  		LED_CloseAll();
  BAF: CBB1       	CALL 0x0BB1
L38:
                  	                  	}
  BB0: 0E00       	RET
_Function_LED_CloseAll_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  		CLose LED
                  	                  	**************************************************************************/
                  	                  	void LED_CloseAll( void )
                  	                  	{
                  	                  		LED_Red_Dis();
  BB1: 6FD5       	B0BSET 0xD5.7
L46:
                  	                  		LED_Yellow_Dis();
  BB2: 6DD5       	B0BSET 0xD5.5
L52:
                  	                  		LED_Green_Dis(); 
  BB3: 6ED5       	B0BSET 0xD5.6
L58:
                  	                  		LED_White_Dis();
  BB4: 68D1       	B0BSET 0xD1.0
L64:
                  	                  	}
  BB5: 0E00       	RET
_Function_T0Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_Timer.c
                  	                  	说    明：	定时器设置（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  		Timer 0 initialize(RTC，需使能外置32768 crystal)
                  	                  	**************************************************************************/
                  	                  	void T0Init( void )
                  	                  	{
                  	                  		FT0EN = 0;
  BB6: 67D8       	B0BCLR 0xD8.7
L35:
                  	                  		T0M = 0x00;
  BB7: 3700       	B0MOV 0x87, #00h
  BB8: 2BD8       	CLR 0xD8
L36:
                  	                  		FT0TB = 1;			//set RTC mode
  BB9: 68D8       	B0BSET 0xD8.0
L37:
                  	                  		FT0IEN = 0;
  BBA: 60C7       	B0BCLR 0xC7.0
L38:
                  	                  		FT0IRQ = 0;			//停止T0计时/中断/中断请求位
  BBB: 60C6       	B0BCLR 0xC6.0
L39:
                  	                  		FT0EN = 1;			//开启0.5s计时
  BBC: 6FD8       	B0BSET 0xD8.7
L40:
                  	                  	}
  BBD: 0E00       	RET
_Function_TC1Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  		TC1 initialize(10ms)
                  	                  		TC1R initial value = 65536 - (TC1 interrupt interval time * TC1 clock rate)
                  	                  		TC1D initial value = TC1R + (PWM high pulse width period / TC1 clock rate)
                  	                  	**************************************************************************/
                  	                  	void TC1Init( void )
                  	                  	{
                  	                  		TC1M = 0x40 ;		//0b01000000，Disable,Fcpu/8
  BBE: 2D40       	MOV A, #40h
  BBF: 2FE9       	B0MOV TC1M, A
L46:
                  	                  		TC1CL = 0x3C ;
  BC0: 2D3C       	MOV A, #3ch
  BC1: 2FEA       	B0MOV TC1CL, A
L47:
                  	                  		TC1RL = 0x3C ;		//10ms（Fcpu = 2M)
  BC2: 2FEB       	B0MOV TC1RL, A
L48:
                  	                  		TC1CH = 0xF6 ;
  BC3: 2DF6       	MOV A, #f6h
  BC4: 2F9D       	B0MOV TC1CH, A
L49:
                  	                  		TC1RH = 0xF6 ;		//10ms（Fcpu = 2M)
  BC5: 2F9E       	B0MOV TC1RH, A
L50:
                  	                  		FTC1IRQ = 0;		//清TC1中断请求位
  BC6: 62C6       	B0BCLR INTRQ1.2
L51:
                  	                  		FTC1IEN = 1;		//enable TC1中断
  BC7: 6AC7       	B0BSET INTEN1.2
L52:
                  	                  		FTC1ENB = 1 ;		//使能TC1定时器
  BC8: 6FE9       	B0BSET TC1M.7
L53:
                  	                  	}
  BC9: 0E00       	RET
_Function_TC2Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  		TC2 initialize(Buzzer 4KHZ，PT11口)
                  	                  		TC2R initial value = 65536 - (TC2 interrupt interval time * TC2 clock rate)
                  	                  		TC2D initial value = TC2R + (PWM high pulse width period / TC2 clock rate)
                  	                  	**************************************************************************/
                  	                  	void TC2Init( void )
                  	                  	{
                  	                  		TC2M = 0x40 ;		//0b01000000，Disable,Fcpu/8
  BCA: 2D40       	MOV A, #40h
  BCB: 2FEC       	B0MOV TC2M, A
L59:
                  	                  		TC2CL = 0xC1 ;
  BCC: 2DC1       	MOV A, #c1h
  BCD: 2FED       	B0MOV TC2CL, A
L60:
                  	                  		TC2RL = 0xC1 ;		//250us
  BCE: 2FEE       	B0MOV TC2RL, A
L61:
                  	                  		TC2CH = 0xFF ;
  BCF: 2DFF       	MOV A, #ffh
  BD0: 2FAC       	B0MOV TC2CH, A
L62:
                  	                  		TC2RH = 0xFF ;		//250us
  BD1: 2FAD       	B0MOV TC2RH, A
L63:
                  	                  		TC2DL6 = 0xE0 ;
  BD2: 2DE0       	MOV A, #e0h
  BD3: 370E       	B0MOV 0x87, #0Eh
  BD4: 1F0A       	MOV 0x0A, A
L64:
                  	                  		TC2DH6 = 0xFF ;		//125us（1/2 duty)
  BD5: 2DFF       	MOV A, #ffh
  BD6: 1F0B       	MOV 0x0B, A
L65:
                  	                  	}
  BD7: 0E00       	RET
_Function_Drv_UartTX_Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_Uart.c
                  	                  	说    明：	串口函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void Drv_UartTX_Init(void)
                  	                  	函数功能：	UART TX初始化
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Drv_UartTX_Init(void)
                  	                  	{
                  	                  		FP14M = 1;			//TX输出
  BD8: 6CC1       	B0BSET 0xC1.4
L35:
                  	                  		URCR1 = B9600 ;
  BD9: 2DE6       	MOV A, #e6h
  BDA: 2F8D       	B0MOV URCR1, A
L36:
                  	                  		URRX1 = 0x04 ;		//Fuart (Fhosc=8Hz)=Fhosc/16，Disable UART RX，Disable UART RX parity bit function.	
  BDB: 2D04       	MOV A, #04h
  BDC: 2F8C       	B0MOV URRX1, A
L37:
                  	                  		URTX1 = 0x84 ;		//Enable UART TX, Disable UART TX parity bit function.
  BDD: 2D84       	MOV A, #84h
  BDE: 2F8B       	B0MOV URTX1, A
L38:
                  	                  	}
  BDF: 0E00       	RET
_Function_Drv_UartRX_Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void Drv_UartRX_Init(void)
                  	                  	函数功能：	UART RX初始化
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Drv_UartRX_Init(void) 
                  	                  	{
                  	                  		FP15M = 0;			//RX输入
  BE0: 65C1       	B0BCLR P1M.5
L44:
                  	                  		URCR1 = B9600 ;
  BE1: 2DE6       	MOV A, #e6h
  BE2: 2F8D       	B0MOV URCR1, A
L45:
                  	                  		URRX1 = 0x84 ;		//Fuart (Fhosc=8Hz)=Fhosc/16，Enable UART RX，Disable UART RX parity bit function.
  BE3: 2D84       	MOV A, #84h
  BE4: 2F8C       	B0MOV URRX1, A
L46:
                  	                  		FURX1IEN = 1;		//RX必须在中断里接收
  BE5: 6DC9       	B0BSET INTEN0.5
L47:
                  	                  	}
  BE6: 0E00       	RET
_Function_Drv_UartTX_Disable_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void Drv_UartTX_Disable( void )
                  	                  	函数功能：	UART初始化
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Drv_UartTX_Disable( void )
                  	                  	{
                  	                  		FURX1IEN = 0;		//disable RX Interrupt
  BE7: 65C9       	B0BCLR INTEN0.5
L53:
                  	                  		URTX1 = 0x00 ;		//关闭GPIO作为TX功能
  BE8: 3700       	B0MOV 0x87, #00h
  BE9: 2B8B       	CLR 0x8B
L54:
                  	                  		FP14M = 0;			//TX输入
  BEA: 64C1       	B0BCLR 0xC1.4
L55:
                  	                  	}
  BEB: 0E00       	RET
_Function_Drv_UartRX_Disable_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void Drv_UartRX_Disable( void )
                  	                  	函数功能：	UART初始化
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Drv_UartRX_Disable( void )
                  	                  	{
                  	                  		FURX1IEN = 0;		//disable RX Interrupt
  BEC: 65C9       	B0BCLR 0xC9.5
L61:
                  	                  		URRX1 = 0x00 ;		//关闭GPIO作为RX功能
  BED: 2B8C       	CLR 0x8C
L62:
                  	                  		FP15M = 0;			//RX输入
  BEE: 65C1       	B0BCLR 0xC1.5
L63:
                  	                  	}
  BEF: 0E00       	RET
_Function_Uart_Transmit_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	Uart_Transmit()
                  	                  	函数功能：	串口发送
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Uart_Transmit(uint8 part, uint16 data)
                  	                  	{
                  	                  		while(FUTX1BZ);
  BF0: 728B       	B0BTS0 0x8B.2
  BF1: 8BF0       	JMP 0x0BF0
L93:
                  	                  		if(FUTX1BZ==0)
  BF2: 728B       	B0BTS0 0x8B.2
  BF3: 8BF6       	JMP 0x0BF6
L94:
                  	                  			UTX1D = 0x55 ;	//起始位高
  BF4: 2D55       	MOV A, #55h
  BF5: 2F8E       	B0MOV UTX1D, A
L69:
                  	                  			NOP(5);
  BF6: 0000       	NOP
  BF7: 0000       	NOP
  BF8: 0000       	NOP
  BF9: 0000       	NOP
  BFA: 0000       	NOP
L96:
                  	                  		while(FUTX1BZ);
  BFB: 728B       	B0BTS0 URTX1.2
  BFC: 8BFB       	JMP 0x0BFB
L99:
                  	                  		if(FUTX1BZ==0)
  BFD: 728B       	B0BTS0 URTX1.2
  BFE: 8C02       	JMP 0x0C02
L100:
                  	                  			UTX1D = part ;
  BFF: 3702       	B0MOV 0x87, #02h
  C00: 1EA3       	MOV A, 0xA3
  C01: 2F8E       	B0MOV UTX1D, A
L74:
                  	                  			NOP(5);
  C02: 0000       	NOP
  C03: 0000       	NOP
  C04: 0000       	NOP
  C05: 0000       	NOP
  C06: 0000       	NOP
L102:
                  	                  		while(FUTX1BZ);
  C07: 728B       	B0BTS0 URTX1.2
  C08: 8C07       	JMP 0x0C07
L105:
                  	                  		if(FUTX1BZ==0)
  C09: 728B       	B0BTS0 URTX1.2
  C0A: 8C10       	JMP 0x0C10
L106:
                  	                  			UTX1D = data >> 8 ;
  C0B: 2D00       	MOV A, #00h
  C0C: 2F1A       	B0MOV 0x1A, A
  C0D: 3702       	B0MOV 0x87, #02h
  C0E: 1EA5       	MOV A, 0xA5
  C0F: 2F8E       	B0MOV UTX1D, A
L79:
                  	                  			NOP(5);
  C10: 0000       	NOP
  C11: 0000       	NOP
  C12: 0000       	NOP
  C13: 0000       	NOP
  C14: 0000       	NOP
L108:
                  	                  		while(FUTX1BZ);
  C15: 728B       	B0BTS0 URTX1.2
  C16: 8C15       	JMP 0x0C15
L111:
                  	                  		if(FUTX1BZ==0)
  C17: 728B       	B0BTS0 URTX1.2
  C18: 8C1C       	JMP 0x0C1C
L112:
                  	                  			UTX1D = data ;
  C19: 3702       	B0MOV 0x87, #02h
  C1A: 1EA4       	MOV A, 0xA4
  C1B: 2F8E       	B0MOV UTX1D, A
L84:
                  	                  			NOP(5);
  C1C: 0000       	NOP
  C1D: 0000       	NOP
  C1E: 0000       	NOP
  C1F: 0000       	NOP
  C20: 0000       	NOP
L114:
                  	                  		while(FUTX1BZ);
  C21: 728B       	B0BTS0 URTX1.2
  C22: 8C21       	JMP 0x0C21
L117:
                  	                  	}
  C23: 0E00       	RET
_Function_Uart_Send_Wakeup_code:
                  	                  	void Uart_Send_Wakeup(void)
                  	                  	{
                  	                  		char Count = 0;
  C24: 3702       	B0MOV 0x87, #02h
  C25: 2BA3       	CLR 0xA3
L120:
                  	                  		while(FUTX1BZ);
  C26: 728B       	B0BTS0 0x8B.2
  C27: 8C26       	JMP 0x0C26
L137:
                  	                  		for(Count=0;Count<10;Count++)
  C28: 2BA3       	CLR 0xA3
L123:
                  	                  		{
                  	                  			if(FUTX1BZ==0)
  C29: 728B       	B0BTS0 0x8B.2
  C2A: 8C2D       	JMP 0x0C2D
L142:
                  	                  				UTX1D = 0xFF ;
  C2B: 2DFF       	MOV A, #ffh
  C2C: 2F8E       	B0MOV UTX1D, A
L127:
                  	                  			NOP(5);
  C2D: 0000       	NOP
  C2E: 0000       	NOP
  C2F: 0000       	NOP
  C30: 0000       	NOP
  C31: 0000       	NOP
L144:
                  	                  			while(FUTX1BZ);
  C32: 728B       	B0BTS0 URTX1.2
  C33: 8C32       	JMP 0x0C32
L147:
                  	                  		for(Count=0;Count<10;Count++)
  C34: 16A3       	INCMS 0xA3
  C35: 0000       	NOP
L150:
                  	                  		for(Count=0;Count<10;Count++)
  C36: 1EA3       	MOV A, 0xA3
  C37: 1D80       	XOR A, #80h
  C38: 248A       	SUB A, #8ah
  C39: 7A86       	B0BTS1 0x86.2
  C3A: 8C29       	JMP 0x0C29
L151:
                  	                  		}
                  	                  	}
  C3B: 0E00       	RET
_Function_Cal_Inspect_Detect_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_GPIO.c
                  	                  	说    明：	GPIO初始化函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	Cal_Inspect_Detect()
                  	                  	函数功能：	校准模式、绑定模式入口检测
                  	                  	输入参数：	Port_Debug、Port_Cal
                  	                  	输出参数：	uSetFlag
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Cal_Inspect_Detect(void)
                  	                  	{
                  	                  		//绑定检测模式、校温检测模式、系数调整模式判断
                  	                  		if( !Port_Debug && Port_Cal )
  C3C: 74D5       	B0BTS0 0xD5.4
  C3D: 8C4E       	JMP 0x0C4E
  C3E: 7BD5       	B0BTS1 0xD5.3
  C3F: 8C4E       	JMP 0x0C4E
L41:
                  	                  		{
                  	                  			if ( eTestmode_num == Insptectmode )
  C40: 3701       	B0MOV 0x87, #01h
  C41: 1E67       	MOV A, 0x67
  C42: 0604       	CMPRS A, #04h
  C43: 8C49       	JMP 0x0C49
L44:
                  	                  			{
                  	                  				 #if ParamModif
                  	                  				LED_CloseAll();
  C44: CBB1       	CALL 0x0BB1
L47:
                  	                  				eMain_Task = Task_ParamModifymode;	//生产模式短路debug口则进入系数调整模式
  C45: 2D07       	MOV A, #07h
  C46: 3700       	B0MOV 0x87, #00h
  C47: 1F36       	MOV 0x36, A
L48:
                  	                  	            #endif
                  	                  	        }
  C48: 8C4E       	JMP 0x0C4E
L34:
                  	                  			else
                  	                  			{
                  	                  				eSetTask = Set_Unit;		//设置态恢复状态
  C49: 2B6B       	CLR 0x6B
L53:
                  	                  				F_FirstEnter_SetMode = 0;
  C4A: 3700       	B0MOV 0x87, #00h
  C4B: 423B       	BCLR 0x3B.2
L54:
                  	                  				eMain_Task = Task_BondTestmode;	//用户模式下短路debug进入绑定检测模式
  C4C: 2D06       	MOV A, #06h
  C4D: 1F36       	MOV 0x36, A
L55:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		//设置态决不允许进入校温，汇编和C的程序结构不一样，未初始化adc
                  	                  		if( !Port_Cal && !Port_Debug && eMain_Task == Task_ReadyMode )
  C4E: 73D5       	B0BTS0 0xD5.3
  C4F: 8C59       	JMP 0x0C59
  C50: 74D5       	B0BTS0 0xD5.4
  C51: 8C59       	JMP 0x0C59
  C52: 3700       	B0MOV 0x87, #00h
  C53: 2536       	DECS 0x36
  C54: 8C59       	JMP 0x0C59
L60:
                  	                  		{
                  	                  	        #if Func_Ble
                  	                  	            F_Ble_En = Disable;         //进入校准关闭蓝牙
  C55: 4448       	BCLR 0x48.4
L63:
                  	                  	            Port_Ble_En = 0;            //蓝牙失能
  C56: 63D2       	B0BCLR 0xD2.3
L64:
                  	                  	        #endif
                  	                  			eMain_Task = Task_Calimode;		//用户模式下短路debug和cal进入校温模式
  C57: 2D05       	MOV A, #05h
  C58: 1F36       	MOV 0x36, A
L65:
                  	                  		}
                  	                  	}
  C59: 0E00       	RET
_Function_CF_Check_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	CF_Check()
                  	                  	函数功能：	单位状态、单位可切换状态查询
                  	                  	输入参数：	Port_CF、Port_Change_CF
                  	                  	输出参数：	uSetFlag
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void CF_Check(void)
                  	                  	{
                  	                  		//单位状态检测
                  	                  		uSetFlag.bits.Unit = Unit_C;
  C5A: 3700       	B0MOV 0x87, #00h
  C5B: 407F       	BCLR 0x7F.0
L79:
                  	                  		if( !Port_CF )
  C5C: 72D5       	B0BTS0 0xD5.2
  C5D: 8C5F       	JMP 0x0C5F
L80:
                  	                  		{
                  	                  			uSetFlag.bits.Unit = Unit_F;
  C5E: 487F       	BSET 0x7F.0
L83:
                  	                  		}
                  	                  	
                  	                  	}
  C5F: 0E00       	RET
_Function_GPIO_Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	GPIO_Init()
                  	                  	函数功能：	IO口初始化设置
                  	                  	输入参数：	P0、P1、P2、P3、P4、P5
                  	                  	输出参数：	P0、P1、P2、P3、P4、P5
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void GPIO_Init(void)
                  	                  	{
                  	                  		//SDA/SCL输出为0(因为采用的是硬体I2C),按键输入上拉高电平,XIN/XOUT输入不上拉0
                  	                  		//0: input mode, 1: output mode
                  	                  		P0M = 0x0C;			//0b 0000 1100
  C60: 2D0C       	MOV A, #0ch
  C61: 2FC0       	B0MOV P0M, A
L91:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P0UR = 0x13;		//0b 0001 0011
  C62: 2D13       	MOV A, #13h
  C63: 2FE0       	B0MOV P0UR, A
L92:
                  	                  		//0: low level, 1: high level
                  	                  		P0 = 0x1F;			//0b 0001 1111
  C64: 2D1F       	MOV A, #1fh
  C65: 2FD0       	B0MOV P0, A
L93:
                  	                  	 
                  	                  		//白灯输出不上拉高电平,MOSI输出不上拉高电平,MISO输入不上拉高电平,SCK输出不上拉高电平,TX输入不上拉高电平（防止向BLE供电）,RX输入不上拉,VOC_EN,BLE_LINK输入不上拉1
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0x4F;			//0b0100 1111
  C66: 2D4F       	MOV A, #4fh
  C67: 2FC1       	B0MOV P1M, A
L94:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
  C68: 2DFF       	MOV A, #ffh
  C69: 2FB5       	B0MOV P1SEG, A
L95:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0xC0;		//0b1100 0000
  C6A: 2DC0       	MOV A, #c0h
  C6B: 2FE1       	B0MOV P1UR, A
L96:
                  	                  		//0: low level, 1: high lDevel
                  	                  		P1 = 0xB9;			//0b1011 1001
  C6C: 2DB9       	MOV A, #b9h
  C6D: 2FD1       	B0MOV P1, A
L97:
                  	                  	
                  	                  		//P25-P27为seg口，LINK脚输入 不上拉 高,EN输出 上拉 低，BUSY输入不上拉高，G320_EN输出不上拉高，VOC_EN输出不上拉低
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x0B;			//0b0000 1011
  C6E: 2D0B       	MOV A, #0bh
  C6F: 2FC2       	B0MOV P2M, A
L98:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b0001 1111,P25-P27均为LCD口
  C70: 2D1F       	MOV A, #1fh
  C71: 2FB2       	B0MOV P2SEG, A
L99:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x08;		//0b0000 1000
  C72: 2D08       	MOV A, #08h
  C73: 2FDD       	B0MOV P2UR, A
L100:
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x16;			//0b0001 0110
  C74: 2D16       	MOV A, #16h
  C75: 2FD2       	B0MOV P2, A
L101:
                  	                  	
                  	                  		//C/、CF、CAL、Debug输入上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P5M = 0xE0;			//0b1110 0000
  C76: 2DE0       	MOV A, #e0h
  C77: 2FC5       	B0MOV P5M, A
L102:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P5SEG = 0xFF;		//0b1111 1111
  C78: 2DFF       	MOV A, #ffh
  C79: 2FB7       	B0MOV P5SEG, A
L103:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P5UR = 0x1E;		//0b0001 1110
  C7A: 2D1E       	MOV A, #1eh
  C7B: 2FD7       	B0MOV P5UR, A
L104:
                  	                  		//0: low level, 1: high level
                  	                  		P5 = 0xFE;			//0b1111 1110
  C7C: 2DFE       	MOV A, #feh
  C7D: 2FD5       	B0MOV P5, A
L105:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P3M = 0x00;			//均为LCD口
  C7E: 3700       	B0MOV 0x87, #00h
  C7F: 2BC3       	CLR 0xC3
L106:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P3SEG = 0x00;		//均为LCD口
  C80: 2BB3       	CLR 0xB3
L107:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P3UR = 0x00;		//均为LCD口
  C81: 2BDE       	CLR 0xDE
L108:
                  	                  		//0: low level, 1: high level
                  	                  		P3 = 0x00;			//均为LCD口
  C82: 2BD3       	CLR 0xD3
L109:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P4M = 0x00;			//均为LCD口
  C83: 2BC4       	CLR 0xC4
L110:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P4SEG = 0x00;		//均为LCD口
  C84: 2BB6       	CLR 0xB6
L111:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P4UR = 0x00;		//均为LCD口
  C85: 2BD6       	CLR 0xD6
L112:
                  	                  		//0: low level, 1: high level
                  	                  		P4 = 0x00;			//均为LCD口
  C86: 2BD4       	CLR 0xD4
L113:
                  	                  	}
  C87: 0E00       	RET
_Function_GPIO_PowerDown_code:
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	GPIO_PowerDown()
                  	                  	函数功能：	IO口初始化设置
                  	                  	输入参数：	P0、P1、P2、P3、P4、P5
                  	                  	输出参数：	P0、P1、P2、P3、P4、P5
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void GPIO_PowerDown( void )
                  	                  	{
                  	                  		//关机时仅保留唤醒按键上拉，其余非唤醒脚输出低，降低静态电流
                  	                  		//0: input mode, 1: output mode
                  	                  		P0M = 0x1C;			//0b0001 1100
  C88: 2D1C       	MOV A, #1ch
  C89: 2FC0       	B0MOV P0M, A
L119:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P0UR = 0x23;		//0b0010 0011
  C8A: 2D23       	MOV A, #23h
  C8B: 2FE0       	B0MOV P0UR, A
L120:
                  	                  		//0: low level, 1: high level
                  	                  		P0 = 0x2F;			//0b0010 1111
  C8C: 2D2F       	MOV A, #2fh
  C8D: 2FD0       	B0MOV P0, A
L121:
                  	                  	
                  	                  	#if !Func_Ble
                  	                  		//白灯输入上拉高，按键输入上拉高电平,BZ/MOSI/MISO/TX/RX/SCK均输出不上拉低，
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0xFE;			//0b 1111 1110
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0x01;		//0b 0100 0001
                  	                  		//0: low level, 1: high level
                  	                  		P1 = 0x01;			//0b 0100 0001
                  	                  	
                  	                  		//P25-P27为seg口，BLE_Link、BLE_EN、BLE_BUSY、G320_EN输出不上拉低，VOC_EN输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x03;			//0b 0000 0011
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b 0001 1111,P25-P27均为LCD口
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x1D;		//0b 0001 1101
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x1D;			//0b 0001 1101
                  	                  	#else
                  	                  		//按键输出不上拉低,，SCK/RX1/TX1/MISO/MOSI/BZ输出不上拉低,白灯输入上拉高，
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0xFE;			//0b 1111 1110
  C8E: 2DFE       	MOV A, #feh
  C8F: 2FC1       	B0MOV P1M, A
L122:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
  C90: 2DFF       	MOV A, #ffh
  C91: 2FB5       	B0MOV P1SEG, A
L123:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0x01;		//0b 0000 0001
  C92: 2D01       	MOV A, #01h
  C93: 2FE1       	B0MOV P1UR, A
L124:
                  	                  		//0: low level, 1: high level
                  	                  		P1 = 0x01;			//0b 0000 0001
  C94: 2FD1       	B0MOV P1, A
L125:
                  	                  	
                  	                  		//P25-P27为seg口，BLE_Link、BLE_EN、BLE_BUSY、G320_EN输出不上拉低，VOC_EN输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x1F;			//0b 0001 1111
  C95: 2D1F       	MOV A, #1fh
  C96: 2FC2       	B0MOV P2M, A
L126:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b 0001 1111,P25-P27均为LCD口
  C97: 2FB2       	B0MOV P2SEG, A
L127:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x01;		//0b 0000 0001
  C98: 2D01       	MOV A, #01h
  C99: 2FDD       	B0MOV P2UR, A
L128:
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x01;			//0b 0000 0001
  C9A: 2FD2       	B0MOV P2, A
L129:
                  	                  	#endif
                  	                  	
                  	                  	    //RGB输入上拉高，CAL/Debug输入上拉高电平,C/F、CF输出不上拉0，MOTOR输出不上拉低
                  	                  	    //0: input mode, 1: output mode
                  	                  	    P5M = 0x07;			//0b0000 0111
  C9B: 2D07       	MOV A, #07h
  C9C: 2FC5       	B0MOV P5M, A
L130:
                  	                  	    //0: LCD functon pin, 1: IO pin
                  	                  	    P5SEG = 0xFF;		//0b1111 1111
  C9D: 2DFF       	MOV A, #ffh
  C9E: 2FB7       	B0MOV P5SEG, A
L131:
                  	                  	    //0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  	    P5UR = 0xF8;		//0b1111 1000
  C9F: 2DF8       	MOV A, #f8h
  CA0: 2FD7       	B0MOV P5UR, A
L132:
                  	                  	    //0: low level, 1: high level
                  	                  	    P5 = 0xF8;			//0b1111 1000
  CA1: 2FD5       	B0MOV P5, A
L133:
                  	                  	
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P3M = 0x00;			//均为LCD口
  CA2: 3700       	B0MOV 0x87, #00h
  CA3: 2BC3       	CLR 0xC3
L134:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P3SEG = 0x00;		//均为LCD口
  CA4: 2BB3       	CLR 0xB3
L135:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P3UR = 0x00;		//均为LCD口
  CA5: 2BDE       	CLR 0xDE
L136:
                  	                  		//0: low level, 1: high level
                  	                  		P3 = 0x00;			//均为LCD口
  CA6: 2BD3       	CLR 0xD3
L137:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P4M = 0x00;			//均为LCD口
  CA7: 2BC4       	CLR 0xC4
L138:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P4SEG = 0x00;		//均为LCD口
  CA8: 2BB6       	CLR 0xB6
L139:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P4UR = 0x00;		//均为LCD口
  CA9: 2BD6       	CLR 0xD6
L140:
                  	                  		//0: low level, 1: high level
                  	                  		P4 = 0x00;			//均为LCD口
  CAA: 2BD4       	CLR 0xD4
L141:
                  	                  	}
  CAB: 0E00       	RET
_Function_main_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	ETH_2988_SJ_V1.0_20200704.c
                  	                  	说    明：	耳套可选,单位焊接选择,背光可选,物温可选
                  	                  	程序编码：	详见Variable.h
                  	                  	版    本：	V1.0
                  	                  	适用 PCB:	ETH PCB(A)
                  	                  	芯	  片:	SN8P2988
                  	                  	作    者:	Liaoy
                  	                  	修订记录：
                  	                  	1、在ET215-2988-242-V1.0-20190821基础上生成ETH程序；
                  	                  	V1.0：
                  	                  	采用宏定义合并程序，版本不升级，廖彦20200704
                  	                  	V1.0:
                  	                  	传感器表格也进行宏定义，与之PGA放大倍数也必须宏定义，版本升级为V1.6，廖彦20200723
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	
                  	                  	//主程序
                  	                  	void main(void)
                  	                  	{
                  	                  		//系统时钟设定
                  	                  	  	OSCM = 0x00;		//开启内置IHRC=8M，外置低速晶振32768，Fcpu=Normal mode
  CAC: 3700       	B0MOV 0x87, #00h
  CAD: 2BCA       	CLR 0xCA
L126:
                  	                  		Delay50us(100);
  CAE: 2D64       	MOV A, #64h
  CAF: 3702       	B0MOV 0x87, #02h
  CB0: 1FA3       	MOV 0xA3, A
  CB1: C77E       	CALL 0x077E
L127:
                  	                  	
                  	                  		//部分参数设置，如年月日时分秒
                  	                  		g_Hour = 0;
  CB2: 3700       	B0MOV 0x87, #00h
  CB3: 2B78       	CLR 0x78
L128:
                  	                  		g_Minute = 0;
  CB4: 2B79       	CLR 0x79
L129:
                  	                  		g_Day = 1;
  CB5: 2D01       	MOV A, #01h
  CB6: 1F7A       	MOV 0x7A, A
L130:
                  	                  		g_Month = 1;
  CB7: 1F7B       	MOV 0x7B, A
L131:
                  	                  		g_Year = Default_Year;
  CB8: 2DE7       	MOV A, #e7h
  CB9: 1F7C       	MOV 0x7C, A
  CBA: 2D07       	MOV A, #07h
  CBB: 1F7D       	MOV 0x7D, A
L132:
                  	                  		g_Second = 0;
  CBC: 2B7E       	CLR 0x7E
L133:
                  	                  		uSetFlag.bits.TimeFormat = TimeFormat_24H;	//默认24小时制
  CBD: 417F       	BCLR 0x7F.1
L134:
                  	                  		uSetFlag.bits.Unit = Unit_C;	//默认C单位
  CBE: 407F       	BCLR 0x7F.0
L135:
                  	                  	
                  	                  		#if CF_Change_Enable == 1
                  	                  			uSetFlag.bits.Unit_Change = Unit_Change_En;	//默认单位可切换
  CBF: 427F       	BCLR 0x7F.2
L136:
                  	                  		#else
                  	                  			uSetFlag.bits.Unit_Change = Unit_Change_Dis;	//默认单位可切换
                  	                  		#endif
                  	                  	
                  	                  		uSetFlag.bits.VoiceEnable = 1;        //默认开启语音
  CC0: 4B7F       	BSET 0x7F.3
L137:
                  	                  	
                  	                  		#if Func_Ble
                  	                  			uSetFlag.bits.BleEnable = Enable;
  CC1: 4D7F       	BSET 0x7F.5
L138:
                  	                  		#endif
                  	                  		
                  	                  		GPIO_Init();//IO口设置
  CC2: CC60       	CALL 0x0C60
L139:
                  	                  		Lcd_Init();	//Lcd设置
  CC3: E34A       	CALL 0x234A
L140:
                  	                  		CF_Check();	//单位状态确认
  CC4: CC5A       	CALL 0x0C5A
L141:
                  	                  	
                  	                  		//上电是否进入设置态
                  	                  		#if Electricity_poweroff == 0
                  	                  			eMain_Task = Task_Setmode;
                  	                  		#else
                  	                  			eMain_Task = Task_Sleepmode;
  CC5: 2D08       	MOV A, #08h
  CC6: 1F36       	MOV 0x36, A
L142:
                  	                  			eSleepTask_Sta = Sleep_true;
  CC7: 2D02       	MOV A, #02h
  CC8: 3702       	B0MOV 0x87, #02h
  CC9: 1F4A       	MOV 0x4A, A
L143:
                  	                  		#endif
                  	                  	
                  	                  		eTestmode_num = Earmode;	//默认耳温模式
  CCA: 3701       	B0MOV 0x87, #01h
  CCB: 2B67       	CLR 0x67
L144:
                  	                  	    eAgemode_num = BigAge;
  CCC: 3700       	B0MOV 0x87, #00h
  CCD: 1F33       	MOV 0x33, A
L145:
                  	                  	
                  	                  		//低电压检测
                  	                  		#if Second_LVD == 1
                  	                  			LBT_Chk();
  CCE: CB70       	CALL 0x0B70
L146:
                  	                  		#else
                  	                  			LVD_Init();	//低电压设置
                  	                  			LVD_Chk();
                  	                  		#endif
                  	                  		if( uStaFlag.bits.LowBat )
  CCF: 5935       	BTS1 0x35.1
  CD0: 8CE1       	JMP 0x0CE1
L147:
                  	                  		{
                  	                  			Clr_Disp();
  CD1: E958       	CALL 0x2958
L150:
                  	                  			lcd_bat_en();
  CD2: 2D01       	MOV A, #01h
  CD3: 1903       	OR 0x03, A
L153:
                  	                  			eMain_Task = Task_InitMode;
  CD4: 3700       	B0MOV 0x87, #00h
  CD5: 2B36       	CLR 0x36
L157:
                  	                  			eInitTask_Sta = Init_Err;
  CD6: 2D06       	MOV A, #06h
  CD7: 3701       	B0MOV 0x87, #01h
  CD8: 1F68       	MOV 0x68, A
  CD9: 8CDC       	JMP 0x0CDC
L46:
                  	                  	        {
                  	                  	            WDTR = 0x5A;        // Clear WDTR Dog
  CDA: 2D5A       	MOV A, #5ah
  CDB: 2FCC       	B0MOV WDTR, A
L161:
                  	                  	        while(!Port_Test)
  CDC: 79D0       	B0BTS1 P0.1
  CDD: 8CDA       	JMP 0x0CDA
L164:
                  	                  	        }
                  	                  	        uKeyRelease.bits.TKeyRelease = 1;
  CDE: 4914       	BSET 0x14.1
L165:
                  	                  	
                  	                  			eSleepTask_Sta = Sleep_false;
  CDF: 3702       	B0MOV 0x87, #02h
  CE0: 2B4A       	CLR 0x4A
L166:
                  	                  		}
                  	                  		//EEPROM参数校验(如果校验和识别码都错则初始化数据，如果仅校验和错误则报错)
                  	                  		Parm_AutoCheck();
  CE1: C0D2       	CALL 0x00D2
L169:
                  	                  	
                  	                  		TC1Init();	//TC1设置（10ms）
  CE2: CBBE       	CALL 0x0BBE
L170:
                  	                  		T0Init();	//开启RTC中断
  CE3: CBB6       	CALL 0x0BB6
L171:
                  	                  		FGIE = 1;	//使能总中断等
  CE4: 6FDF       	B0BSET 0xDF.7
L172:
                  	                  	
                  	                  		// 关机时间重置
                  	                  		Auto_TurnOff_Time_Sel();	//关机时间选择
  CE5: E2A8       	CALL 0x22A8
L173:
                  	                  		// 初始化按键信息
                  	                  		HalKey_Set_KeyMode(Func_Long, &sTestKey);		//开机&测量键设为长按
  CE6: 2D0A       	MOV A, #0ah
  CE7: 1FA4       	MOV 0xA4, A
