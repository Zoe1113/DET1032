                  	                  	//只在本文件内使用的宏定义
                  	                  	//温度分段阈值
                  	                  	#define SlightTempC	0x0E92		//37.3
                  	                  	#define FeverTempC	0x0EC4		//37.8
                  	                  	#define SlightTempF	0x26B6		//99.1
                  	                  	#define FeverTempF	0x2710		//100.0
                  	                  	
