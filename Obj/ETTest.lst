  C78: 2DB9       	MOV A, #b9h
  C79: 2FD1       	B0MOV P1, A
L97:
                  	                  	
                  	                  		//P25-P27为seg口，LINK脚输入 不上拉 高,EN输出 上拉 低，BUSY输入不上拉高，G320_EN输出不上拉高，VOC_EN输出不上拉低
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x0B;			//0b0000 1011
  C7A: 2D0B       	MOV A, #0bh
  C7B: 2FC2       	B0MOV P2M, A
L98:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b0001 1111,P25-P27均为LCD口
  C7C: 2D1F       	MOV A, #1fh
  C7D: 2FB2       	B0MOV P2SEG, A
L99:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x08;		//0b0000 1000
  C7E: 2D08       	MOV A, #08h
  C7F: 2FDD       	B0MOV P2UR, A
L100:
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x16;			//0b0001 0110
  C80: 2D16       	MOV A, #16h
  C81: 2FD2       	B0MOV P2, A
L101:
                  	                  	
                  	                  		//C/、CF、CAL、Debug输入上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P5M = 0xE0;			//0b1110 0000
  C82: 2DE0       	MOV A, #e0h
  C83: 2FC5       	B0MOV P5M, A
L102:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P5SEG = 0xFF;		//0b1111 1111
  C84: 2DFF       	MOV A, #ffh
  C85: 2FB7       	B0MOV P5SEG, A
L103:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P5UR = 0x1E;		//0b0001 1110
  C86: 2D1E       	MOV A, #1eh
  C87: 2FD7       	B0MOV P5UR, A
L104:
                  	                  		//0: low level, 1: high level
                  	                  		P5 = 0xFE;			//0b1111 1110
  C88: 2DFE       	MOV A, #feh
  C89: 2FD5       	B0MOV P5, A
L105:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P3M = 0x00;			//均为LCD口
  C8A: 3700       	B0MOV 0x87, #00h
  C8B: 2BC3       	CLR 0xC3
L106:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P3SEG = 0x00;		//均为LCD口
  C8C: 2BB3       	CLR 0xB3
L107:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P3UR = 0x00;		//均为LCD口
  C8D: 2BDE       	CLR 0xDE
L108:
                  	                  		//0: low level, 1: high level
                  	                  		P3 = 0x00;			//均为LCD口
  C8E: 2BD3       	CLR 0xD3
L109:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P4M = 0x00;			//均为LCD口
  C8F: 2BC4       	CLR 0xC4
L110:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P4SEG = 0x00;		//均为LCD口
  C90: 2BB6       	CLR 0xB6
L111:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P4UR = 0x00;		//均为LCD口
  C91: 2BD6       	CLR 0xD6
L112:
                  	                  		//0: low level, 1: high level
                  	                  		P4 = 0x00;			//均为LCD口
  C92: 2BD4       	CLR 0xD4
L113:
                  	                  	}
  C93: 0E00       	RET
_Function_GPIO_PowerDown_code:
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	GPIO_PowerDown()
                  	                  	函数功能：	IO口初始化设置
                  	                  	输入参数：	P0、P1、P2、P3、P4、P5
                  	                  	输出参数：	P0、P1、P2、P3、P4、P5
