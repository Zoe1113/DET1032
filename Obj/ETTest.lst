  CE7: 2FCC       	B0MOV WDTR, A
L161:
                  	                  	        while(!Port_Test)
  CE8: 79D0       	B0BTS1 P0.1
  CE9: 8CE6       	JMP 0x0CE6
L164:
                  	                  	        }
                  	                  	        uKeyRelease.bits.TKeyRelease = 1;
  CEA: 4915       	BSET 0x15.1
L165:
                  	                  	
                  	                  			eSleepTask_Sta = Sleep_false;
  CEB: 3702       	B0MOV 0x87, #02h
  CEC: 2B4A       	CLR 0x4A
L166:
                  	                  		}
                  	                  		//EEPROM参数校验(如果校验和识别码都错则初始化数据，如果仅校验和错误则报错)
                  	                  		Parm_AutoCheck();
  CED: C0D2       	CALL 0x00D2
L169:
                  	                  	
                  	                  		TC1Init();	//TC1设置（10ms）
