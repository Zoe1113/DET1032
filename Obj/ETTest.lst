                  	                  	uint8 g_Ble_TxData[250];	//蓝牙发送数据缓冲区（最大30组记忆*8byte + 10 byte = 250byte）
                  	                  	uint8 Ble_Waittostart;      //等待重连的延时
                  	                  	
                  	                  	void App_BleMode(void)
                  	                  	{
