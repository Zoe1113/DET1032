 3117: 2D0E       	MOV A, #0eh
 3118: 1F09       	MOV 0x09, A
L40:
                  	                  	        lcd4 = S_P;
 3119: 2D0C       	MOV A, #0ch
 311A: 1F0A       	MOV 0x0A, A
L41:
                  	                  	#endif
                  	                  	
                  	                  	#if Sensor == ZXH
                  	                  	//ZXH
                  	                  	        lcd7 = 0x07;
                  	                  	        lcd6 = 0x06;
                  	                  	#endif
                  	                  	
                  	                  	#if Sensor == STP10DF55
                  	                  	//STP10DF55
                  	                  			lcd9 = DispTable[ 1 ] >> 8;
                  	                  	        lcd8 = DispTable[ 1 ];
                  	                  	        lcd7 = DispTable[ 0 ] >> 8;
                  	                  	        lcd6 = DispTable[ 0 ];
                  	                  	        lcd5 = S_d>>8;
                  	                  	        lcd4 = S_d;
                  	                  	#endif
                  	                  	
                  	                  	#if Sensor == STP11DF55
                  	                  	//STP11DF55
                  	                  			lcd9 = DispTable[ 1 ] >> 8;
                  	                  	        lcd8 = DispTable[ 1 ];
                  	                  	        lcd7 = DispTable[ 1 ] >> 8;
                  	                  	        lcd6 = DispTable[ 1 ];
                  	                  	        lcd5 = S_d>>8;
                  	                  	        lcd4 = S_d;
                  	                  	#endif
                  	                  	}
 311B: 0E00       	RET
