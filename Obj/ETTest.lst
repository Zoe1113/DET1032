                  	                  	//后面应该用AbCdEF取代
                  	                  	uint16 __ROM	DispTable[10] =	 {	SA+SB+SC+SD+SE+SF,			//0		0
                  	                  										SB+SC,						//1		1
                  	                  										SA+SB+SD+SE+SG,				//2		2
                  	                  										SA+SB+SC+SD+SG,				//3		3
                  	                  										SB+SC+SF+SG,				//4		4
