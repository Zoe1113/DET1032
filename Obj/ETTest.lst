                  	                  	#define SlightTempC0	0x0E9C		//37.4
                  	                  	#define FeverTempC0	    0x0E9C		//37.4
                  	                  	#define SlightTempF0	0x26CA		//99.3
                  	                  	#define FeverTempF0 	0x26CA		//99.3
                  	                  	
