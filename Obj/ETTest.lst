 3081: 2D0C       	MOV A, #0ch
 3082: 1F0A       	MOV 0x0A, A
L41:
                  	                  	#endif
                  	                  	
                  	                  	#if Sensor == ZXH
                  	                  	//ZXH
                  	                  	        lcd7 = 0x07;
                  	                  	        lcd6 = 0x06;
                  	                  	#endif
                  	                  	
                  	                  	#if Sensor == STP10DF55
                  	                  	//STP10DF55
                  	                  			lcd9 = DispTable[ 1 ] >> 8;
                  	                  	        lcd8 = DispTable[ 1 ];
                  	                  	        lcd7 = DispTable[ 0 ] >> 8;
                  	                  	        lcd6 = DispTable[ 0 ];
                  	                  	        lcd5 = S_d>>8;
                  	                  	        lcd4 = S_d;
                  	                  	#endif
                  	                  	
                  	                  	#if Sensor == STP11DF55
                  	                  	//STP11DF55
                  	                  			lcd9 = DispTable[ 1 ] >> 8;
                  	                  	        lcd8 = DispTable[ 1 ];
                  	                  	        lcd7 = DispTable[ 1 ] >> 8;
                  	                  	        lcd6 = DispTable[ 1 ];
                  	                  	        lcd5 = S_d>>8;
                  	                  	        lcd4 = S_d;
                  	                  	#endif
                  	                  	}
 3083: 0E00       	RET
_Function_Ntc_Caculate_code:
                  	                  	
                  	                  	#if Sensor == STP9CF55
                  	                  	
                  	                  	/**************************************************************************
                  	                  	//STP9CF55 Sensor Thermistor 参数
                  	                  	**************************************************************************/
                  	                  	const int16 g_Table37C = 0x05EA;			//37℃校准理论值
                  	                  	const int16 g_Table41C = 0x080B;			//41℃校准理论值
                  	                  	#if Nation									//国外为10-40℃
                  	                  	const uint16 g_NtcTableDown1 = 0x4D97;		//10℃NTC表格值
                  	                  	const uint16 g_NtcTableUp1 = 0x14CF;		//40℃NTC表格值
                  	                  	#else										//国内为16-35℃
                  	                  	const uint16 g_NtcTableDown1 = 0x3A97;		//16℃NTC表格值 
                  	                  	const uint16 g_NtcTableUp1 = 0x1980;		//35℃NTC表格值 
