_Function_LBT_Chk_code:
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LBT_Chk(void)
                  	                  	函数功能：	二级电压检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat,uStaFlag.bits.MidBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LBT_Chk(void)
                  	                  	{
                  	                  		uint8 i=0 ;				
  BF2: 3702       	B0MOV 0x87, #02h
  BF3: 2BA8       	CLR 0xA8
L109:
                  	                  	
                  	                  		/*先用2.7V的比较电压检测*/
                  	                  		LBTM = 0x14 ;		
  BF4: 2D14       	MOV A, #14h
  BF5: 2F95       	B0MOV LBTM, A
L110:
                  	                  		Delay50us(1) ;
  BF6: 2D01       	MOV A, #01h
  BF7: 1FA4       	MOV 0xA4, A
  BF8: C77E       	CALL 0x077E
L111:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  BF9: 6895       	B0BSET 0x95.0
L112:
                  	                  	
                  	                  		/*若低电压连续有十次，则置低电压标志为1，清低电压计数*/
                  	                  		for( i=0; i<10; i++ )	
  BFA: 2BA8       	CLR 0xA8
  BFB: 8C0B       	JMP 0x0C0B
L78:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;		
  BFC: 2D01       	MOV A, #01h
  BFD: 1FA4       	MOV 0xA4, A
  BFE: C7A3       	CALL 0x07A3
L117:
                  	                  			/* FLBTO 1:低电压 0：正常电压 */
                  	                  			if( FLBTO )			
  BFF: 7995       	B0BTS1 0x95.1
  C00: 8C04       	JMP 0x0C04
L118:
                  	                  			{
                  	                  				/*二级电压第一级标志位打开*/
                  	                  				uStaFlag.bits.MidBat = 1;
  C01: 3700       	B0MOV 0x87, #00h
  C02: 4D32       	BSET 0x32.5
L121:
                  	                  			}
  C03: 8C08       	JMP 0x0C08
L82:
                  	                  			/*如果有一次未检测到*/
                  	                  			else
                  	                  			{
                  	                  				/*清除标志位并返回*/
                  	                  				uStaFlag.bits.MidBat = 0;		
  C04: 3700       	B0MOV 0x87, #00h
  C05: 4532       	BCLR 0x32.5
L126:
                  	                  				uStaFlag.bits.LowBat = 0 ;
  C06: 4132       	BCLR 0x32.1
L127:
                  	                  				return;		
  C07: 8C2D       	JMP 0x0C2D
L128:
                  	                  		for( i=0; i<10; i++ )	
  C08: 3702       	B0MOV 0x87, #02h
  C09: 16A8       	INCMS 0xA8
  C0A: 0000       	NOP
L81:
                  	                  		for( i=0; i<10; i++ )	
  C0B: 1EA8       	MOV A, 0xA8
  C0C: 240A       	SUB A, #0ah
  C0D: 7A86       	B0BTS1 0x86.2
  C0E: 8BFC       	JMP 0x0BFC
L134:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果连续十次小于2.7v，判断有没有低于2.6v*/
                  	                  		/*选择2.6v作为比较电压*/
                  	                  		LBTM = 0x10 ;		
  C0F: 2D10       	MOV A, #10h
  C10: 2F95       	B0MOV LBTM, A
L137:
                  	                  		Delay50us(1) ;
  C11: 2D01       	MOV A, #01h
  C12: 1FA4       	MOV 0xA4, A
  C13: C77E       	CALL 0x077E
L138:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  C14: 6895       	B0BSET 0x95.0
L139:
                  	                  	
                  	                  		for( i=0; i<10; i++ )	
  C15: 2BA8       	CLR 0xA8
  C16: 8C25       	JMP 0x0C25
L90:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;	
  C17: 2D01       	MOV A, #01h
  C18: 1FA4       	MOV 0xA4, A
  C19: C7A3       	CALL 0x07A3
L144:
                  	                  			/*FLBTO 1:低电压 0：正常电压*/
                  	                  			if( FLBTO )			
  C1A: 7995       	B0BTS1 0x95.1
  C1B: 8C1F       	JMP 0x0C1F
L145:
                  	                  			{
                  	                  				/*二级电压第二级标志位打开*/
                  	                  				uStaFlag.bits.LowBat = 1 ;	
  C1C: 3700       	B0MOV 0x87, #00h
  C1D: 4932       	BSET 0x32.1
L148:
                  	                  			}
  C1E: 8C22       	JMP 0x0C22
L94:
                  	                  			else
                  	                  			{
                  	                  				/*如果有一次大于2.6V*/
                  	                  				uStaFlag.bits.LowBat = 0 ;
  C1F: 3700       	B0MOV 0x87, #00h
  C20: 4132       	BCLR 0x32.1
L153:
                  	                  				return;		
  C21: 8C2D       	JMP 0x0C2D
L154:
                  	                  		for( i=0; i<10; i++ )	
  C22: 3702       	B0MOV 0x87, #02h
  C23: 16A8       	INCMS 0xA8
  C24: 0000       	NOP
L93:
                  	                  		for( i=0; i<10; i++ )	
  C25: 1EA8       	MOV A, 0xA8
  C26: 240A       	SUB A, #0ah
  C27: 7A86       	B0BTS1 0x86.2
  C28: 8C17       	JMP 0x0C17
L160:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果二级电压第二级标志位打开*/
                  	                  		if(uStaFlag.bits.LowBat == 1)
  C29: 3700       	B0MOV 0x87, #00h
  C2A: 5932       	BTS1 0x32.1
  C2B: 8C2D       	JMP 0x0C2D
L163:
                  	                  		{
                  	                  			/*二级电压第一级标志位关闭*/
                  	                  			uStaFlag.bits.MidBat = 0;
  C2C: 4532       	BCLR 0x32.5
L166:
                  	                  		}
                  	                  		return;
                  	                  	}
  C2D: 0E00       	RET
_Function_Drv_Led_Set_code:
                  	                  	/**************************************************************************
