_Function_HalKey_KeyClr_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void HalKey_KeyClr(void)
                  	                  	函数功能：	清除所有按键信息（非所有，重点部分）
                  	                  	输入参数：	g_KeyHold_Flag、g_KeyPress_Flag、g_KeyRelease_Flag、g_KeyContinue_Flag、g_Key_Val（键值）、g_Key_Status（按键状态）
                  	                  	输出参数：	g_KeyHold_Flag、g_KeyPress_Flag、g_KeyRelease_Flag、g_KeyContinue_Flag、g_Key_Val（键值）、g_Key_Status（按键状态）
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void HalKey_KeyClr(void)
                  	                  	{
                  	                  	    uKeyHold.g_KeyHold_Flag = 0;
  B41: 3701       	B0MOV 0x87, #01h
  B42: 2B16       	CLR 0x16
L748:
                  	                  	    uKeyPress.g_KeyPress_Flag = 0;
  B43: 2B17       	CLR 0x17
L749:
                  	                  	    uKeyRelease.g_KeyRelease_Flag = 0;
  B44: 2B15       	CLR 0x15
L750:
                  	                  	    uKeyContinue.g_KeyContinue_Flag = 0;
  B45: 2B14       	CLR 0x14
L751:
                  	                  	
                  	                  	    sMemKey.g_Key_Val = 0;
  B46: 2B10       	CLR 0x10
L752:
                  	                  	    sTestKey.g_Key_Val = 0;
  B47: 2B0B       	CLR 0x0B
L753:
                  	                  	    sSetKey.g_Key_Val = 0;
  B48: 2B06       	CLR 0x06
L754:
                  	                  	#if Func_Probecover
                  	                  	    sEarcapKey.g_Key_Val = 0;
  B49: 2B01       	CLR 0x01
L755:
                  	                  	#endif
                  	                  	
                  	                  	    sMemKey.g_Key_Status = 0;
  B4A: 2B11       	CLR 0x11
L756:
                  	                  	    sTestKey.g_Key_Status = 0;
  B4B: 2B0C       	CLR 0x0C
L757:
                  	                  	    sSetKey.g_Key_Status = 0;
  B4C: 2B07       	CLR 0x07
L758:
                  	                  	#if Func_Probecover
                  	                  	    sEarcapKey.g_Key_Status = 0;
  B4D: 2B02       	CLR 0x02
L759:
                  	                  	#endif
                  	                  	}
  B4E: 0E00       	RET
_Function_LVD_Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LVD.c
                  	                  	说    明：	低电压处理函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Init(void)
                  	                  	函数功能：	low voltage初始化设置
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LVD_Init(void)
                  	                  	{
                  	                  		//internal lvd
                  	                  		LBTM = 0x10 ;		//低电压<2.6V，内部电压检测
  B4F: 2D10       	MOV A, #10h
  B50: 2F95       	B0MOV LBTM, A
L35:
                  	                  		Delay50us(1) ;
  B51: 2D01       	MOV A, #01h
  B52: 3702       	B0MOV 0x87, #02h
  B53: 1FA3       	MOV 0xA3, A
  B54: C77E       	CALL 0x077E
L36:
                  	                  		FLBTEN = 1 ;		//enable low-voltage detect
  B55: 6895       	B0BSET 0x95.0
L37:
                  	                  	}
  B56: 0E00       	RET
_Function_LVD_Chk_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Chk(void)
                  	                  	函数功能：	low voltage检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	100ms（Fcup=2M）
                  	                  	**************************************************************************/
                  	                  	void LVD_Chk(void)
                  	                  	{
                  	                  		uint8 i ;		//count with low-voltage
                  	                  	
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B57: 3702       	B0MOV 0x87, #02h
  B58: 2BA7       	CLR 0xA7
  B59: 8B68       	JMP 0x0B68
L40:
                  	                  		{
                  	                  			Delay10ms(1) ;		//延迟10ms稳定
  B5A: 2D01       	MOV A, #01h
  B5B: 1FA3       	MOV 0xA3, A
  B5C: C7A3       	CALL 0x07A3
L57:
                  	                  			if( FLBTO )			//FLBTO 1:低电压 0：正常电压
  B5D: 7995       	B0BTS1 0x95.1
  B5E: 8B62       	JMP 0x0B62
L58:
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 1 ;
  B5F: 3700       	B0MOV 0x87, #00h
  B60: 4932       	BSET 0x32.1
L61:
                  	                  			}
  B61: 8B65       	JMP 0x0B65
L44:
                  	                  			else
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 0 ;
  B62: 3700       	B0MOV 0x87, #00h
  B63: 4132       	BCLR 0x32.1
L66:
                  	                  				break;
  B64: 8B6C       	JMP 0x0B6C
L67:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B65: 3702       	B0MOV 0x87, #02h
  B66: 16A7       	INCMS 0xA7
  B67: 0000       	NOP
L43:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B68: 1EA7       	MOV A, 0xA7
  B69: 240A       	SUB A, #0ah
  B6A: 7A86       	B0BTS1 0x86.2
  B6B: 8B5A       	JMP 0x0B5A
L42:
                  	                  			}
                  	                  		}
                  	                  	}
  B6C: 0E00       	RET
_Function_LBT_Chk_code:
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LBT_Chk(void)
                  	                  	函数功能：	二级电压检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat,uStaFlag.bits.MidBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LBT_Chk(void)
                  	                  	{
                  	                  		uint8 i=0 ;				
  B6D: 3702       	B0MOV 0x87, #02h
  B6E: 2BA7       	CLR 0xA7
L109:
                  	                  	
                  	                  		/*先用2.7V的比较电压检测*/
                  	                  		LBTM = 0x14 ;		
  B6F: 2D14       	MOV A, #14h
  B70: 2F95       	B0MOV LBTM, A
L110:
                  	                  		Delay50us(1) ;
  B71: 2D01       	MOV A, #01h
  B72: 1FA3       	MOV 0xA3, A
  B73: C77E       	CALL 0x077E
L111:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  B74: 6895       	B0BSET 0x95.0
L112:
                  	                  	
                  	                  		/*若低电压连续有十次，则置低电压标志为1，清低电压计数*/
                  	                  		for( i=0; i<10; i++ )	
  B75: 2BA7       	CLR 0xA7
  B76: 8B86       	JMP 0x0B86
L78:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;		
  B77: 2D01       	MOV A, #01h
  B78: 1FA3       	MOV 0xA3, A
  B79: C7A3       	CALL 0x07A3
L117:
                  	                  			/* FLBTO 1:低电压 0：正常电压 */
                  	                  			if( FLBTO )			
  B7A: 7995       	B0BTS1 0x95.1
  B7B: 8B7F       	JMP 0x0B7F
L118:
                  	                  			{
                  	                  				/*二级电压第一级标志位打开*/
                  	                  				uStaFlag.bits.MidBat = 1;
  B7C: 3700       	B0MOV 0x87, #00h
  B7D: 4D32       	BSET 0x32.5
L121:
                  	                  			}
  B7E: 8B83       	JMP 0x0B83
L82:
                  	                  			/*如果有一次未检测到*/
                  	                  			else
                  	                  			{
                  	                  				/*清除标志位并返回*/
                  	                  				uStaFlag.bits.MidBat = 0;		
  B7F: 3700       	B0MOV 0x87, #00h
  B80: 4532       	BCLR 0x32.5
L126:
                  	                  				uStaFlag.bits.LowBat = 0 ;
  B81: 4132       	BCLR 0x32.1
L127:
                  	                  				return;		
  B82: 8BA8       	JMP 0x0BA8
L128:
                  	                  		for( i=0; i<10; i++ )	
  B83: 3702       	B0MOV 0x87, #02h
  B84: 16A7       	INCMS 0xA7
  B85: 0000       	NOP
L81:
                  	                  		for( i=0; i<10; i++ )	
  B86: 1EA7       	MOV A, 0xA7
  B87: 240A       	SUB A, #0ah
  B88: 7A86       	B0BTS1 0x86.2
  B89: 8B77       	JMP 0x0B77
L134:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果连续十次小于2.7v，判断有没有低于2.6v*/
                  	                  		/*选择2.6v作为比较电压*/
                  	                  		LBTM = 0x10 ;		
  B8A: 2D10       	MOV A, #10h
  B8B: 2F95       	B0MOV LBTM, A
L137:
                  	                  		Delay50us(1) ;
  B8C: 2D01       	MOV A, #01h
  B8D: 1FA3       	MOV 0xA3, A
  B8E: C77E       	CALL 0x077E
L138:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  B8F: 6895       	B0BSET 0x95.0
L139:
                  	                  	
                  	                  		for( i=0; i<10; i++ )	
  B90: 2BA7       	CLR 0xA7
  B91: 8BA0       	JMP 0x0BA0
L90:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;	
  B92: 2D01       	MOV A, #01h
  B93: 1FA3       	MOV 0xA3, A
  B94: C7A3       	CALL 0x07A3
L144:
                  	                  			/*FLBTO 1:低电压 0：正常电压*/
                  	                  			if( FLBTO )			
  B95: 7995       	B0BTS1 0x95.1
  B96: 8B9A       	JMP 0x0B9A
L145:
                  	                  			{
                  	                  				/*二级电压第二级标志位打开*/
                  	                  				uStaFlag.bits.LowBat = 1 ;	
  B97: 3700       	B0MOV 0x87, #00h
  B98: 4932       	BSET 0x32.1
L148:
                  	                  			}
  B99: 8B9D       	JMP 0x0B9D
L94:
                  	                  			else
                  	                  			{
                  	                  				/*如果有一次大于2.6V*/
                  	                  				uStaFlag.bits.LowBat = 0 ;
  B9A: 3700       	B0MOV 0x87, #00h
  B9B: 4132       	BCLR 0x32.1
L153:
                  	                  				return;		
  B9C: 8BA8       	JMP 0x0BA8
L154:
                  	                  		for( i=0; i<10; i++ )	
  B9D: 3702       	B0MOV 0x87, #02h
  B9E: 16A7       	INCMS 0xA7
  B9F: 0000       	NOP
L93:
                  	                  		for( i=0; i<10; i++ )	
  BA0: 1EA7       	MOV A, 0xA7
  BA1: 240A       	SUB A, #0ah
  BA2: 7A86       	B0BTS1 0x86.2
  BA3: 8B92       	JMP 0x0B92
L160:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果二级电压第二级标志位打开*/
                  	                  		if(uStaFlag.bits.LowBat == 1)
  BA4: 3700       	B0MOV 0x87, #00h
  BA5: 5932       	BTS1 0x32.1
  BA6: 8BA8       	JMP 0x0BA8
L163:
                  	                  		{
                  	                  			/*二级电压第一级标志位关闭*/
                  	                  			uStaFlag.bits.MidBat = 0;
  BA7: 4532       	BCLR 0x32.5
L166:
                  	                  		}
                  	                  		return;
                  	                  	}
  BA8: 0E00       	RET
_Function_Drv_Led_Set_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LED.c
                  	                  	说    明：	LED驱动函数集合（中间层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	
                  	                  	//底层驱动（io is sink mode）
                  	                  	void Drv_Led_Set(void)
                  	                  	{
                  	                  		FP55M = 1;		//输出为0
  BA9: 6DC5       	B0BSET 0xC5.5
L35:
                  	                  		FP56M = 1;		//输出为0
  BAA: 6EC5       	B0BSET 0xC5.6
L36:
                  	                  		FP57M = 1;		//输出为0
  BAB: 6FC5       	B0BSET 0xC5.7
L37:
                  	                  		LED_CloseAll();
  BAC: CBAE       	CALL 0x0BAE
L38:
                  	                  	}
  BAD: 0E00       	RET
_Function_LED_CloseAll_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  		CLose LED
                  	                  	**************************************************************************/
                  	                  	void LED_CloseAll( void )
                  	                  	{
                  	                  		LED_Red_Dis();
  BAE: 6FD5       	B0BSET 0xD5.7
L46:
                  	                  		LED_Yellow_Dis();
  BAF: 6DD5       	B0BSET 0xD5.5
L52:
                  	                  		LED_Green_Dis(); 
  BB0: 6ED5       	B0BSET 0xD5.6
