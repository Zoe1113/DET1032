  CDF: 79D0       	B0BTS1 P0.1
  CE0: 8CDD       	JMP 0x0CDD
L164:
                  	                  	        }
                  	                  	        uKeyRelease.bits.TKeyRelease = 1;
  CE1: 4914       	BSET 0x14.1
L165:
                  	                  	
                  	                  			eSleepTask_Sta = Sleep_false;
  CE2: 3702       	B0MOV 0x87, #02h
  CE3: 2B4A       	CLR 0x4A
L166:
                  	                  		}
                  	                  		//EEPROM参数校验(如果校验和识别码都错则初始化数据，如果仅校验和错误则报错)
                  	                  		Parm_AutoCheck();
  CE4: C0D2       	CALL 0x00D2
L169:
                  	                  	
                  	                  		TC1Init();	//TC1设置（10ms）
  CE5: CBC1       	CALL 0x0BC1
L170:
                  	                  		T0Init();	//开启RTC中断
  CE6: CBB9       	CALL 0x0BB9
L171:
