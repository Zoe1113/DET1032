  C32: 2F8C       	B0MOV URRX1, A
L37:
                  	                  		URTX1 = 0x84 ;		//Enable UART TX, Disable UART TX parity bit function.
  C33: 2D84       	MOV A, #84h
  C34: 2F8B       	B0MOV URTX1, A
L38:
                  	                  	}
  C35: 0E00       	RET
