                  	                  	    sMemKey.g_Key_Val = 0;
  B55: 2B10       	CLR 0x10
L765:
                  	                  	    sTestKey.g_Key_Val = 0;
  B56: 2B0B       	CLR 0x0B
L766:
                  	                  	    sSetKey.g_Key_Val = 0;
  B57: 2B06       	CLR 0x06
L767:
                  	                  	    sEarcapKey.g_Key_Val = 0;
  B58: 2B01       	CLR 0x01
L768:
                  	                  	
                  	                  	    sMemKey.g_Key_Status = 0;
  B59: 2B11       	CLR 0x11
L769:
