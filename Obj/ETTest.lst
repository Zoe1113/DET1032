  47A: 1E60       	MOV A, 0x60
L612:
                  	                  				ADC A,_Hex2Bcd+1
  47B: 1060       	ADC A, 0x60
L613:
                  	                  				DAA
  47C: 0C00       	DAA
L614:
                  	                  				MOV	_Hex2Bcd+1,A
  47D: 1F60       	MOV 0x60, A
L615:
