                  	                  			/* FLBTO 1:低电压 0：正常电压 */
                  	                  			if( FLBTO )			
  B7E: 7995       	B0BTS1 0x95.1
  B7F: 8B83       	JMP 0x0B83
L118:
                  	                  			{
