                  	                  	/**************************************************************************
                  	                  	函数名称：	Ntc_Caculate()
                  	                  	函数功能：	热敏电阻ADC值计算
                  	                  	输入参数：	g_AdcDoff、g_AIN2Count、g_AIN1Count
                  	                  	输出参数：	g_NtcCount
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	NTC*2710H/分压电阻=当前NTC测量值
                  	                  	**************************************************************************/
                  	                  	void Ntc_Caculate(void)
                  	                  	{
                  	                  		g_NtcCount = (int32)(g_AIN2Count-g_AdcDoff) * 0x2710 / (g_AIN1Count -g_AIN2Count);
