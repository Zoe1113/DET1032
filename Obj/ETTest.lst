  C62: 2FD0       	B0MOV P0, A
L93:
                  	                  	 
                  	                  		//白灯输出不上拉高电平,MOSI输出不上拉高电平,MISO输入不上拉高电平,SCK输出不上拉高电平,TX输入不上拉高电平（防止向BLE供电）,RX输入不上拉,VOC_EN,BLE_LINK输入不上拉1
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0x4F;			//0b0100 1111
  C63: 2D4F       	MOV A, #4fh
  C64: 2FC1       	B0MOV P1M, A
L94:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
  C65: 2DFF       	MOV A, #ffh
  C66: 2FB5       	B0MOV P1SEG, A
L95:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0xC0;		//0b1100 0000
  C67: 2DC0       	MOV A, #c0h
  C68: 2FE1       	B0MOV P1UR, A
L96:
                  	                  		//0: low level, 1: high lDevel
                  	                  		P1 = 0xB9;			//0b1011 1001
  C69: 2DB9       	MOV A, #b9h
  C6A: 2FD1       	B0MOV P1, A
L97:
                  	                  	
                  	                  		//P25-P27为seg口，LINK脚输入 不上拉 高,EN输出 上拉 低，BUSY输入不上拉高，G320_EN输出不上拉高，VOC_EN输出不上拉低
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x0B;			//0b0000 1011
  C6B: 2D0B       	MOV A, #0bh
  C6C: 2FC2       	B0MOV P2M, A
L98:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b0001 1111,P25-P27均为LCD口
  C6D: 2D1F       	MOV A, #1fh
  C6E: 2FB2       	B0MOV P2SEG, A
L99:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x08;		//0b0000 1000
  C6F: 2D08       	MOV A, #08h
  C70: 2FDD       	B0MOV P2UR, A
L100:
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x16;			//0b0001 0110
  C71: 2D16       	MOV A, #16h
  C72: 2FD2       	B0MOV P2, A
L101:
                  	                  	
                  	                  		//C/、CF、CAL、Debug输入上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P5M = 0xE0;			//0b1110 0000
  C73: 2DE0       	MOV A, #e0h
  C74: 2FC5       	B0MOV P5M, A
L102:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P5SEG = 0xFF;		//0b1111 1111
  C75: 2DFF       	MOV A, #ffh
  C76: 2FB7       	B0MOV P5SEG, A
L103:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P5UR = 0x1E;		//0b0001 1110
  C77: 2D1E       	MOV A, #1eh
  C78: 2FD7       	B0MOV P5UR, A
L104:
                  	                  		//0: low level, 1: high level
                  	                  		P5 = 0xFE;			//0b1111 1110
  C79: 2DFE       	MOV A, #feh
  C7A: 2FD5       	B0MOV P5, A
L105:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P3M = 0x00;			//均为LCD口
  C7B: 3700       	B0MOV 0x87, #00h
  C7C: 2BC3       	CLR 0xC3
L106:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P3SEG = 0x00;		//均为LCD口
  C7D: 2BB3       	CLR 0xB3
L107:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P3UR = 0x00;		//均为LCD口
  C7E: 2BDE       	CLR 0xDE
L108:
                  	                  		//0: low level, 1: high level
                  	                  		P3 = 0x00;			//均为LCD口
  C7F: 2BD3       	CLR 0xD3
L109:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P4M = 0x00;			//均为LCD口
  C80: 2BC4       	CLR 0xC4
L110:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P4SEG = 0x00;		//均为LCD口
  C81: 2BB6       	CLR 0xB6
L111:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P4UR = 0x00;		//均为LCD口
  C82: 2BD6       	CLR 0xD6
L112:
                  	                  		//0: low level, 1: high level
                  	                  		P4 = 0x00;			//均为LCD口
  C83: 2BD4       	CLR 0xD4
L113:
                  	                  	}
  C84: 0E00       	RET
_Function_GPIO_PowerDown_code:
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	GPIO_PowerDown()
                  	                  	函数功能：	IO口初始化设置
                  	                  	输入参数：	P0、P1、P2、P3、P4、P5
                  	                  	输出参数：	P0、P1、P2、P3、P4、P5
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void GPIO_PowerDown( void )
                  	                  	{
                  	                  		//关机时仅保留唤醒按键上拉，其余非唤醒脚输出低，降低静态电流
                  	                  		//0: input mode, 1: output mode
                  	                  		P0M = 0x1C;			//0b0001 1100
  C85: 2D1C       	MOV A, #1ch
  C86: 2FC0       	B0MOV P0M, A
L119:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P0UR = 0x23;		//0b0010 0011
  C87: 2D23       	MOV A, #23h
  C88: 2FE0       	B0MOV P0UR, A
L120:
                  	                  		//0: low level, 1: high level
                  	                  		P0 = 0x2F;			//0b0010 1111
  C89: 2D2F       	MOV A, #2fh
  C8A: 2FD0       	B0MOV P0, A
L121:
                  	                  	
                  	                  	#if !Func_Ble
                  	                  		//白灯输入上拉高，按键输入上拉高电平,BZ/MOSI/MISO/TX/RX/SCK均输出不上拉低，
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0xFE;			//0b 1111 1110
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0x01;		//0b 0100 0001
                  	                  		//0: low level, 1: high level
                  	                  		P1 = 0x01;			//0b 0100 0001
                  	                  	
                  	                  		//P25-P27为seg口，BLE_Link、BLE_EN、BLE_BUSY、G320_EN输出不上拉低，VOC_EN输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x03;			//0b 0000 0011
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b 0001 1111,P25-P27均为LCD口
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x1D;		//0b 0001 1101
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x1D;			//0b 0001 1101
                  	                  	#else
                  	                  		//按键输出不上拉低,，SCK/RX1/TX1/MISO/MOSI/BZ输出不上拉低,白灯输入上拉高，
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0xFE;			//0b 1111 1110
  C8B: 2DFE       	MOV A, #feh
  C8C: 2FC1       	B0MOV P1M, A
L122:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
  C8D: 2DFF       	MOV A, #ffh
  C8E: 2FB5       	B0MOV P1SEG, A
L123:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0x01;		//0b 0000 0001
  C8F: 2D01       	MOV A, #01h
  C90: 2FE1       	B0MOV P1UR, A
L124:
                  	                  		//0: low level, 1: high level
                  	                  		P1 = 0x01;			//0b 0000 0001
  C91: 2FD1       	B0MOV P1, A
L125:
                  	                  	
                  	                  		//P25-P27为seg口，BLE_Link、BLE_EN、BLE_BUSY、G320_EN输出不上拉低，VOC_EN输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x1F;			//0b 0001 1111
  C92: 2D1F       	MOV A, #1fh
  C93: 2FC2       	B0MOV P2M, A
L126:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b 0001 1111,P25-P27均为LCD口
  C94: 2FB2       	B0MOV P2SEG, A
L127:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x01;		//0b 0000 0001
  C95: 2D01       	MOV A, #01h
  C96: 2FDD       	B0MOV P2UR, A
L128:
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x01;			//0b 0000 0001
  C97: 2FD2       	B0MOV P2, A
L129:
                  	                  	#endif
                  	                  	
                  	                  	    //RGB输入上拉高，CAL/Debug输入上拉高电平,C/F、CF输出不上拉0，MOTOR输出不上拉低
                  	                  	    //0: input mode, 1: output mode
                  	                  	    P5M = 0x07;			//0b0000 0111
  C98: 2D07       	MOV A, #07h
  C99: 2FC5       	B0MOV P5M, A
L130:
                  	                  	    //0: LCD functon pin, 1: IO pin
                  	                  	    P5SEG = 0xFF;		//0b1111 1111
  C9A: 2DFF       	MOV A, #ffh
  C9B: 2FB7       	B0MOV P5SEG, A
L131:
                  	                  	    //0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  	    P5UR = 0xF8;		//0b1111 1000
  C9C: 2DF8       	MOV A, #f8h
  C9D: 2FD7       	B0MOV P5UR, A
L132:
                  	                  	    //0: low level, 1: high level
                  	                  	    P5 = 0xF8;			//0b1111 1000
  C9E: 2FD5       	B0MOV P5, A
L133:
                  	                  	
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P3M = 0x00;			//均为LCD口
  C9F: 3700       	B0MOV 0x87, #00h
  CA0: 2BC3       	CLR 0xC3
L134:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P3SEG = 0x00;		//均为LCD口
  CA1: 2BB3       	CLR 0xB3
L135:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P3UR = 0x00;		//均为LCD口
  CA2: 2BDE       	CLR 0xDE
L136:
                  	                  		//0: low level, 1: high level
                  	                  		P3 = 0x00;			//均为LCD口
  CA3: 2BD3       	CLR 0xD3
L137:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P4M = 0x00;			//均为LCD口
  CA4: 2BC4       	CLR 0xC4
L138:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P4SEG = 0x00;		//均为LCD口
  CA5: 2BB6       	CLR 0xB6
L139:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P4UR = 0x00;		//均为LCD口
  CA6: 2BD6       	CLR 0xD6
L140:
                  	                  		//0: low level, 1: high level
                  	                  		P4 = 0x00;			//均为LCD口
  CA7: 2BD4       	CLR 0xD4
L141:
                  	                  	}
  CA8: 0E00       	RET
_Function_main_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	ETH_2988_SJ_V1.0_20200704.c
                  	                  	说    明：	耳套可选,单位焊接选择,背光可选,物温可选
                  	                  	程序编码：	详见Variable.h
                  	                  	版    本：	V1.0
                  	                  	适用 PCB:	ETH PCB(A)
                  	                  	芯	  片:	SN8P2988
                  	                  	作    者:	Liaoy
                  	                  	修订记录：
                  	                  	1、在ET215-2988-242-V1.0-20190821基础上生成ETH程序；
                  	                  	V1.0：
                  	                  	采用宏定义合并程序，版本不升级，廖彦20200704
                  	                  	V1.0:
                  	                  	传感器表格也进行宏定义，与之PGA放大倍数也必须宏定义，版本升级为V1.6，廖彦20200723
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	
                  	                  	//主程序
                  	                  	void main(void)
                  	                  	{
                  	                  		//系统时钟设定
                  	                  	  	OSCM = 0x00;		//开启内置IHRC=8M，外置低速晶振32768，Fcpu=Normal mode
  CA9: 3700       	B0MOV 0x87, #00h
  CAA: 2BCA       	CLR 0xCA
L126:
                  	                  		Delay50us(100);
  CAB: 2D64       	MOV A, #64h
  CAC: 3702       	B0MOV 0x87, #02h
  CAD: 1FA3       	MOV 0xA3, A
  CAE: C77E       	CALL 0x077E
L127:
                  	                  	
                  	                  		//部分参数设置，如年月日时分秒
                  	                  		g_Hour = 0;
  CAF: 3700       	B0MOV 0x87, #00h
  CB0: 2B78       	CLR 0x78
L128:
                  	                  		g_Minute = 0;
  CB1: 2B79       	CLR 0x79
L129:
                  	                  		g_Day = 1;
  CB2: 2D01       	MOV A, #01h
  CB3: 1F7A       	MOV 0x7A, A
L130:
                  	                  		g_Month = 1;
  CB4: 1F7B       	MOV 0x7B, A
L131:
                  	                  		g_Year = Default_Year;
  CB5: 2DE7       	MOV A, #e7h
  CB6: 1F7C       	MOV 0x7C, A
  CB7: 2D07       	MOV A, #07h
  CB8: 1F7D       	MOV 0x7D, A
L132:
                  	                  		g_Second = 0;
  CB9: 2B7E       	CLR 0x7E
L133:
                  	                  		uSetFlag.bits.TimeFormat = TimeFormat_24H;	//默认24小时制
  CBA: 417F       	BCLR 0x7F.1
L134:
                  	                  		uSetFlag.bits.Unit = Unit_C;	//默认C单位
  CBB: 407F       	BCLR 0x7F.0
L135:
                  	                  	
                  	                  		#if CF_Change_Enable == 1
                  	                  			uSetFlag.bits.Unit_Change = Unit_Change_En;	//默认单位可切换
  CBC: 427F       	BCLR 0x7F.2
L136:
                  	                  		#else
                  	                  			uSetFlag.bits.Unit_Change = Unit_Change_Dis;	//默认单位可切换
                  	                  		#endif
                  	                  	
                  	                  		uSetFlag.bits.VoiceEnable = 1;        //默认开启语音
  CBD: 4B7F       	BSET 0x7F.3
L137:
                  	                  	
                  	                  		#if Func_Ble
                  	                  			uSetFlag.bits.BleEnable = Enable;
  CBE: 4D7F       	BSET 0x7F.5
L138:
                  	                  		#endif
                  	                  		
                  	                  		GPIO_Init();//IO口设置
  CBF: CC5D       	CALL 0x0C5D
L139:
                  	                  		Lcd_Init();	//Lcd设置
  CC0: E34D       	CALL 0x234D
L140:
                  	                  		CF_Check();	//单位状态确认
  CC1: CC57       	CALL 0x0C57
L141:
                  	                  	
                  	                  		//上电是否进入设置态
                  	                  		#if Electricity_poweroff == 0
                  	                  			eMain_Task = Task_Setmode;
                  	                  		#else
                  	                  			eMain_Task = Task_Sleepmode;
  CC2: 2D08       	MOV A, #08h
  CC3: 1F33       	MOV 0x33, A
L142:
                  	                  			eSleepTask_Sta = Sleep_true;
  CC4: 2D02       	MOV A, #02h
  CC5: 3702       	B0MOV 0x87, #02h
  CC6: 1F4A       	MOV 0x4A, A
L143:
                  	                  		#endif
                  	                  	
                  	                  		eTestmode_num = Earmode;	//默认耳温模式
  CC7: 3701       	B0MOV 0x87, #01h
  CC8: 2B58       	CLR 0x58
L144:
                  	                  	    eAgemode_num = BigAge;
  CC9: 3700       	B0MOV 0x87, #00h
  CCA: 1F30       	MOV 0x30, A
L145:
                  	                  	
                  	                  		//低电压检测
                  	                  		#if Second_LVD == 1
                  	                  			LBT_Chk();
  CCB: CB6D       	CALL 0x0B6D
L146:
                  	                  		#else
                  	                  			LVD_Init();	//低电压设置
                  	                  			LVD_Chk();
                  	                  		#endif
                  	                  		if( uStaFlag.bits.LowBat )
  CCC: 5932       	BTS1 0x32.1
  CCD: 8CDE       	JMP 0x0CDE
L147:
                  	                  		{
                  	                  			Clr_Disp();
  CCE: E95B       	CALL 0x295B
L150:
                  	                  			lcd_bat_en();
  CCF: 2D01       	MOV A, #01h
  CD0: 190B       	OR 0x0B, A
L153:
                  	                  			eMain_Task = Task_InitMode;
  CD1: 3700       	B0MOV 0x87, #00h
  CD2: 2B33       	CLR 0x33
L157:
                  	                  			eInitTask_Sta = Init_Err;
  CD3: 2D06       	MOV A, #06h
  CD4: 3701       	B0MOV 0x87, #01h
  CD5: 1F59       	MOV 0x59, A
  CD6: 8CD9       	JMP 0x0CD9
L46:
                  	                  	        {
                  	                  	            WDTR = 0x5A;        // Clear WDTR Dog
  CD7: 2D5A       	MOV A, #5ah
  CD8: 2FCC       	B0MOV WDTR, A
L161:
                  	                  	        while(!Port_Test)
  CD9: 79D0       	B0BTS1 P0.1
  CDA: 8CD7       	JMP 0x0CD7
L164:
                  	                  	        }
                  	                  	        uKeyRelease.bits.TKeyRelease = 1;
  CDB: 4915       	BSET 0x15.1
L165:
                  	                  	
                  	                  			eSleepTask_Sta = Sleep_false;
  CDC: 3702       	B0MOV 0x87, #02h
  CDD: 2B4A       	CLR 0x4A
L166:
                  	                  		}
                  	                  		//EEPROM参数校验(如果校验和识别码都错则初始化数据，如果仅校验和错误则报错)
                  	                  		Parm_AutoCheck();
  CDE: C0D2       	CALL 0x00D2
L169:
                  	                  	
                  	                  		TC1Init();	//TC1设置（10ms）
  CDF: CBBB       	CALL 0x0BBB
L170:
                  	                  		T0Init();	//开启RTC中断
  CE0: CBB3       	CALL 0x0BB3
L171:
                  	                  		FGIE = 1;	//使能总中断等
  CE1: 6FDF       	B0BSET 0xDF.7
L172:
                  	                  	
                  	                  		// 关机时间重置
                  	                  		Auto_TurnOff_Time_Sel();	//关机时间选择
  CE2: E2AB       	CALL 0x22AB
L173:
                  	                  		// 初始化按键信息
                  	                  		HalKey_Set_KeyMode(Func_Long, &sTestKey);		//开机&测量键设为长按
  CE3: 2D0A       	MOV A, #0ah
  CE4: 1FA4       	MOV 0xA4, A
  CE5: 2D01       	MOV A, #01h
  CE6: 1FA5       	MOV 0xA5, A
  CE7: 2D02       	MOV A, #02h
  CE8: 1FA3       	MOV 0xA3, A
  CE9: CAC0       	CALL 0x0AC0
L174:
                  	                  		HalKey_Set_KeyMode(Func_Long, &sMemKey);			    //记忆键设为长按
  CEA: 2D0F       	MOV A, #0fh
  CEB: 1FA4       	MOV 0xA4, A
  CEC: 2D01       	MOV A, #01h
  CED: 1FA5       	MOV 0xA5, A
  CEE: 2D02       	MOV A, #02h
  CEF: 1FA3       	MOV 0xA3, A
  CF0: CAC0       	CALL 0x0AC0
L175:
                  	                  	#if Func_Probecover
                  	                  		HalKey_Set_KeyMode(Func_Short, &sEarcapKey);		    //耳套键为短按
  CF1: 2D00       	MOV A, #00h
  CF2: 1FA4       	MOV 0xA4, A
  CF3: 2D01       	MOV A, #01h
  CF4: 1FA5       	MOV 0xA5, A
  CF5: 2BA3       	CLR 0xA3
  CF6: CAC0       	CALL 0x0AC0
L176:
                  	                  	#endif
                  	                  		HalKey_Set_KeyMode(Func_Long, &sSetKey);				//设置键为长按
  CF7: 2D05       	MOV A, #05h
  CF8: 1FA4       	MOV 0xA4, A
  CF9: 2D01       	MOV A, #01h
  CFA: 1FA5       	MOV 0xA5, A
