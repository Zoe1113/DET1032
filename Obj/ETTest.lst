  C4E: 2DC1       	MOV A, #c1h
  C4F: 2FED       	B0MOV TC2CL, A
L60:
                  	                  		TC2RL = 0xC1 ;		//250us
  C50: 2FEE       	B0MOV TC2RL, A
L61:
                  	                  		TC2CH = 0xFF ;
  C51: 2DFF       	MOV A, #ffh
  C52: 2FAC       	B0MOV TC2CH, A
L62:
                  	                  		TC2RH = 0xFF ;		//250us
  C53: 2FAD       	B0MOV TC2RH, A
L63:
                  	                  		TC2DL6 = 0xE0 ;
  C54: 2DE0       	MOV A, #e0h
  C55: 370E       	B0MOV 0x87, #0Eh
  C56: 1F0A       	MOV 0x0A, A
L64:
                  	                  		TC2DH6 = 0xFF ;		//125us（1/2 duty)
  C57: 2DFF       	MOV A, #ffh
  C58: 1F0B       	MOV 0x0B, A
L65:
                  	                  	}
  C59: 0E00       	RET
_Function_Drv_UartTX_Init_code:
                  	                  	/**************************************************************************
