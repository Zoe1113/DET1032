  C7B: 728B       	B0BTS0 URTX1.2
  C7C: 8C7B       	JMP 0x0C7B
L99:
                  	                  		if(FUTX1BZ==0)
  C7D: 728B       	B0BTS0 URTX1.2
  C7E: 8C82       	JMP 0x0C82
L100:
                  	                  			UTX1D = part ;
  C7F: 3702       	B0MOV 0x87, #02h
  C80: 1EA4       	MOV A, 0xA4
  C81: 2F8E       	B0MOV UTX1D, A
L74:
                  	                  			NOP(5);
  C82: 0000       	NOP
  C83: 0000       	NOP
  C84: 0000       	NOP
  C85: 0000       	NOP
  C86: 0000       	NOP
L102:
                  	                  		while(FUTX1BZ);
  C87: 728B       	B0BTS0 URTX1.2
  C88: 8C87       	JMP 0x0C87
L105:
                  	                  		if(FUTX1BZ==0)
  C89: 728B       	B0BTS0 URTX1.2
  C8A: 8C90       	JMP 0x0C90
L106:
                  	                  			UTX1D = data >> 8 ;
  C8B: 2D00       	MOV A, #00h
  C8C: 2F19       	B0MOV 0x19, A
  C8D: 3702       	B0MOV 0x87, #02h
  C8E: 1EA6       	MOV A, 0xA6
  C8F: 2F8E       	B0MOV UTX1D, A
L79:
                  	                  			NOP(5);
  C90: 0000       	NOP
  C91: 0000       	NOP
  C92: 0000       	NOP
  C93: 0000       	NOP
  C94: 0000       	NOP
L108:
                  	                  		while(FUTX1BZ);
  C95: 728B       	B0BTS0 URTX1.2
  C96: 8C95       	JMP 0x0C95
L111:
                  	                  		if(FUTX1BZ==0)
  C97: 728B       	B0BTS0 URTX1.2
  C98: 8C9C       	JMP 0x0C9C
L112:
                  	                  			UTX1D = data ;
  C99: 3702       	B0MOV 0x87, #02h
  C9A: 1EA5       	MOV A, 0xA5
  C9B: 2F8E       	B0MOV UTX1D, A
L84:
                  	                  			NOP(5);
  C9C: 0000       	NOP
  C9D: 0000       	NOP
  C9E: 0000       	NOP
  C9F: 0000       	NOP
  CA0: 0000       	NOP
L114:
                  	                  		while(FUTX1BZ);
  CA1: 728B       	B0BTS0 URTX1.2
  CA2: 8CA1       	JMP 0x0CA1
L117:
                  	                  	}
  CA3: 0E00       	RET
_Function_Uart_Send_Wakeup_code:
                  	                  	void Uart_Send_Wakeup(void)
                  	                  	{
                  	                  		char Count = 0;
  CA4: 2BA4       	CLR 0xA4
L120:
                  	                  		while(FUTX1BZ);
  CA5: 728B       	B0BTS0 0x8B.2
  CA6: 8CA5       	JMP 0x0CA5
L137:
                  	                  		for(Count=0;Count<10;Count++)
  CA7: 2BA4       	CLR 0xA4
L123:
                  	                  		{
                  	                  			if(FUTX1BZ==0)
  CA8: 728B       	B0BTS0 0x8B.2
  CA9: 8CAC       	JMP 0x0CAC
L142:
                  	                  				UTX1D = 0xFF ;
  CAA: 2DFF       	MOV A, #ffh
  CAB: 2F8E       	B0MOV UTX1D, A
L127:
                  	                  			NOP(5);
  CAC: 0000       	NOP
  CAD: 0000       	NOP
  CAE: 0000       	NOP
  CAF: 0000       	NOP
  CB0: 0000       	NOP
L144:
                  	                  			while(FUTX1BZ);
  CB1: 728B       	B0BTS0 URTX1.2
  CB2: 8CB1       	JMP 0x0CB1
L147:
                  	                  		for(Count=0;Count<10;Count++)
  CB3: 16A4       	INCMS 0xA4
  CB4: 0000       	NOP
L150:
                  	                  		for(Count=0;Count<10;Count++)
  CB5: 1EA4       	MOV A, 0xA4
  CB6: 1D80       	XOR A, #80h
  CB7: 248A       	SUB A, #8ah
  CB8: 7A86       	B0BTS1 0x86.2
  CB9: 8CA8       	JMP 0x0CA8
L151:
                  	                  		}
                  	                  	}
  CBA: 0E00       	RET
_Function_Cal_Inspect_Detect_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_GPIO.c
                  	                  	说    明：	GPIO初始化函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	Cal_Inspect_Detect()
                  	                  	函数功能：	校准模式、绑定模式入口检测
                  	                  	输入参数：	Port_Debug、Port_Cal
                  	                  	输出参数：	uSetFlag
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Cal_Inspect_Detect(void)
                  	                  	{
                  	                  		//绑定检测模式、校温检测模式、系数调整模式判断
                  	                  		if( !Port_Debug && Port_Cal )
  CBB: 74D5       	B0BTS0 0xD5.4
  CBC: 8CCD       	JMP 0x0CCD
  CBD: 7BD5       	B0BTS1 0xD5.3
  CBE: 8CCD       	JMP 0x0CCD
L41:
                  	                  		{
                  	                  			if ( eTestmode_num == Insptectmode )
  CBF: 3701       	B0MOV 0x87, #01h
  CC0: 1E66       	MOV A, 0x66
  CC1: 0604       	CMPRS A, #04h
  CC2: 8CC8       	JMP 0x0CC8
L44:
                  	                  			{
                  	                  				 #if ParamModif
                  	                  				LED_CloseAll();
  CC3: CC31       	CALL 0x0C31
L47:
                  	                  				eMain_Task = Task_ParamModifymode;	//生产模式短路debug口则进入系数调整模式
  CC4: 2D07       	MOV A, #07h
  CC5: 3700       	B0MOV 0x87, #00h
  CC6: 1F33       	MOV 0x33, A
L48:
                  	                  	            #endif
                  	                  	        }
  CC7: 8CCD       	JMP 0x0CCD
L34:
                  	                  			else
                  	                  			{
                  	                  				eSetTask = Set_Unit;		//设置态恢复状态
  CC8: 2B6A       	CLR 0x6A
L53:
                  	                  				F_FirstEnter_SetMode = 0;
  CC9: 3700       	B0MOV 0x87, #00h
  CCA: 4220       	BCLR 0x20.2
L54:
                  	                  				eMain_Task = Task_BondTestmode;	//用户模式下短路debug进入绑定检测模式
  CCB: 2D06       	MOV A, #06h
  CCC: 1F33       	MOV 0x33, A
L55:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		//设置态决不允许进入校温，汇编和C的程序结构不一样，未初始化adc
                  	                  		if( !Port_Cal && !Port_Debug && eMain_Task == Task_ReadyMode )
  CCD: 73D5       	B0BTS0 0xD5.3
  CCE: 8CD8       	JMP 0x0CD8
  CCF: 74D5       	B0BTS0 0xD5.4
  CD0: 8CD8       	JMP 0x0CD8
  CD1: 3700       	B0MOV 0x87, #00h
  CD2: 2533       	DECS 0x33
  CD3: 8CD8       	JMP 0x0CD8
L60:
                  	                  		{
                  	                  	        #if Func_Ble
                  	                  	            F_Ble_En = Disable;         //进入校准关闭蓝牙
  CD4: 4348       	BCLR 0x48.3
L63:
                  	                  	            Port_Ble_En = 0;            //蓝牙失能
  CD5: 63D2       	B0BCLR 0xD2.3
L64:
                  	                  	        #endif
                  	                  			eMain_Task = Task_Calimode;		//用户模式下短路debug和cal进入校温模式
  CD6: 2D05       	MOV A, #05h
  CD7: 1F33       	MOV 0x33, A
L65:
                  	                  		}
                  	                  	}
  CD8: 0E00       	RET
_Function_CF_Check_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	CF_Check()
                  	                  	函数功能：	单位状态、单位可切换状态查询
                  	                  	输入参数：	Port_CF、Port_Change_CF
                  	                  	输出参数：	uSetFlag
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void CF_Check(void)
                  	                  	{
                  	                  		//单位状态检测
                  	                  		uSetFlag.bits.Unit = Unit_C;
  CD9: 3700       	B0MOV 0x87, #00h
  CDA: 407F       	BCLR 0x7F.0
L79:
                  	                  		if( !Port_CF )
  CDB: 72D5       	B0BTS0 0xD5.2
  CDC: 8CDE       	JMP 0x0CDE
L80:
                  	                  		{
                  	                  			uSetFlag.bits.Unit = Unit_F;
  CDD: 487F       	BSET 0x7F.0
L83:
                  	                  		}
                  	                  	
                  	                  	}
  CDE: 0E00       	RET
_Function_GPIO_Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	GPIO_Init()
                  	                  	函数功能：	IO口初始化设置
                  	                  	输入参数：	P0、P1、P2、P3、P4、P5
                  	                  	输出参数：	P0、P1、P2、P3、P4、P5
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void GPIO_Init(void)
                  	                  	{
                  	                  		//SDA/SCL输出为0(因为采用的是硬体I2C),按键输入上拉高电平,XIN/XOUT输入不上拉0
                  	                  		//0: input mode, 1: output mode
                  	                  		P0M = 0x0C;			//0b 0000 1100
  CDF: 2D0C       	MOV A, #0ch
  CE0: 2FC0       	B0MOV P0M, A
L91:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P0UR = 0x13;		//0b 0001 0011
  CE1: 2D13       	MOV A, #13h
  CE2: 2FE0       	B0MOV P0UR, A
L92:
                  	                  		//0: low level, 1: high level
                  	                  		P0 = 0x1F;			//0b 0001 1111
  CE3: 2D1F       	MOV A, #1fh
  CE4: 2FD0       	B0MOV P0, A
L93:
                  	                  	 
                  	                  		//白灯输出不上拉高电平,MOSI输出不上拉高电平,MISO输入不上拉高电平,SCK输出不上拉高电平,TX输入不上拉高电平（防止向BLE供电）,RX输入不上拉,VOC_EN,BLE_LINK输入不上拉1
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0x4F;			//0b0100 1111
  CE5: 2D4F       	MOV A, #4fh
  CE6: 2FC1       	B0MOV P1M, A
L94:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
  CE7: 2DFF       	MOV A, #ffh
  CE8: 2FB5       	B0MOV P1SEG, A
L95:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0xC0;		//0b1100 0000
  CE9: 2DC0       	MOV A, #c0h
  CEA: 2FE1       	B0MOV P1UR, A
L96:
                  	                  		//0: low level, 1: high lDevel
                  	                  		P1 = 0xB9;			//0b1011 1001
  CEB: 2DB9       	MOV A, #b9h
  CEC: 2FD1       	B0MOV P1, A
L97:
                  	                  	
                  	                  		//P25-P27为seg口，LINK脚输入 不上拉 高,EN输出 上拉 低，BUSY输入不上拉高，G320_EN输出不上拉高，VOC_EN输出不上拉低
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x0B;			//0b0000 1011
  CED: 2D0B       	MOV A, #0bh
  CEE: 2FC2       	B0MOV P2M, A
L98:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b0001 1111,P25-P27均为LCD口
  CEF: 2D1F       	MOV A, #1fh
  CF0: 2FB2       	B0MOV P2SEG, A
L99:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x08;		//0b0000 1000
  CF1: 2D08       	MOV A, #08h
  CF2: 2FDD       	B0MOV P2UR, A
L100:
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x16;			//0b0001 0110
  CF3: 2D16       	MOV A, #16h
  CF4: 2FD2       	B0MOV P2, A
L101:
                  	                  	
                  	                  		//C/、CF、CAL、Debug输入上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P5M = 0xE0;			//0b1110 0000
  CF5: 2DE0       	MOV A, #e0h
  CF6: 2FC5       	B0MOV P5M, A
L102:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P5SEG = 0xFF;		//0b1111 1111
  CF7: 2DFF       	MOV A, #ffh
  CF8: 2FB7       	B0MOV P5SEG, A
L103:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P5UR = 0x1E;		//0b0001 1110
  CF9: 2D1E       	MOV A, #1eh
  CFA: 2FD7       	B0MOV P5UR, A
L104:
                  	                  		//0: low level, 1: high level
                  	                  		P5 = 0xFE;			//0b1111 1110
  CFB: 2DFE       	MOV A, #feh
  CFC: 2FD5       	B0MOV P5, A
L105:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P3M = 0x00;			//均为LCD口
  CFD: 3700       	B0MOV 0x87, #00h
  CFE: 2BC3       	CLR 0xC3
L106:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P3SEG = 0x00;		//均为LCD口
  CFF: 2BB3       	CLR 0xB3
L107:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P3UR = 0x00;		//均为LCD口
  D00: 2BDE       	CLR 0xDE
L108:
                  	                  		//0: low level, 1: high level
                  	                  		P3 = 0x00;			//均为LCD口
  D01: 2BD3       	CLR 0xD3
L109:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P4M = 0x00;			//均为LCD口
  D02: 2BC4       	CLR 0xC4
L110:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P4SEG = 0x00;		//均为LCD口
  D03: 2BB6       	CLR 0xB6
L111:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P4UR = 0x00;		//均为LCD口
  D04: 2BD6       	CLR 0xD6
L112:
                  	                  		//0: low level, 1: high level
                  	                  		P4 = 0x00;			//均为LCD口
  D05: 2BD4       	CLR 0xD4
L113:
                  	                  	}
  D06: 0E00       	RET
_Function_GPIO_PowerDown_code:
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	GPIO_PowerDown()
                  	                  	函数功能：	IO口初始化设置
                  	                  	输入参数：	P0、P1、P2、P3、P4、P5
                  	                  	输出参数：	P0、P1、P2、P3、P4、P5
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void GPIO_PowerDown( void )
                  	                  	{
                  	                  		//按键输入上拉高电平,XIN/XOUT输入不上拉0,E2供电口输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P0M = 0x2C;			//0b0010 1100
  D07: 2D2C       	MOV A, #2ch
  D08: 2FC0       	B0MOV P0M, A
L119:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P0UR = 0x13;		//0b0001 0011
  D09: 2D13       	MOV A, #13h
  D0A: 2FE0       	B0MOV P0UR, A
L120:
                  	                  		//0: low level, 1: high level
                  	                  		P0 = 0x1F;			//0b0001 1111
  D0B: 2D1F       	MOV A, #1fh
  D0C: 2FD0       	B0MOV P0, A
L121:
                  	                  	
                  	                  		//BZ不上拉输出0,TX输出不上拉低电平,RX为I2C供电口不上拉输出0,其余未使用输入上拉高
                  	                  	
                  	                  	#if !Func_Ble
                  	                  		//白灯输入上拉高，按键输入上拉高电平,BZ/MOSI/MISO/TX/RX/SCK均输出不上拉低，
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0xFE;			//0b 1111 1110
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0x01;		//0b 0100 0001
                  	                  		//0: low level, 1: high level
                  	                  		P1 = 0x01;			//0b 0100 0001
                  	                  	
                  	                  		//P25-P27为seg口，BLE_Link、BLE_EN、BLE_BUSY、G320_EN输出不上拉低，VOC_EN输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x03;			//0b 0000 0011
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b 0001 1111,P25-P27均为LCD口
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x1D;		//0b 0001 1101
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x1D;			//0b 0001 1101
                  	                  	#else
                  	                  		//按键输出不上拉低,，SCK/RX1/TX1/MISO/MOSI/BZ输出不上拉低,白灯输入上拉高，
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0xFE;			//0b 1111 1110
  D0D: 2DFE       	MOV A, #feh
  D0E: 2FC1       	B0MOV P1M, A
L122:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
  D0F: 2DFF       	MOV A, #ffh
  D10: 2FB5       	B0MOV P1SEG, A
L123:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0x01;		//0b 0000 0001
  D11: 2D01       	MOV A, #01h
  D12: 2FE1       	B0MOV P1UR, A
L124:
                  	                  		//0: low level, 1: high level
                  	                  		P1 = 0x01;			//0b 0000 0001
  D13: 2FD1       	B0MOV P1, A
L125:
                  	                  	
                  	                  		//P25-P27为seg口，BLE_Link、BLE_EN、BLE_BUSY、G320_EN输出不上拉低，VOC_EN输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x1F;			//0b 0001 1111
  D14: 2D1F       	MOV A, #1fh
  D15: 2FC2       	B0MOV P2M, A
L126:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b 0001 1111,P25-P27均为LCD口
  D16: 2FB2       	B0MOV P2SEG, A
L127:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x01;		//0b 0000 0001
  D17: 2D01       	MOV A, #01h
  D18: 2FDD       	B0MOV P2UR, A
L128:
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x01;			//0b 0000 0001
  D19: 2FD2       	B0MOV P2, A
L129:
                  	                  	#endif
                  	                  	
                  	                  		//RGB输入上拉高，CAL/Debug输入上拉高电平,C/F、CF输出不上拉0，MOTOR输出不上拉低
                  	                  	    //0: input mode, 1: output mode
                  	                  	    P5M = 0x07;			//0b0000 0111
  D1A: 2D07       	MOV A, #07h
  D1B: 2FC5       	B0MOV P5M, A
L130:
                  	                  	    //0: LCD functon pin, 1: IO pin
                  	                  	    P5SEG = 0xFF;		//0b1111 1111
  D1C: 2DFF       	MOV A, #ffh
  D1D: 2FB7       	B0MOV P5SEG, A
L131:
                  	                  	    //0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  	    P5UR = 0xF8;		//0b1111 1000
  D1E: 2DF8       	MOV A, #f8h
  D1F: 2FD7       	B0MOV P5UR, A
L132:
                  	                  	    //0: low level, 1: high level
                  	                  	    P5 = 0xF8;			//0b1111 1000
  D20: 2FD5       	B0MOV P5, A
L133:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P3M = 0x00;			//均为LCD口
  D21: 3700       	B0MOV 0x87, #00h
  D22: 2BC3       	CLR 0xC3
L134:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P3SEG = 0x00;		//均为LCD口
  D23: 2BB3       	CLR 0xB3
L135:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P3UR = 0x00;		//均为LCD口
  D24: 2BDE       	CLR 0xDE
L136:
                  	                  		//0: low level, 1: high level
                  	                  		P3 = 0x00;			//均为LCD口
  D25: 2BD3       	CLR 0xD3
