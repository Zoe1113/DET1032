                  	                  	        else if(uStaFlag.bits.LowBat != 1 && uStaFlag.bits.MidBat == 1)
  491: 5132       	BTS0 0x32.1
  492: 849B       	JMP 0x049B
  493: 5D32       	BTS1 0x32.5
  494: 849B       	JMP 0x049B
L657:
                  	                  	        {
                  	                  	            lcd_bat_en();
  495: 2D01       	MOV A, #01h
  496: 370F       	B0MOV 0x87, #0Fh
  497: 190B       	OR 0x0B, A
L662:
                  	                  	            lcd_bat_lack_en();
  498: 290B       	AND 0x0B, A
L668:
                  	                  	            lcd_bat_lack_en();
  499: 2D04       	MOV A, #04h
  49A: 190B       	OR 0x0B, A
L669:
                  	                  	        }
                  	                  	    #endif
                  	                  	}
  49B: 0E00       	RET
