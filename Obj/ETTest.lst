L153:
                  	                  			eMain_Task = Task_InitMode;
  CDB: 3700       	B0MOV 0x87, #00h
  CDC: 2B36       	CLR 0x36
L157:
                  	                  			eInitTask_Sta = Init_Err;
  CDD: 2D06       	MOV A, #06h
  CDE: 3701       	B0MOV 0x87, #01h
  CDF: 1F68       	MOV 0x68, A
  CE0: 8CE3       	JMP 0x0CE3
L46:
                  	                  	        {
                  	                  	            WDTR = 0x5A;        // Clear WDTR Dog
  CE1: 2D5A       	MOV A, #5ah
  CE2: 2FCC       	B0MOV WDTR, A
L161:
                  	                  	        while(!Port_Test)
  CE3: 79D0       	B0BTS1 P0.1
  CE4: 8CE1       	JMP 0x0CE1
L164:
                  	                  	        }
                  	                  	        uKeyRelease.bits.TKeyRelease = 1;
  CE5: 4914       	BSET 0x14.1
L165:
                  	                  	
                  	                  			eSleepTask_Sta = Sleep_false;
  CE6: 3702       	B0MOV 0x87, #02h
  CE7: 2B4A       	CLR 0x4A
L166:
                  	                  		}
                  	                  		//EEPROM参数校验(如果校验和识别码都错则初始化数据，如果仅校验和错误则报错)
                  	                  		Parm_AutoCheck();
  CE8: C0D2       	CALL 0x00D2
L169:
                  	                  	
                  	                  		TC1Init();	//TC1设置（10ms）
  CE9: CBC5       	CALL 0x0BC5
L170:
                  	                  		T0Init();	//开启RTC中断
  CEA: CBBD       	CALL 0x0BBD
L171:
                  	                  		FGIE = 1;	//使能总中断等
  CEB: 6FDF       	B0BSET 0xDF.7
L172:
                  	                  	
                  	                  		// 关机时间重置
                  	                  		Auto_TurnOff_Time_Sel();	//关机时间选择
  CEC: E2AF       	CALL 0x22AF
L173:
                  	                  		// 初始化按键信息
                  	                  		HalKey_Set_KeyMode(Func_Long, &sTestKey);		//开机&测量键设为长按
  CED: 2D0A       	MOV A, #0ah
