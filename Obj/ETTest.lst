                  	                  				else if( CHS == ACM_ACM )
                  	                  					Uart_Transmit(0xEE, g_AdcData);
                  	                  				else
                  	                  					Uart_Transmit(0xBB, g_AdcData);
                  	                  			#endif
                  	                  	
                  	                  			return 1 ;
  640: 2D01       	MOV A, #01h
