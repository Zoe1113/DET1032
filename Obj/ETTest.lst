                  	                  										SB+SC,						//1		1
                  	                  										SA+SB+SD+SE+SG,				//2		2
                  	                  										SA+SB+SC+SD+SG,				//3		3
                  	                  										SB+SC+SF+SG,				//4		4
                  	                  										SA+SC+SD+SF+SG,				//5		5
                  	                  										SA+SC+SD+SE+SF+SG,			//6		6
                  	                  										SA+SB+SC,					//7		7
                  	                  										SA+SB+SC+SD+SE+SF+SG,		//8		8
                  	                  										SA+SB+SC+SD+SF+SG,			//9		9
                  	                  									} ;
                  	                  	
