L37:
                  	                  		FT0IEN = 0;
  C3C: 60C7       	B0BCLR 0xC7.0
L38:
                  	                  		FT0IRQ = 0;			//停止T0计时/中断/中断请求位
  C3D: 60C6       	B0BCLR 0xC6.0
