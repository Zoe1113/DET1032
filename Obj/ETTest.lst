  2CA: F8BB       	CALL 0x38BB
  2CB: 2E1A       	B0MOV A, 0x1A
  2CC: 1819       	OR A, 0x19
  2CD: 7886       	B0BTS1 0x86.0
  2CE: 82D1       	JMP 0x02D1
L391:
                  	                  				return 1;
  2CF: 2D01       	MOV A, #01h
  2D0: 82E2       	JMP 0x02E2
L380:
                  	                  			else
                  	                  				return 0;
  2D1: 2D00       	MOV A, #00h
  2D2: 82E2       	JMP 0x02E2
L393:
                  	                  		}
                  	                  		else
                  	                  		{
                  	                  			if( (L_Buf & 0x0003) == 0)
  2D3: 3100       	B0MOV 0x81, #00h
  2D4: 3019       	B0MOV 0x80, #19h
  2D5: 3402       	B0MOV 0x84, #02h
  2D6: 33A8       	B0MOV 0x83, #A8h
