  C41: 3701       	B0MOV 0x87, #01h
  C42: 1E58       	MOV A, 0x58
  C43: 0604       	CMPRS A, #04h
  C44: 8C4A       	JMP 0x0C4A
L44:
                  	                  			{
                  	                  				 #if ParamModif
                  	                  				LED_CloseAll();
  C45: CBB2       	CALL 0x0BB2
L47:
                  	                  				eMain_Task = Task_ParamModifymode;	//生产模式短路debug口则进入系数调整模式
  C46: 2D07       	MOV A, #07h
  C47: 3700       	B0MOV 0x87, #00h
  C48: 1F33       	MOV 0x33, A
L48:
                  	                  	            #endif
                  	                  	        }
  C49: 8C51       	JMP 0x0C51
L34:
                  	                  			else
                  	                  			{
