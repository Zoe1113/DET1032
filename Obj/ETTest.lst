_Function_LVD_Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LVD.c
                  	                  	说    明：	低电压处理函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Init(void)
                  	                  	函数功能：	low voltage初始化设置
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LVD_Init(void)
                  	                  	{
                  	                  		//internal lvd
                  	                  		LBTM = 0x10 ;		//低电压<2.6V，内部电压检测
  BA6: 2D10       	MOV A, #10h
  BA7: 2F95       	B0MOV LBTM, A
L35:
                  	                  		Delay50us(1) ;
  BA8: 2D01       	MOV A, #01h
  BA9: 3702       	B0MOV 0x87, #02h
  BAA: 1FA3       	MOV 0xA3, A
  BAB: C77E       	CALL 0x077E
L36:
                  	                  		FLBTEN = 1 ;		//enable low-voltage detect
  BAC: 6895       	B0BSET 0x95.0
L37:
                  	                  	}
  BAD: 0E00       	RET
_Function_LVD_Chk_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Chk(void)
                  	                  	函数功能：	low voltage检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	100ms（Fcup=2M）
                  	                  	**************************************************************************/
                  	                  	void LVD_Chk(void)
                  	                  	{
                  	                  		uint8 i ;		//count with low-voltage
                  	                  	
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  BAE: 3702       	B0MOV 0x87, #02h
  BAF: 2BA7       	CLR 0xA7
  BB0: 8BBF       	JMP 0x0BBF
L40:
                  	                  		{
                  	                  			Delay10ms(1) ;		//延迟10ms稳定
  BB1: 2D01       	MOV A, #01h
  BB2: 1FA3       	MOV 0xA3, A
  BB3: C7A3       	CALL 0x07A3
L57:
                  	                  			if( FLBTO )			//FLBTO 1:低电压 0：正常电压
  BB4: 7995       	B0BTS1 0x95.1
  BB5: 8BB9       	JMP 0x0BB9
L58:
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 1 ;
  BB6: 3700       	B0MOV 0x87, #00h
  BB7: 4935       	BSET 0x35.1
L61:
                  	                  			}
  BB8: 8BBC       	JMP 0x0BBC
L44:
                  	                  			else
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 0 ;
  BB9: 3700       	B0MOV 0x87, #00h
  BBA: 4135       	BCLR 0x35.1
L66:
                  	                  				break;
  BBB: 8BC3       	JMP 0x0BC3
L67:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  BBC: 3702       	B0MOV 0x87, #02h
  BBD: 16A7       	INCMS 0xA7
  BBE: 0000       	NOP
L43:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  BBF: 1EA7       	MOV A, 0xA7
  BC0: 240A       	SUB A, #0ah
  BC1: 7A86       	B0BTS1 0x86.2
  BC2: 8BB1       	JMP 0x0BB1
L42:
                  	                  			}
                  	                  		}
                  	                  	}
  BC3: 0E00       	RET
