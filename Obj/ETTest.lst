                  	                  	}
  C66: 0E00       	RET
_Function_GPIO_Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	GPIO_Init()
                  	                  	函数功能：	IO口初始化设置
                  	                  	输入参数：	P0、P1、P2、P3、P4、P5
                  	                  	输出参数：	P0、P1、P2、P3、P4、P5
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void GPIO_Init(void)
                  	                  	{
                  	                  		//SDA/SCL输出为0(因为采用的是硬体I2C),按键输入上拉高电平,XIN/XOUT输入不上拉0
                  	                  		//0: input mode, 1: output mode
                  	                  		P0M = 0x0C;			//0b 0000 1100
  C67: 2D0C       	MOV A, #0ch
  C68: 2FC0       	B0MOV P0M, A
L91:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P0UR = 0x13;		//0b 0001 0011
  C69: 2D13       	MOV A, #13h
  C6A: 2FE0       	B0MOV P0UR, A
L92:
                  	                  		//0: low level, 1: high level
                  	                  		P0 = 0x1F;			//0b 0001 1111
  C6B: 2D1F       	MOV A, #1fh
  C6C: 2FD0       	B0MOV P0, A
L93:
                  	                  	 
                  	                  		//白灯输出不上拉高电平,MOSI输出不上拉高电平,MISO输入不上拉高电平,SCK输出不上拉高电平,TX输入不上拉高电平（防止向BLE供电）,RX输入不上拉,VOC_EN,BLE_LINK输入不上拉1
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0x4F;			//0b0100 1111
  C6D: 2D4F       	MOV A, #4fh
  C6E: 2FC1       	B0MOV P1M, A
L94:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
  C6F: 2DFF       	MOV A, #ffh
  C70: 2FB5       	B0MOV P1SEG, A
L95:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0xC0;		//0b1100 0000
  C71: 2DC0       	MOV A, #c0h
  C72: 2FE1       	B0MOV P1UR, A
L96:
                  	                  		//0: low level, 1: high lDevel
                  	                  		P1 = 0xB9;			//0b1011 1001
  C73: 2DB9       	MOV A, #b9h
  C74: 2FD1       	B0MOV P1, A
L97:
                  	                  	
                  	                  		//P25-P27为seg口，LINK脚输入 不上拉 高,EN输出 上拉 低，BUSY输入不上拉高，G320_EN输出不上拉高，VOC_EN输出不上拉低
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x0B;			//0b0000 1011
  C75: 2D0B       	MOV A, #0bh
  C76: 2FC2       	B0MOV P2M, A
L98:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b0001 1111,P25-P27均为LCD口
  C77: 2D1F       	MOV A, #1fh
  C78: 2FB2       	B0MOV P2SEG, A
L99:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x08;		//0b0000 1000
  C79: 2D08       	MOV A, #08h
  C7A: 2FDD       	B0MOV P2UR, A
L100:
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x16;			//0b0001 0110
  C7B: 2D16       	MOV A, #16h
  C7C: 2FD2       	B0MOV P2, A
L101:
                  	                  	
                  	                  		//C/、CF、CAL、Debug输入上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P5M = 0xE0;			//0b1110 0000
  C7D: 2DE0       	MOV A, #e0h
  C7E: 2FC5       	B0MOV P5M, A
L102:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P5SEG = 0xFF;		//0b1111 1111
  C7F: 2DFF       	MOV A, #ffh
  C80: 2FB7       	B0MOV P5SEG, A
L103:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P5UR = 0x1E;		//0b0001 1110
  C81: 2D1E       	MOV A, #1eh
  C82: 2FD7       	B0MOV P5UR, A
L104:
                  	                  		//0: low level, 1: high level
                  	                  		P5 = 0xFE;			//0b1111 1110
  C83: 2DFE       	MOV A, #feh
  C84: 2FD5       	B0MOV P5, A
L105:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P3M = 0x00;			//均为LCD口
  C85: 3700       	B0MOV 0x87, #00h
  C86: 2BC3       	CLR 0xC3
L106:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P3SEG = 0x00;		//均为LCD口
  C87: 2BB3       	CLR 0xB3
L107:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P3UR = 0x00;		//均为LCD口
  C88: 2BDE       	CLR 0xDE
L108:
                  	                  		//0: low level, 1: high level
                  	                  		P3 = 0x00;			//均为LCD口
  C89: 2BD3       	CLR 0xD3
L109:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P4M = 0x00;			//均为LCD口
  C8A: 2BC4       	CLR 0xC4
L110:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P4SEG = 0x00;		//均为LCD口
  C8B: 2BB6       	CLR 0xB6
L111:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P4UR = 0x00;		//均为LCD口
  C8C: 2BD6       	CLR 0xD6
L112:
                  	                  		//0: low level, 1: high level
                  	                  		P4 = 0x00;			//均为LCD口
  C8D: 2BD4       	CLR 0xD4
L113:
                  	                  	}
  C8E: 0E00       	RET
_Function_GPIO_PowerDown_code:
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	GPIO_PowerDown()
                  	                  	函数功能：	IO口初始化设置
                  	                  	输入参数：	P0、P1、P2、P3、P4、P5
                  	                  	输出参数：	P0、P1、P2、P3、P4、P5
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void GPIO_PowerDown( void )
                  	                  	{
                  	                  		//关机时仅保留唤醒按键上拉，其余非唤醒脚输出低，降低静态电流
                  	                  		//0: input mode, 1: output mode
                  	                  		P0M = 0x1C;			//0b0001 1100
  C8F: 2D1C       	MOV A, #1ch
  C90: 2FC0       	B0MOV P0M, A
L119:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P0UR = 0x23;		//0b0010 0011
  C91: 2D23       	MOV A, #23h
  C92: 2FE0       	B0MOV P0UR, A
L120:
                  	                  		//0: low level, 1: high level
                  	                  		P0 = 0x2F;			//0b0010 1111
  C93: 2D2F       	MOV A, #2fh
  C94: 2FD0       	B0MOV P0, A
L121:
                  	                  	
                  	                  	#if !Func_Ble
                  	                  		//白灯输入上拉高，按键输入上拉高电平,BZ/MOSI/MISO/TX/RX/SCK均输出不上拉低，
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0xFE;			//0b 1111 1110
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0x01;		//0b 0100 0001
                  	                  		//0: low level, 1: high level
                  	                  		P1 = 0x01;			//0b 0100 0001
                  	                  	
                  	                  		//P25-P27为seg口，BLE_Link、BLE_EN、BLE_BUSY、G320_EN输出不上拉低，VOC_EN输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x03;			//0b 0000 0011
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b 0001 1111,P25-P27均为LCD口
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x1D;		//0b 0001 1101
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x1D;			//0b 0001 1101
                  	                  	#else
                  	                  		//按键输出不上拉低,，SCK/RX1/TX1/MISO/MOSI/BZ输出不上拉低,白灯输入上拉高，
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0xFE;			//0b 1111 1110
  C95: 2DFE       	MOV A, #feh
  C96: 2FC1       	B0MOV P1M, A
L122:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
  C97: 2DFF       	MOV A, #ffh
  C98: 2FB5       	B0MOV P1SEG, A
L123:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0x01;		//0b 0000 0001
  C99: 2D01       	MOV A, #01h
  C9A: 2FE1       	B0MOV P1UR, A
L124:
                  	                  		//0: low level, 1: high level
                  	                  		P1 = 0x01;			//0b 0000 0001
  C9B: 2FD1       	B0MOV P1, A
L125:
                  	                  	
                  	                  		//P25-P27为seg口，BLE_Link、BLE_EN、BLE_BUSY、G320_EN输出不上拉低，VOC_EN输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x1F;			//0b 0001 1111
  C9C: 2D1F       	MOV A, #1fh
  C9D: 2FC2       	B0MOV P2M, A
L126:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b 0001 1111,P25-P27均为LCD口
  C9E: 2FB2       	B0MOV P2SEG, A
L127:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x01;		//0b 0000 0001
  C9F: 2D01       	MOV A, #01h
  CA0: 2FDD       	B0MOV P2UR, A
L128:
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x01;			//0b 0000 0001
  CA1: 2FD2       	B0MOV P2, A
L129:
                  	                  	#endif
                  	                  	
                  	                  	    //RGB输入上拉高，CAL/Debug输入上拉高电平,C/F、CF输出不上拉0，MOTOR输出不上拉低
                  	                  	    //0: input mode, 1: output mode
                  	                  	    P5M = 0x07;			//0b0000 0111
  CA2: 2D07       	MOV A, #07h
  CA3: 2FC5       	B0MOV P5M, A
L130:
                  	                  	    //0: LCD functon pin, 1: IO pin
                  	                  	    P5SEG = 0xFF;		//0b1111 1111
  CA4: 2DFF       	MOV A, #ffh
  CA5: 2FB7       	B0MOV P5SEG, A
L131:
                  	                  	    //0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  	    P5UR = 0xF8;		//0b1111 1000
  CA6: 2DF8       	MOV A, #f8h
  CA7: 2FD7       	B0MOV P5UR, A
L132:
                  	                  	    //0: low level, 1: high level
                  	                  	    P5 = 0xF8;			//0b1111 1000
  CA8: 2FD5       	B0MOV P5, A
L133:
                  	                  	
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P3M = 0x00;			//均为LCD口
  CA9: 3700       	B0MOV 0x87, #00h
  CAA: 2BC3       	CLR 0xC3
L134:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P3SEG = 0x00;		//均为LCD口
  CAB: 2BB3       	CLR 0xB3
L135:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P3UR = 0x00;		//均为LCD口
  CAC: 2BDE       	CLR 0xDE
L136:
                  	                  		//0: low level, 1: high level
                  	                  		P3 = 0x00;			//均为LCD口
  CAD: 2BD3       	CLR 0xD3
L137:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P4M = 0x00;			//均为LCD口
  CAE: 2BC4       	CLR 0xC4
L138:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P4SEG = 0x00;		//均为LCD口
  CAF: 2BB6       	CLR 0xB6
L139:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P4UR = 0x00;		//均为LCD口
  CB0: 2BD6       	CLR 0xD6
L140:
                  	                  		//0: low level, 1: high level
                  	                  		P4 = 0x00;			//均为LCD口
  CB1: 2BD4       	CLR 0xD4
L141:
                  	                  	}
  CB2: 0E00       	RET
_Function_main_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	ETH_2988_SJ_V1.0_20200704.c
                  	                  	说    明：	耳套可选,单位焊接选择,背光可选,物温可选
                  	                  	程序编码：	详见Variable.h
                  	                  	版    本：	V1.0
                  	                  	适用 PCB:	ETH PCB(A)
                  	                  	芯	  片:	SN8P2988
                  	                  	作    者:	Liaoy
                  	                  	修订记录：
                  	                  	1、在ET215-2988-242-V1.0-20190821基础上生成ETH程序；
                  	                  	V1.0：
                  	                  	采用宏定义合并程序，版本不升级，廖彦20200704
                  	                  	V1.0:
                  	                  	传感器表格也进行宏定义，与之PGA放大倍数也必须宏定义，版本升级为V1.6，廖彦20200723
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	
                  	                  	//主程序
                  	                  	void main(void)
                  	                  	{
                  	                  		//系统时钟设定
                  	                  	  	OSCM = 0x00;		//开启内置IHRC=8M，外置低速晶振32768，Fcpu=Normal mode
  CB3: 3700       	B0MOV 0x87, #00h
  CB4: 2BCA       	CLR 0xCA
L126:
                  	                  		Delay50us(100);
  CB5: 2D64       	MOV A, #64h
  CB6: 3702       	B0MOV 0x87, #02h
  CB7: 1FA3       	MOV 0xA3, A
  CB8: C77E       	CALL 0x077E
L127:
                  	                  	
                  	                  		//部分参数设置，如年月日时分秒
                  	                  		g_Hour = 0;
  CB9: 3700       	B0MOV 0x87, #00h
  CBA: 2B78       	CLR 0x78
L128:
                  	                  		g_Minute = 0;
  CBB: 2B79       	CLR 0x79
L129:
                  	                  		g_Day = 1;
  CBC: 2D01       	MOV A, #01h
  CBD: 1F7A       	MOV 0x7A, A
L130:
                  	                  		g_Month = 1;
  CBE: 1F7B       	MOV 0x7B, A
L131:
                  	                  		g_Year = Default_Year;
  CBF: 2DE7       	MOV A, #e7h
  CC0: 1F7C       	MOV 0x7C, A
  CC1: 2D07       	MOV A, #07h
  CC2: 1F7D       	MOV 0x7D, A
L132:
                  	                  		g_Second = 0;
  CC3: 2B7E       	CLR 0x7E
L133:
                  	                  		uSetFlag.bits.TimeFormat = TimeFormat_24H;	//默认24小时制
  CC4: 417F       	BCLR 0x7F.1
L134:
                  	                  		uSetFlag.bits.Unit = Unit_C;	//默认C单位
  CC5: 407F       	BCLR 0x7F.0
L135:
                  	                  	
                  	                  		#if CF_Change_Enable == 1
                  	                  			uSetFlag.bits.Unit_Change = Unit_Change_En;	//默认单位可切换
  CC6: 427F       	BCLR 0x7F.2
L136:
                  	                  		#else
                  	                  			uSetFlag.bits.Unit_Change = Unit_Change_Dis;	//默认单位可切换
                  	                  		#endif
                  	                  	
                  	                  		uSetFlag.bits.VoiceEnable = 1;        //默认开启语音
  CC7: 4B7F       	BSET 0x7F.3
L137:
                  	                  	
                  	                  		#if Func_Ble
                  	                  			uSetFlag.bits.BleEnable = Enable;
  CC8: 4D7F       	BSET 0x7F.5
L138:
                  	                  		#endif
                  	                  		
                  	                  		GPIO_Init();//IO口设置
  CC9: CC67       	CALL 0x0C67
L139:
                  	                  		Lcd_Init();	//Lcd设置
  CCA: E351       	CALL 0x2351
L140:
                  	                  		CF_Check();	//单位状态确认
  CCB: CC61       	CALL 0x0C61
L141:
                  	                  	
                  	                  		//上电是否进入设置态
                  	                  		#if Electricity_poweroff == 0
                  	                  			eMain_Task = Task_Setmode;
                  	                  		#else
                  	                  			eMain_Task = Task_Sleepmode;
  CCC: 2D08       	MOV A, #08h
  CCD: 1F36       	MOV 0x36, A
L142:
