L711:
                  	                  	            break;
  AE2: 8B41       	JMP 0x0B41
L700:
                  	                  	        case Func_Short_Long:
                  	                  	            sKey->g_KeyFun &= ~En_Cp;	//非加速按
  AE3: 2DFE       	MOV A, #feh
  AE4: 2F80       	B0MOV L, A
  AE5: 1EA5       	MOV A, 0xA5
  AE6: 2F84       	B0MOV Y, A
  AE7: 1EA4       	MOV A, 0xA4
  AE8: 2F83       	B0MOV Z, A
  AE9: 2E80       	B0MOV A, L
  AEA: 3700       	B0MOV 0x87, #00h
  AEB: 29E7       	AND 0xE7, A
L713:
                  	                  	            sKey->g_Key_preset_cnt = CNT_ShortLong;
  AEC: 2D04       	MOV A, #04h
  AED: 3702       	B0MOV 0x87, #02h
  AEE: 12A4       	ADD A, 0xA4
  AEF: 2F83       	B0MOV Z, A
  AF0: 2D00       	MOV A, #00h
  AF1: 10A5       	ADC A, 0xA5
  AF2: 2F84       	B0MOV Y, A
  AF3: 2D32       	MOV A, #32h
  AF4: 2FE7       	B0MOV @YZ, A
L714:
                  	                  	            break;
  AF5: 8B41       	JMP 0x0B41
L701:
                  	                  	        case Func_Long:
                  	                  	            sKey->g_KeyFun &= ~En_Cp;	//非加速按
  AF6: 2DFE       	MOV A, #feh
  AF7: 2F80       	B0MOV L, A
  AF8: 1EA5       	MOV A, 0xA5
  AF9: 2F84       	B0MOV Y, A
  AFA: 1EA4       	MOV A, 0xA4
  AFB: 2F83       	B0MOV Z, A
  AFC: 2E80       	B0MOV A, L
  AFD: 3700       	B0MOV 0x87, #00h
  AFE: 29E7       	AND 0xE7, A
L716:
                  	                  	            sKey->g_Key_preset_cnt = CNT_LongPress;
  AFF: 2D04       	MOV A, #04h
  B00: 3702       	B0MOV 0x87, #02h
  B01: 12A4       	ADD A, 0xA4
  B02: 2F83       	B0MOV Z, A
  B03: 2D00       	MOV A, #00h
  B04: 10A5       	ADC A, 0xA5
  B05: 2F84       	B0MOV Y, A
  B06: 2D96       	MOV A, #96h
  B07: 2FE7       	B0MOV @YZ, A
L717:
                  	                  	            break;
  B08: 8B41       	JMP 0x0B41
L702:
                  	                  	        case Func_Short_Continue:
                  	                  	            sKey->g_KeyFun |= En_Cp; 	//加速按
  B09: 2D01       	MOV A, #01h
  B0A: 2F80       	B0MOV L, A
  B0B: 1EA5       	MOV A, 0xA5
  B0C: 2F84       	B0MOV Y, A
  B0D: 1EA4       	MOV A, 0xA4
  B0E: 2F83       	B0MOV Z, A
  B0F: 2E80       	B0MOV A, L
  B10: 3700       	B0MOV 0x87, #00h
  B11: 19E7       	OR 0xE7, A
L719:
                  	                  	            sKey->g_Key_preset_cnt = CNT_EnterCP;
  B12: 2D04       	MOV A, #04h
  B13: 3702       	B0MOV 0x87, #02h
  B14: 12A4       	ADD A, 0xA4
  B15: 2F83       	B0MOV Z, A
  B16: 2D00       	MOV A, #00h
  B17: 10A5       	ADC A, 0xA5
  B18: 2F84       	B0MOV Y, A
  B19: 2D3C       	MOV A, #3ch
  B1A: 2FE7       	B0MOV @YZ, A
L720:
                  	                  	            break;
  B1B: 8B41       	JMP 0x0B41
L703:
                  	                  	        case Func_Super_Long:
                  	                  	            sKey->g_KeyFun &= ~En_Cp;	//非加速按
  B1C: 2DFE       	MOV A, #feh
  B1D: 2F80       	B0MOV L, A
  B1E: 1EA5       	MOV A, 0xA5
  B1F: 2F84       	B0MOV Y, A
  B20: 1EA4       	MOV A, 0xA4
  B21: 2F83       	B0MOV Z, A
  B22: 2E80       	B0MOV A, L
  B23: 3700       	B0MOV 0x87, #00h
  B24: 29E7       	AND 0xE7, A
L722:
                  	                  	            sKey->g_Key_preset_cnt = CNT_LLongPress;
  B25: 2D04       	MOV A, #04h
  B26: 3702       	B0MOV 0x87, #02h
  B27: 12A4       	ADD A, 0xA4
  B28: 2F83       	B0MOV Z, A
  B29: 2D00       	MOV A, #00h
  B2A: 10A5       	ADC A, 0xA5
  B2B: 2F84       	B0MOV Y, A
  B2C: 2DFA       	MOV A, #fah
  B2D: 2FE7       	B0MOV @YZ, A
L723:
                  	                  	            break;
  B2E: 8B41       	JMP 0x0B41
L697:
                  	                  	        default:
                  	                  	            sKey->g_KeyFun &= ~En_Cp; 	//非加速按
  B2F: 2DFE       	MOV A, #feh
  B30: 2F80       	B0MOV L, A
  B31: 1EA5       	MOV A, 0xA5
  B32: 2F84       	B0MOV Y, A
  B33: 1EA4       	MOV A, 0xA4
  B34: 2F83       	B0MOV Z, A
  B35: 2E80       	B0MOV A, L
  B36: 3700       	B0MOV 0x87, #00h
  B37: 29E7       	AND 0xE7, A
L725:
                  	                  	            sKey->g_Key_preset_cnt = CNT_LongPress;
  B38: 2D04       	MOV A, #04h
