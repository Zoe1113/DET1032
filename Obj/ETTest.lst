_Function_Disp_Sensor_Name_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	App_SensorInfoET.c
                  	                  	说    明：	传感器参数（应用层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	适用机型：
                  	                  	备	  注：	NTC:0-50,TP:-20-100℃,Offset:25-43@0-50
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	//只在本文件内使用的宏定义
                  	                  	#define TpTable_Offset 20	//S_TpTable温度偏移步长
                  	                  	#define TpTable_Max  121	//S_TpTable数组大小
                  	                  	#define NtcTable_Max 501	//S_NtcTable数组大小
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	Disp_Sensor_Name()
                  	                  	函数功能：	绑定检测模式显示传感器名称
                  	                  	输入参数：	无
                  	                  	输出参数：	LCD
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Disp_Sensor_Name(void)
                  	                  	{
                  	                  		Clr_Disp();
 307A: E963       	CALL 0x2963
L35:
                  	                  	#if Sensor == J11
                  	                  	//J11
                  	                  			lcd9 = S_J>>8;
                  	                  	        lcd8 = S_J;
                  	                  	        lcd7 =  DispTable[ 1 ] >> 8;
                  	                  	        lcd6 =  DispTable[ 1 ]
                  	                  	        lcd5 =  DispTable[ 1 ] >> 8;
                  	                  	        lcd4 =  DispTable[ 1 ]
                  	                  	#endif
                  	                  	
                  	                  	#if Sensor == STP9CF55
                  	                  	//STP
                  	                  			lcd9 = S_S>>8;
 307B: 2D0C       	MOV A, #0ch
 307C: 1F05       	MOV 0x05, A
L36:
                  	                  	        lcd8 = S_S;
 307D: 2D0B       	MOV A, #0bh
 307E: 1F06       	MOV 0x06, A
L37:
                  	                  	        lcd7 = S_t>>8;
 307F: 2D0E       	MOV A, #0eh
 3080: 1F07       	MOV 0x07, A
L38:
                  	                  	        lcd6 = S_t;
 3081: 2D01       	MOV A, #01h
 3082: 1F08       	MOV 0x08, A
L39:
                  	                  	        lcd5 = S_P>>8;
 3083: 2D0E       	MOV A, #0eh
 3084: 1F09       	MOV 0x09, A
L40:
                  	                  	        lcd4 = S_P;
 3085: 2D0C       	MOV A, #0ch
 3086: 1F0A       	MOV 0x0A, A
L41:
                  	                  	#endif
                  	                  	
                  	                  	#if Sensor == ZXH
                  	                  	//ZXH
                  	                  	        lcd7 = 0x07;
                  	                  	        lcd6 = 0x06;
                  	                  	#endif
                  	                  	
                  	                  	#if Sensor == STP10DF55
                  	                  	//STP10DF55
                  	                  			lcd9 = DispTable[ 1 ] >> 8;
                  	                  	        lcd8 = DispTable[ 1 ];
                  	                  	        lcd7 = DispTable[ 0 ] >> 8;
                  	                  	        lcd6 = DispTable[ 0 ];
                  	                  	        lcd5 = S_d>>8;
                  	                  	        lcd4 = S_d;
                  	                  	#endif
                  	                  	
                  	                  	#if Sensor == STP11DF55
                  	                  	//STP11DF55
                  	                  			lcd9 = DispTable[ 1 ] >> 8;
                  	                  	        lcd8 = DispTable[ 1 ];
                  	                  	        lcd7 = DispTable[ 1 ] >> 8;
                  	                  	        lcd6 = DispTable[ 1 ];
                  	                  	        lcd5 = S_d>>8;
                  	                  	        lcd4 = S_d;
                  	                  	#endif
                  	                  	}
 3087: 0E00       	RET
_Function_Ntc_Caculate_code:
                  	                  	
                  	                  	#if Sensor == STP9CF55
                  	                  	
                  	                  	/**************************************************************************
                  	                  	//STP9CF55 Sensor Thermistor 参数
                  	                  	**************************************************************************/
                  	                  	const int16 g_Table37C = 0x05EA;			//37℃校准理论值
                  	                  	const int16 g_Table41C = 0x080B;			//41℃校准理论值
                  	                  	#if Nation									//国外为10-40℃
                  	                  	const uint16 g_NtcTableDown1 = 0x4D97;		//10℃NTC表格值
                  	                  	const uint16 g_NtcTableUp1 = 0x14CF;		//40℃NTC表格值
                  	                  	#else										//国内为16-35℃
                  	                  	const uint16 g_NtcTableDown1 = 0x3A97;		//16℃NTC表格值 
                  	                  	const uint16 g_NtcTableUp1 = 0x1980;		//35℃NTC表格值 
                  	                  	#endif
                  	                  	const uint16 g_NtcTableDown2 = 0x7E7B;		//0℃NTC表格值
                  	                  	const uint16 g_NtcTableUp2 = 0x0E1D;	    //50℃NTC表格值
                  	                  	const int16 g_TpTableDown = 0xEF63;	      	//TP表格下限(-20)
                  	                  	const int16 g_TpTableUp = 0x3247;		    //TP表格上限(100)
                  	                  	
                  	                  	/**************************************************************************
                  	                  	//STP9CF55 Sensor Thermistor table 0℃~50℃
                  	                  	**************************************************************************/
