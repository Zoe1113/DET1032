  CCD: 3701       	B0MOV 0x87, #01h
  CCE: 2B67       	CLR 0x67
L144:
                  	                  	    eAgemode_num = BigAge;
  CCF: 3700       	B0MOV 0x87, #00h
  CD0: 1F33       	MOV 0x33, A
L145:
                  	                  	
                  	                  		//低电压检测
