_Function_LVD_Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LVD.c
                  	                  	说    明：	低电压处理函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Init(void)
                  	                  	函数功能：	low voltage初始化设置
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LVD_Init(void)
                  	                  	{
                  	                  		//internal lvd
                  	                  		LBTM = 0x10 ;		//低电压<2.6V，内部电压检测
  BA5: 2D10       	MOV A, #10h
  BA6: 2F95       	B0MOV LBTM, A
L35:
                  	                  		Delay50us(1) ;
  BA7: 2D01       	MOV A, #01h
  BA8: 3702       	B0MOV 0x87, #02h
  BA9: 1FA2       	MOV 0xA2, A
  BAA: C775       	CALL 0x0775
L36:
                  	                  		FLBTEN = 1 ;		//enable low-voltage detect
  BAB: 6895       	B0BSET 0x95.0
L37:
                  	                  	}
  BAC: 0E00       	RET
_Function_LVD_Chk_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Chk(void)
                  	                  	函数功能：	low voltage检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	100ms（Fcup=2M）
                  	                  	**************************************************************************/
                  	                  	void LVD_Chk(void)
                  	                  	{
                  	                  		uint8 i ;		//count with low-voltage
                  	                  	
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  BAD: 3702       	B0MOV 0x87, #02h
  BAE: 2BA6       	CLR 0xA6
  BAF: 8BBE       	JMP 0x0BBE
L40:
                  	                  		{
                  	                  			Delay10ms(1) ;		//延迟10ms稳定
  BB0: 2D01       	MOV A, #01h
  BB1: 1FA2       	MOV 0xA2, A
  BB2: C79A       	CALL 0x079A
L57:
                  	                  			if( FLBTO )			//FLBTO 1:低电压 0：正常电压
  BB3: 7995       	B0BTS1 0x95.1
  BB4: 8BB8       	JMP 0x0BB8
L58:
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 1 ;
  BB5: 3700       	B0MOV 0x87, #00h
  BB6: 4932       	BSET 0x32.1
L61:
                  	                  			}
  BB7: 8BBB       	JMP 0x0BBB
L44:
                  	                  			else
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 0 ;
  BB8: 3700       	B0MOV 0x87, #00h
  BB9: 4132       	BCLR 0x32.1
L66:
                  	                  				break;
  BBA: 8BC2       	JMP 0x0BC2
L67:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  BBB: 3702       	B0MOV 0x87, #02h
  BBC: 16A6       	INCMS 0xA6
  BBD: 0000       	NOP
L43:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  BBE: 1EA6       	MOV A, 0xA6
  BBF: 240A       	SUB A, #0ah
  BC0: 7A86       	B0BTS1 0x86.2
  BC1: 8BB0       	JMP 0x0BB0
L42:
                  	                  			}
                  	                  		}
                  	                  	}
  BC2: 0E00       	RET
