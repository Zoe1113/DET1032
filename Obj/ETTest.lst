_Function_LVD_Display_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Display(void)
                  	                  	函数功能：	低电时显示
                  	                  	输入参数：	void
                  	                  	输出参数：	void
                  	                  	返回值  ：	无
                  	                  	**************************************************************************/
                  	                  	void LVD_Display(void)
                  	                  	{
                  	                  	     #if Second_LVD == 1
                  	                  	        /*如果电压高于2.7v*/
                  	                  	        if(uStaFlag.bits.MidBat != 1 && uStaFlag.bits.LowBat != 1 )
