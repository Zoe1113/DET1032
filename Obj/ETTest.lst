  2DD: 7886       	B0BTS1 0x86.0
  2DE: 82E1       	JMP 0x02E1
L398:
                  	                  				return 1;
  2DF: 2D01       	MOV A, #01h
  2E0: 82E2       	JMP 0x02E2
L382:
                  	                  			else
