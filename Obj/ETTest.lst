_Function_LVD_Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LVD.c
                  	                  	说    明：	低电压处理函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Init(void)
                  	                  	函数功能：	low voltage初始化设置
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LVD_Init(void)
                  	                  	{
                  	                  		//internal lvd
                  	                  		LBTM = 0x10 ;		//低电压<2.6V，内部电压检测
  B59: 2D10       	MOV A, #10h
  B5A: 2F95       	B0MOV LBTM, A
L35:
                  	                  		Delay50us(1) ;
  B5B: 2D01       	MOV A, #01h
  B5C: 3702       	B0MOV 0x87, #02h
  B5D: 1FA3       	MOV 0xA3, A
  B5E: C77E       	CALL 0x077E
L36:
                  	                  		FLBTEN = 1 ;		//enable low-voltage detect
  B5F: 6895       	B0BSET 0x95.0
L37:
                  	                  	}
  B60: 0E00       	RET
_Function_LVD_Chk_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LVD_Chk(void)
                  	                  	函数功能：	low voltage检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	100ms（Fcup=2M）
                  	                  	**************************************************************************/
                  	                  	void LVD_Chk(void)
                  	                  	{
                  	                  		uint8 i ;		//count with low-voltage
                  	                  	
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B61: 3702       	B0MOV 0x87, #02h
  B62: 2BA7       	CLR 0xA7
  B63: 8B72       	JMP 0x0B72
L40:
                  	                  		{
                  	                  			Delay10ms(1) ;		//延迟10ms稳定
  B64: 2D01       	MOV A, #01h
  B65: 1FA3       	MOV 0xA3, A
  B66: C7A3       	CALL 0x07A3
L57:
                  	                  			if( FLBTO )			//FLBTO 1:低电压 0：正常电压
  B67: 7995       	B0BTS1 0x95.1
  B68: 8B6C       	JMP 0x0B6C
L58:
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 1 ;
  B69: 3700       	B0MOV 0x87, #00h
  B6A: 4935       	BSET 0x35.1
L61:
                  	                  			}
  B6B: 8B6F       	JMP 0x0B6F
L44:
                  	                  			else
                  	                  			{
                  	                  				uStaFlag.bits.LowBat = 0 ;
  B6C: 3700       	B0MOV 0x87, #00h
  B6D: 4135       	BCLR 0x35.1
L66:
                  	                  				break;
  B6E: 8B76       	JMP 0x0B76
L67:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B6F: 3702       	B0MOV 0x87, #02h
  B70: 16A7       	INCMS 0xA7
  B71: 0000       	NOP
L43:
                  	                  		for( i=0; i<10; i++ )	//若低电压连续有十次，则置低电压标志F_Lo为1，清低电压计数
  B72: 1EA7       	MOV A, 0xA7
  B73: 240A       	SUB A, #0ah
  B74: 7A86       	B0BTS1 0x86.2
  B75: 8B64       	JMP 0x0B64
L42:
                  	                  			}
                  	                  		}
                  	                  	}
  B76: 0E00       	RET
_Function_LBT_Chk_code:
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void LBT_Chk(void)
                  	                  	函数功能：	二级电压检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat,uStaFlag.bits.MidBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LBT_Chk(void)
                  	                  	{
                  	                  		uint8 i=0 ;				
  B77: 3702       	B0MOV 0x87, #02h
  B78: 2BA7       	CLR 0xA7
L109:
                  	                  	
                  	                  		/*先用2.7V的比较电压检测*/
                  	                  		LBTM = 0x14 ;		
  B79: 2D14       	MOV A, #14h
  B7A: 2F95       	B0MOV LBTM, A
L110:
                  	                  		Delay50us(1) ;
  B7B: 2D01       	MOV A, #01h
  B7C: 1FA3       	MOV 0xA3, A
  B7D: C77E       	CALL 0x077E
L111:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  B7E: 6895       	B0BSET 0x95.0
L112:
                  	                  	
                  	                  		/*若低电压连续有十次，则置低电压标志为1，清低电压计数*/
                  	                  		for( i=0; i<10; i++ )	
  B7F: 2BA7       	CLR 0xA7
  B80: 8B90       	JMP 0x0B90
L78:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;		
  B81: 2D01       	MOV A, #01h
  B82: 1FA3       	MOV 0xA3, A
  B83: C7A3       	CALL 0x07A3
L117:
                  	                  			/* FLBTO 1:低电压 0：正常电压 */
                  	                  			if( FLBTO )			
  B84: 7995       	B0BTS1 0x95.1
  B85: 8B89       	JMP 0x0B89
L118:
                  	                  			{
                  	                  				/*二级电压第一级标志位打开*/
                  	                  				uStaFlag.bits.MidBat = 1;
  B86: 3700       	B0MOV 0x87, #00h
  B87: 4D35       	BSET 0x35.5
L121:
                  	                  			}
  B88: 8B8D       	JMP 0x0B8D
L82:
                  	                  			/*如果有一次未检测到*/
                  	                  			else
                  	                  			{
                  	                  				/*清除标志位并返回*/
                  	                  				uStaFlag.bits.MidBat = 0;		
  B89: 3700       	B0MOV 0x87, #00h
  B8A: 4535       	BCLR 0x35.5
L126:
                  	                  				uStaFlag.bits.LowBat = 0 ;
  B8B: 4135       	BCLR 0x35.1
L127:
                  	                  				return;		
  B8C: 8BB2       	JMP 0x0BB2
L128:
                  	                  		for( i=0; i<10; i++ )	
  B8D: 3702       	B0MOV 0x87, #02h
  B8E: 16A7       	INCMS 0xA7
  B8F: 0000       	NOP
L81:
                  	                  		for( i=0; i<10; i++ )	
  B90: 1EA7       	MOV A, 0xA7
  B91: 240A       	SUB A, #0ah
  B92: 7A86       	B0BTS1 0x86.2
  B93: 8B81       	JMP 0x0B81
L134:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果连续十次小于2.7v，判断有没有低于2.6v*/
                  	                  		/*选择2.6v作为比较电压*/
                  	                  		LBTM = 0x10 ;		
  B94: 2D10       	MOV A, #10h
  B95: 2F95       	B0MOV LBTM, A
L137:
                  	                  		Delay50us(1) ;
  B96: 2D01       	MOV A, #01h
  B97: 1FA3       	MOV 0xA3, A
  B98: C77E       	CALL 0x077E
L138:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  B99: 6895       	B0BSET 0x95.0
L139:
                  	                  	
                  	                  		for( i=0; i<10; i++ )	
  B9A: 2BA7       	CLR 0xA7
  B9B: 8BAA       	JMP 0x0BAA
L90:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;	
  B9C: 2D01       	MOV A, #01h
  B9D: 1FA3       	MOV 0xA3, A
  B9E: C7A3       	CALL 0x07A3
L144:
                  	                  			/*FLBTO 1:低电压 0：正常电压*/
                  	                  			if( FLBTO )			
  B9F: 7995       	B0BTS1 0x95.1
  BA0: 8BA4       	JMP 0x0BA4
L145:
                  	                  			{
                  	                  				/*二级电压第二级标志位打开*/
                  	                  				uStaFlag.bits.LowBat = 1 ;	
  BA1: 3700       	B0MOV 0x87, #00h
  BA2: 4935       	BSET 0x35.1
L148:
                  	                  			}
  BA3: 8BA7       	JMP 0x0BA7
L94:
                  	                  			else
                  	                  			{
                  	                  				/*如果有一次大于2.6V*/
                  	                  				uStaFlag.bits.LowBat = 0 ;
  BA4: 3700       	B0MOV 0x87, #00h
  BA5: 4135       	BCLR 0x35.1
L153:
                  	                  				return;		
  BA6: 8BB2       	JMP 0x0BB2
L154:
                  	                  		for( i=0; i<10; i++ )	
  BA7: 3702       	B0MOV 0x87, #02h
  BA8: 16A7       	INCMS 0xA7
  BA9: 0000       	NOP
L93:
                  	                  		for( i=0; i<10; i++ )	
  BAA: 1EA7       	MOV A, 0xA7
  BAB: 240A       	SUB A, #0ah
  BAC: 7A86       	B0BTS1 0x86.2
  BAD: 8B9C       	JMP 0x0B9C
L160:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果二级电压第二级标志位打开*/
                  	                  		if(uStaFlag.bits.LowBat == 1)
  BAE: 3700       	B0MOV 0x87, #00h
  BAF: 5935       	BTS1 0x35.1
  BB0: 8BB2       	JMP 0x0BB2
L163:
                  	                  		{
                  	                  			/*二级电压第一级标志位关闭*/
                  	                  			uStaFlag.bits.MidBat = 0;
  BB1: 4535       	BCLR 0x35.5
L166:
                  	                  		}
                  	                  		return;
                  	                  	}
  BB2: 0E00       	RET
