_Function_Disp_Sensor_Name_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	App_SensorInfoET.c
                  	                  	说    明：	传感器参数（应用层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	适用机型：
                  	                  	备	  注：	NTC:0-50,TP:-20-100℃,Offset:25-43@0-50
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	//只在本文件内使用的宏定义
                  	                  	#define TpTable_Offset 20	//S_TpTable温度偏移步长
                  	                  	#define TpTable_Max  121	//S_TpTable数组大小
                  	                  	#define NtcTable_Max 501	//S_NtcTable数组大小
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	Disp_Sensor_Name()
                  	                  	函数功能：	绑定检测模式显示传感器名称
                  	                  	输入参数：	无
                  	                  	输出参数：	LCD
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Disp_Sensor_Name(void)
                  	                  	{
                  	                  		Clr_Disp();
 3076: E95F       	CALL 0x295F
L35:
                  	                  	#if Sensor == J11
                  	                  	//J11
                  	                  			lcd9 = S_J>>8;
                  	                  	        lcd8 = S_J;
                  	                  	        lcd7 =  DispTable[ 1 ] >> 8;
                  	                  	        lcd6 =  DispTable[ 1 ]
                  	                  	        lcd5 =  DispTable[ 1 ] >> 8;
                  	                  	        lcd4 =  DispTable[ 1 ]
                  	                  	#endif
                  	                  	
                  	                  	#if Sensor == STP9CF55
                  	                  	//STP
                  	                  			lcd9 = S_S>>8;
 3077: 2D0C       	MOV A, #0ch
 3078: 1F05       	MOV 0x05, A
L36:
