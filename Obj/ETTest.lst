  C2C: 6DC5       	B0BSET 0xC5.5
L35:
                  	                  		FP56M = 1;		//输出为0
  C2D: 6EC5       	B0BSET 0xC5.6
L36:
                  	                  		FP57M = 1;		//输出为0
  C2E: 6FC5       	B0BSET 0xC5.7
L37:
                  	                  		LED_CloseAll();
  C2F: CC31       	CALL 0x0C31
L38:
                  	                  	}
  C30: 0E00       	RET
_Function_LED_CloseAll_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  		CLose LED
                  	                  	**************************************************************************/
                  	                  	void LED_CloseAll( void )
                  	                  	{
                  	                  		LED_Red_Dis();
  C31: 6FD5       	B0BSET 0xD5.7
L46:
                  	                  		LED_Yellow_Dis();
  C32: 6DD5       	B0BSET 0xD5.5
L52:
                  	                  		LED_Green_Dis(); 
  C33: 6ED5       	B0BSET 0xD5.6
L58:
                  	                  		LED_White_Dis();
  C34: 68D1       	B0BSET 0xD1.0
L64:
                  	                  	}
  C35: 0E00       	RET
_Function_T0Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_Timer.c
                  	                  	说    明：	定时器设置（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  		Timer 0 initialize(RTC，需使能外置32768 crystal)
                  	                  	**************************************************************************/
                  	                  	void T0Init( void )
                  	                  	{
                  	                  		FT0EN = 0;
  C36: 67D8       	B0BCLR 0xD8.7
L35:
                  	                  		T0M = 0x00;
  C37: 3700       	B0MOV 0x87, #00h
  C38: 2BD8       	CLR 0xD8
L36:
                  	                  		FT0TB = 1;			//set RTC mode
  C39: 68D8       	B0BSET 0xD8.0
L37:
                  	                  		FT0IEN = 0;
  C3A: 60C7       	B0BCLR 0xC7.0
L38:
                  	                  		FT0IRQ = 0;			//停止T0计时/中断/中断请求位
  C3B: 60C6       	B0BCLR 0xC6.0
L39:
                  	                  		FT0EN = 1;			//开启0.5s计时
  C3C: 6FD8       	B0BSET 0xD8.7
L40:
                  	                  	}
  C3D: 0E00       	RET
_Function_TC1Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  		TC1 initialize(10ms)
                  	                  		TC1R initial value = 65536 - (TC1 interrupt interval time * TC1 clock rate)
                  	                  		TC1D initial value = TC1R + (PWM high pulse width period / TC1 clock rate)
                  	                  	**************************************************************************/
                  	                  	void TC1Init( void )
                  	                  	{
                  	                  		TC1M = 0x40 ;		//0b01000000，Disable,Fcpu/8
  C3E: 2D40       	MOV A, #40h
  C3F: 2FE9       	B0MOV TC1M, A
L46:
                  	                  		TC1CL = 0x3C ;
  C40: 2D3C       	MOV A, #3ch
  C41: 2FEA       	B0MOV TC1CL, A
L47:
                  	                  		TC1RL = 0x3C ;		//10ms（Fcpu = 2M)
  C42: 2FEB       	B0MOV TC1RL, A
L48:
                  	                  		TC1CH = 0xF6 ;
  C43: 2DF6       	MOV A, #f6h
  C44: 2F9D       	B0MOV TC1CH, A
L49:
                  	                  		TC1RH = 0xF6 ;		//10ms（Fcpu = 2M)
  C45: 2F9E       	B0MOV TC1RH, A
L50:
                  	                  		FTC1IRQ = 0;		//清TC1中断请求位
  C46: 62C6       	B0BCLR INTRQ1.2
L51:
                  	                  		FTC1IEN = 1;		//enable TC1中断
  C47: 6AC7       	B0BSET INTEN1.2
L52:
                  	                  		FTC1ENB = 1 ;		//使能TC1定时器
  C48: 6FE9       	B0BSET TC1M.7
L53:
                  	                  	}
  C49: 0E00       	RET
_Function_TC2Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  		TC2 initialize(Buzzer 4KHZ，PT11口)
                  	                  		TC2R initial value = 65536 - (TC2 interrupt interval time * TC2 clock rate)
                  	                  		TC2D initial value = TC2R + (PWM high pulse width period / TC2 clock rate)
                  	                  	**************************************************************************/
                  	                  	void TC2Init( void )
                  	                  	{
                  	                  		TC2M = 0x40 ;		//0b01000000，Disable,Fcpu/8
  C4A: 2D40       	MOV A, #40h
  C4B: 2FEC       	B0MOV TC2M, A
L59:
                  	                  		TC2CL = 0xC1 ;
  C4C: 2DC1       	MOV A, #c1h
  C4D: 2FED       	B0MOV TC2CL, A
L60:
                  	                  		TC2RL = 0xC1 ;		//250us
  C4E: 2FEE       	B0MOV TC2RL, A
L61:
                  	                  		TC2CH = 0xFF ;
  C4F: 2DFF       	MOV A, #ffh
  C50: 2FAC       	B0MOV TC2CH, A
L62:
                  	                  		TC2RH = 0xFF ;		//250us
  C51: 2FAD       	B0MOV TC2RH, A
L63:
                  	                  		TC2DL6 = 0xE0 ;
  C52: 2DE0       	MOV A, #e0h
  C53: 370E       	B0MOV 0x87, #0Eh
  C54: 1F0A       	MOV 0x0A, A
L64:
                  	                  		TC2DH6 = 0xFF ;		//125us（1/2 duty)
  C55: 2DFF       	MOV A, #ffh
  C56: 1F0B       	MOV 0x0B, A
L65:
                  	                  	}
  C57: 0E00       	RET
_Function_Drv_UartTX_Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_Uart.c
                  	                  	说    明：	串口函数集合（驱动层）
                  	                  	作    者:	Liaoy
