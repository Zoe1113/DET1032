L108:
                  	                  		while(FUTX1BZ);
  C16: 728B       	B0BTS0 URTX1.2
  C17: 8C16       	JMP 0x0C16
L111:
                  	                  		if(FUTX1BZ==0)
  C18: 728B       	B0BTS0 URTX1.2
