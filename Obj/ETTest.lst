                  	                  	**************************************************************************/
                  	                  	void Drv_UartRX_Init(void) 
                  	                  	{
                  	                  		FP15M = 0;			//RX输入
  C34: 65C1       	B0BCLR P1M.5
L44:
                  	                  		URCR1 = B9600 ;
  C35: 2DE6       	MOV A, #e6h
  C36: 2F8D       	B0MOV URCR1, A
L45:
                  	                  		URRX1 = 0x84 ;		//Fuart (Fhosc=8Hz)=Fhosc/16，Enable UART RX，Disable UART RX parity bit function.
  C37: 2D84       	MOV A, #84h
  C38: 2F8C       	B0MOV URRX1, A
L46:
                  	                  		FURX1IEN = 1;		//RX必须在中断里接收
  C39: 6DC9       	B0BSET INTEN0.5
L47:
                  	                  	}
  C3A: 0E00       	RET
_Function_Drv_UartTX_Disable_code:
                  	                  	
                  	                  	/**************************************************************************
