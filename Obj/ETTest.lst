                  	                  	/**************************************************************************
                  	                  	函数名称：	Ntc_Caculate()
                  	                  	函数功能：	热敏电阻ADC值计算
                  	                  	输入参数：	g_AdcDoff、g_AIN2Count、g_AIN1Count
                  	                  	输出参数：	g_NtcCount
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	NTC*2710H/分压电阻=当前NTC测量值
                  	                  	**************************************************************************/
                  	                  	void Ntc_Caculate(void)
                  	                  	{
                  	                  		g_NtcCount = (int32)(g_AIN2Count-g_AdcDoff) * 0x2710 / (g_AIN1Count -g_AIN2Count);
 3084: 1E07       	MOV A, 0x07
 3085: 2210       	SUB A, 0x10
 3086: 1F49       	MOV 0x49, A
 3087: 1E08       	MOV A, 0x08
 3088: 2011       	SBC A, 0x11
 3089: 2B1B       	CLR 0x1B
 308A: 2B1C       	CLR 0x1C
 308B: 1F4A       	MOV 0x4A, A
 308C: 2E1B       	B0MOV A, 0x1B
 308D: 1F4B       	MOV 0x4B, A
 308E: 2E1C       	B0MOV A, 0x1C
 308F: 1F4C       	MOV 0x4C, A
 3090: 2D10       	MOV A, #10h
 3091: 1F4D       	MOV 0x4D, A
 3092: 2D27       	MOV A, #27h
 3093: 1F4E       	MOV 0x4E, A
 3094: 2D00       	MOV A, #00h
 3095: 1F4F       	MOV 0x4F, A
 3096: 1F50       	MOV 0x50, A
 3097: 3100       	B0MOV 0x81, #00h
 3098: 3019       	B0MOV 0x80, #19h
 3099: FD4C       	CALL 0x3D4C
 309A: 1E0A       	MOV A, 0x0A
 309B: 2207       	SUB A, 0x07
 309C: 1F4D       	MOV 0x4D, A
 309D: 1E0B       	MOV A, 0x0B
 309E: 2008       	SBC A, 0x08
 309F: 1F4E       	MOV 0x4E, A
 30A0: 2B1F       	CLR 0x1F
 30A1: 2B20       	CLR 0x20
 30A2: 2E19       	B0MOV A, 0x19
 30A3: 1F49       	MOV 0x49, A
 30A4: 2E1A       	B0MOV A, 0x1A
 30A5: 1F4A       	MOV 0x4A, A
 30A6: 2E1B       	B0MOV A, 0x1B
 30A7: 1F4B       	MOV 0x4B, A
 30A8: 2E1C       	B0MOV A, 0x1C
 30A9: 1F4C       	MOV 0x4C, A
 30AA: 2E1F       	B0MOV A, 0x1F
 30AB: 1F4F       	MOV 0x4F, A
 30AC: 2E20       	B0MOV A, 0x20
 30AD: 1F50       	MOV 0x50, A
 30AE: 3100       	B0MOV 0x81, #00h
 30AF: 3019       	B0MOV 0x80, #19h
 30B0: F909       	CALL 0x3909
 30B1: 2E19       	B0MOV A, 0x19
 30B2: 1F05       	MOV 0x05, A
 30B3: 2E1A       	B0MOV A, 0x1A
 30B4: 1F06       	MOV 0x06, A
L47:
                  	                  	}
 30B5: 0E00       	RET
