  C7D: 2BA3       	CLR 0xA3
L123:
                  	                  		{
                  	                  			if(FUTX1BZ==0)
  C7E: 728B       	B0BTS0 0x8B.2
  C7F: 8C82       	JMP 0x0C82
L142:
                  	                  				UTX1D = 0xFF ;
  C80: 2DFF       	MOV A, #ffh
  C81: 2F8E       	B0MOV UTX1D, A
L127:
                  	                  			NOP(5);
  C82: 0000       	NOP
  C83: 0000       	NOP
  C84: 0000       	NOP
  C85: 0000       	NOP
  C86: 0000       	NOP
L144:
                  	                  			while(FUTX1BZ);
  C87: 728B       	B0BTS0 URTX1.2
  C88: 8C87       	JMP 0x0C87
L147:
                  	                  		for(Count=0;Count<10;Count++)
  C89: 16A3       	INCMS 0xA3
  C8A: 0000       	NOP
L150:
                  	                  		for(Count=0;Count<10;Count++)
  C8B: 1EA3       	MOV A, 0xA3
  C8C: 1D80       	XOR A, #80h
  C8D: 248A       	SUB A, #8ah
  C8E: 7A86       	B0BTS1 0x86.2
  C8F: 8C7E       	JMP 0x0C7E
L151:
                  	                  		}
                  	                  	}
  C90: 0E00       	RET
_Function_Cal_Inspect_Detect_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_GPIO.c
                  	                  	说    明：	GPIO初始化函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	Cal_Inspect_Detect()
                  	                  	函数功能：	校准模式、绑定模式入口检测
                  	                  	输入参数：	Port_Debug、Port_Cal
                  	                  	输出参数：	uSetFlag
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Cal_Inspect_Detect(void)
                  	                  	{
                  	                  		//绑定检测模式、校温检测模式、系数调整模式判断
                  	                  		if( !Port_Debug && Port_Cal )
  C91: 74D5       	B0BTS0 0xD5.4
  C92: 8CA3       	JMP 0x0CA3
  C93: 7BD5       	B0BTS1 0xD5.3
  C94: 8CA3       	JMP 0x0CA3
L41:
                  	                  		{
                  	                  			if ( eTestmode_num == Insptectmode )
  C95: 3701       	B0MOV 0x87, #01h
  C96: 1E66       	MOV A, 0x66
  C97: 0604       	CMPRS A, #04h
  C98: 8C9E       	JMP 0x0C9E
L44:
                  	                  			{
                  	                  				 #if ParamModif
                  	                  				LED_CloseAll();
  C99: CC07       	CALL 0x0C07
L47:
                  	                  				eMain_Task = Task_ParamModifymode;	//生产模式短路debug口则进入系数调整模式
  C9A: 2D07       	MOV A, #07h
  C9B: 3700       	B0MOV 0x87, #00h
  C9C: 1F36       	MOV 0x36, A
L48:
                  	                  	            #endif
                  	                  	        }
  C9D: 8CA3       	JMP 0x0CA3
L34:
                  	                  			else
                  	                  			{
                  	                  				eSetTask = Set_Unit;		//设置态恢复状态
  C9E: 2B6A       	CLR 0x6A
L53:
                  	                  				F_FirstEnter_SetMode = 0;
  C9F: 3700       	B0MOV 0x87, #00h
  CA0: 423B       	BCLR 0x3B.2
L54:
                  	                  				eMain_Task = Task_BondTestmode;	//用户模式下短路debug进入绑定检测模式
  CA1: 2D06       	MOV A, #06h
  CA2: 1F36       	MOV 0x36, A
L55:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		//设置态决不允许进入校温，汇编和C的程序结构不一样，未初始化adc
                  	                  		if( !Port_Cal && !Port_Debug && eMain_Task == Task_ReadyMode )
  CA3: 73D5       	B0BTS0 0xD5.3
  CA4: 8CAE       	JMP 0x0CAE
  CA5: 74D5       	B0BTS0 0xD5.4
  CA6: 8CAE       	JMP 0x0CAE
  CA7: 3700       	B0MOV 0x87, #00h
  CA8: 2536       	DECS 0x36
  CA9: 8CAE       	JMP 0x0CAE
L60:
                  	                  		{
                  	                  	        #if Func_Ble
                  	                  	            F_Ble_En = Disable;         //进入校准关闭蓝牙
  CAA: 4348       	BCLR 0x48.3
L63:
                  	                  	            Port_Ble_En = 0;            //蓝牙失能
  CAB: 63D2       	B0BCLR 0xD2.3
L64:
                  	                  	        #endif
                  	                  			eMain_Task = Task_Calimode;		//用户模式下短路debug和cal进入校温模式
  CAC: 2D05       	MOV A, #05h
  CAD: 1F36       	MOV 0x36, A
L65:
                  	                  		}
                  	                  	}
  CAE: 0E00       	RET
_Function_CF_Check_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	CF_Check()
                  	                  	函数功能：	单位状态、单位可切换状态查询
                  	                  	输入参数：	Port_CF、Port_Change_CF
                  	                  	输出参数：	uSetFlag
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void CF_Check(void)
                  	                  	{
                  	                  		//单位状态检测
                  	                  		uSetFlag.bits.Unit = Unit_C;
  CAF: 3700       	B0MOV 0x87, #00h
  CB0: 407F       	BCLR 0x7F.0
L79:
                  	                  		if( !Port_CF )
  CB1: 72D5       	B0BTS0 0xD5.2
  CB2: 8CB4       	JMP 0x0CB4
L80:
                  	                  		{
                  	                  			uSetFlag.bits.Unit = Unit_F;
  CB3: 487F       	BSET 0x7F.0
L83:
                  	                  		}
                  	                  	
                  	                  	}
  CB4: 0E00       	RET
_Function_GPIO_Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	GPIO_Init()
                  	                  	函数功能：	IO口初始化设置
                  	                  	输入参数：	P0、P1、P2、P3、P4、P5
                  	                  	输出参数：	P0、P1、P2、P3、P4、P5
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void GPIO_Init(void)
                  	                  	{
                  	                  		//SDA/SCL输出为0(因为采用的是硬体I2C),按键输入上拉高电平,XIN/XOUT输入不上拉0
                  	                  		//0: input mode, 1: output mode
                  	                  		P0M = 0x0C;			//0b 0000 1100
  CB5: 2D0C       	MOV A, #0ch
  CB6: 2FC0       	B0MOV P0M, A
L91:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P0UR = 0x13;		//0b 0001 0011
  CB7: 2D13       	MOV A, #13h
  CB8: 2FE0       	B0MOV P0UR, A
L92:
                  	                  		//0: low level, 1: high level
                  	                  		P0 = 0x1F;			//0b 0001 1111
  CB9: 2D1F       	MOV A, #1fh
  CBA: 2FD0       	B0MOV P0, A
L93:
                  	                  	 
                  	                  		//白灯输出不上拉高电平,MOSI输出不上拉高电平,MISO输入不上拉高电平,SCK输出不上拉高电平,TX输入不上拉高电平（防止向BLE供电）,RX输入不上拉,VOC_EN,BLE_LINK输入不上拉1
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0x4F;			//0b0100 1111
  CBB: 2D4F       	MOV A, #4fh
  CBC: 2FC1       	B0MOV P1M, A
L94:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
  CBD: 2DFF       	MOV A, #ffh
  CBE: 2FB5       	B0MOV P1SEG, A
L95:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0xC0;		//0b1100 0000
  CBF: 2DC0       	MOV A, #c0h
  CC0: 2FE1       	B0MOV P1UR, A
L96:
                  	                  		//0: low level, 1: high lDevel
                  	                  		P1 = 0xB9;			//0b1011 1001
  CC1: 2DB9       	MOV A, #b9h
  CC2: 2FD1       	B0MOV P1, A
L97:
                  	                  	
                  	                  		//P25-P27为seg口，LINK脚输入 不上拉 高,EN输出 上拉 低，BUSY输入不上拉高，G320_EN输出不上拉高，VOC_EN输出不上拉低
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x0B;			//0b0000 1011
  CC3: 2D0B       	MOV A, #0bh
  CC4: 2FC2       	B0MOV P2M, A
L98:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b0001 1111,P25-P27均为LCD口
  CC5: 2D1F       	MOV A, #1fh
  CC6: 2FB2       	B0MOV P2SEG, A
L99:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x08;		//0b0000 1000
  CC7: 2D08       	MOV A, #08h
  CC8: 2FDD       	B0MOV P2UR, A
L100:
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x16;			//0b0001 0110
  CC9: 2D16       	MOV A, #16h
  CCA: 2FD2       	B0MOV P2, A
L101:
                  	                  	
                  	                  		//C/、CF、CAL、Debug输入上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P5M = 0xE0;			//0b1110 0000
  CCB: 2DE0       	MOV A, #e0h
  CCC: 2FC5       	B0MOV P5M, A
L102:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P5SEG = 0xFF;		//0b1111 1111
  CCD: 2DFF       	MOV A, #ffh
  CCE: 2FB7       	B0MOV P5SEG, A
L103:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P5UR = 0x1E;		//0b0001 1110
  CCF: 2D1E       	MOV A, #1eh
  CD0: 2FD7       	B0MOV P5UR, A
L104:
                  	                  		//0: low level, 1: high level
                  	                  		P5 = 0xFE;			//0b1111 1110
  CD1: 2DFE       	MOV A, #feh
  CD2: 2FD5       	B0MOV P5, A
L105:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P3M = 0x00;			//均为LCD口
  CD3: 3700       	B0MOV 0x87, #00h
  CD4: 2BC3       	CLR 0xC3
L106:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P3SEG = 0x00;		//均为LCD口
  CD5: 2BB3       	CLR 0xB3
L107:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P3UR = 0x00;		//均为LCD口
  CD6: 2BDE       	CLR 0xDE
L108:
                  	                  		//0: low level, 1: high level
                  	                  		P3 = 0x00;			//均为LCD口
  CD7: 2BD3       	CLR 0xD3
L109:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P4M = 0x00;			//均为LCD口
  CD8: 2BC4       	CLR 0xC4
L110:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P4SEG = 0x00;		//均为LCD口
  CD9: 2BB6       	CLR 0xB6
L111:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P4UR = 0x00;		//均为LCD口
  CDA: 2BD6       	CLR 0xD6
L112:
                  	                  		//0: low level, 1: high level
                  	                  		P4 = 0x00;			//均为LCD口
  CDB: 2BD4       	CLR 0xD4
L113:
                  	                  	}
  CDC: 0E00       	RET
_Function_GPIO_PowerDown_code:
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	GPIO_PowerDown()
                  	                  	函数功能：	IO口初始化设置
                  	                  	输入参数：	P0、P1、P2、P3、P4、P5
                  	                  	输出参数：	P0、P1、P2、P3、P4、P5
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void GPIO_PowerDown( void )
                  	                  	{
                  	                  		//按键输入上拉高电平,XIN/XOUT输入不上拉0,E2供电口输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P0M = 0x2C;			//0b0010 1100
  CDD: 2D2C       	MOV A, #2ch
  CDE: 2FC0       	B0MOV P0M, A
L119:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P0UR = 0x13;		//0b0001 0011
  CDF: 2D13       	MOV A, #13h
  CE0: 2FE0       	B0MOV P0UR, A
L120:
                  	                  		//0: low level, 1: high level
                  	                  		P0 = 0x1F;			//0b0001 1111
  CE1: 2D1F       	MOV A, #1fh
  CE2: 2FD0       	B0MOV P0, A
L121:
                  	                  	
                  	                  		//BZ不上拉输出0,TX输出不上拉低电平,RX为I2C供电口不上拉输出0,其余未使用输入上拉高
                  	                  	
                  	                  	#if !Func_Ble
                  	                  		//白灯输入上拉高，按键输入上拉高电平,BZ/MOSI/MISO/TX/RX/SCK均输出不上拉低，
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0xFE;			//0b 1111 1110
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0x01;		//0b 0100 0001
                  	                  		//0: low level, 1: high level
                  	                  		P1 = 0x01;			//0b 0100 0001
                  	                  	
                  	                  		//P25-P27为seg口，BLE_Link、BLE_EN、BLE_BUSY、G320_EN输出不上拉低，VOC_EN输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x03;			//0b 0000 0011
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b 0001 1111,P25-P27均为LCD口
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x1D;		//0b 0001 1101
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x1D;			//0b 0001 1101
                  	                  	#else
                  	                  		//按键输出不上拉低,，SCK/RX1/TX1/MISO/MOSI/BZ输出不上拉低,白灯输入上拉高，
                  	                  		//0: input mode, 1: output mode
                  	                  		P1M = 0xFE;			//0b 1111 1110
  CE3: 2DFE       	MOV A, #feh
  CE4: 2FC1       	B0MOV P1M, A
L122:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P1SEG = 0xFF;		//均为普通IO口
  CE5: 2DFF       	MOV A, #ffh
  CE6: 2FB5       	B0MOV P1SEG, A
L123:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P1UR = 0x01;		//0b 0000 0001
  CE7: 2D01       	MOV A, #01h
  CE8: 2FE1       	B0MOV P1UR, A
L124:
                  	                  		//0: low level, 1: high level
                  	                  		P1 = 0x01;			//0b 0000 0001
  CE9: 2FD1       	B0MOV P1, A
L125:
                  	                  	
                  	                  		//P25-P27为seg口，BLE_Link、BLE_EN、BLE_BUSY、G320_EN输出不上拉低，VOC_EN输出上拉高
                  	                  		//0: input mode, 1: output mode
                  	                  		P2M = 0x1F;			//0b 0001 1111
  CEA: 2D1F       	MOV A, #1fh
  CEB: 2FC2       	B0MOV P2M, A
L126:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P2SEG = 0x1F;		//0b 0001 1111,P25-P27均为LCD口
  CEC: 2FB2       	B0MOV P2SEG, A
L127:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P2UR = 0x01;		//0b 0000 0001
  CED: 2D01       	MOV A, #01h
  CEE: 2FDD       	B0MOV P2UR, A
L128:
                  	                  		//0: low level, 1: high level
                  	                  		P2 = 0x01;			//0b 0000 0001
  CEF: 2FD2       	B0MOV P2, A
L129:
                  	                  	#endif
                  	                  	
                  	                  		//RGB输入上拉高，CAL/Debug输入上拉高电平,C/F、CF输出不上拉0，MOTOR输出不上拉低
                  	                  	    //0: input mode, 1: output mode
                  	                  	    P5M = 0x07;			//0b0000 0111
  CF0: 2D07       	MOV A, #07h
  CF1: 2FC5       	B0MOV P5M, A
L130:
                  	                  	    //0: LCD functon pin, 1: IO pin
                  	                  	    P5SEG = 0xFF;		//0b1111 1111
  CF2: 2DFF       	MOV A, #ffh
  CF3: 2FB7       	B0MOV P5SEG, A
L131:
                  	                  	    //0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  	    P5UR = 0xF8;		//0b1111 1000
  CF4: 2DF8       	MOV A, #f8h
  CF5: 2FD7       	B0MOV P5UR, A
L132:
                  	                  	    //0: low level, 1: high level
                  	                  	    P5 = 0xF8;			//0b1111 1000
  CF6: 2FD5       	B0MOV P5, A
L133:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P3M = 0x00;			//均为LCD口
  CF7: 3700       	B0MOV 0x87, #00h
  CF8: 2BC3       	CLR 0xC3
L134:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P3SEG = 0x00;		//均为LCD口
  CF9: 2BB3       	CLR 0xB3
L135:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P3UR = 0x00;		//均为LCD口
  CFA: 2BDE       	CLR 0xDE
L136:
                  	                  		//0: low level, 1: high level
                  	                  		P3 = 0x00;			//均为LCD口
  CFB: 2BD3       	CLR 0xD3
L137:
                  	                  	
                  	                  		//0: input mode, 1: output mode
                  	                  		P4M = 0x00;			//均为LCD口
  CFC: 2BC4       	CLR 0xC4
L138:
                  	                  		//0: LCD functon pin, 1: IO pin
                  	                  		P4SEG = 0x00;		//均为LCD口
  CFD: 2BB6       	CLR 0xB6
L139:
                  	                  		//0: disable pullup, 1: enable pullup, pull resistor = 200k
                  	                  		P4UR = 0x00;		//均为LCD口
  CFE: 2BD6       	CLR 0xD6
L140:
                  	                  		//0: low level, 1: high level
                  	                  		P4 = 0x00;			//均为LCD口
  CFF: 2BD4       	CLR 0xD4
L141:
                  	                  	}
  D00: 0E00       	RET
_Function_main_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	ETH_2988_SJ_V1.0_20200704.c
                  	                  	说    明：	耳套可选,单位焊接选择,背光可选,物温可选
                  	                  	程序编码：	详见Variable.h
                  	                  	版    本：	V1.0
                  	                  	适用 PCB:	ETH PCB(A)
                  	                  	芯	  片:	SN8P2988
                  	                  	作    者:	Liaoy
                  	                  	修订记录：
                  	                  	1、在ET215-2988-242-V1.0-20190821基础上生成ETH程序；
                  	                  	V1.0：
                  	                  	采用宏定义合并程序，版本不升级，廖彦20200704
                  	                  	V1.0:
                  	                  	传感器表格也进行宏定义，与之PGA放大倍数也必须宏定义，版本升级为V1.6，廖彦20200723
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	
                  	                  	//主程序
                  	                  	void main(void)
                  	                  	{
                  	                  		//系统时钟设定
                  	                  	  	OSCM = 0x00;		//开启内置IHRC=8M，外置低速晶振32768，Fcpu=Normal mode
