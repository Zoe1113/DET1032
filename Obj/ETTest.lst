                  	                  									0xC8BE, 0xBEB4, 0xB4AA, 0xAAA0, 0xA096, 0x968C, 0x8C82, 0x8278, 0x786E, 0x6E64,
                  	                  									0x645A, 0x5A50, 0x5046, 0x463C, 0x3C32, 0x3228, 0x281E, 0x1E14, 0x140A,
                  	                  	                            };
                  	                  	#else
