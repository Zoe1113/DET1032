                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void HalKey_KeyClr(void)
                  	                  	{
                  	                  	    uKeyHold.g_KeyHold_Flag = 0;
