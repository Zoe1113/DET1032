L128:
                  	                  		for( i=0; i<10; i++ )	
  B87: 3702       	B0MOV 0x87, #02h
  B88: 16A7       	INCMS 0xA7
  B89: 0000       	NOP
L81:
                  	                  		for( i=0; i<10; i++ )	
  B8A: 1EA7       	MOV A, 0xA7
