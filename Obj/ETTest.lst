                  	                  	函数功能：	二级电压检测
                  	                  	输入参数：	无
                  	                  	输出参数：	uStaFlag.bits.LowBat,uStaFlag.bits.MidBat
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void LBT_Chk(void)
                  	                  	{
                  	                  		uint8 i=0 ;				
  BC4: 3702       	B0MOV 0x87, #02h
  BC5: 2BA7       	CLR 0xA7
L109:
                  	                  	
                  	                  		/*先用2.7V的比较电压检测*/
                  	                  		LBTM = 0x14 ;		
  BC6: 2D14       	MOV A, #14h
  BC7: 2F95       	B0MOV LBTM, A
L110:
                  	                  		Delay50us(1) ;
  BC8: 2D01       	MOV A, #01h
  BC9: 1FA3       	MOV 0xA3, A
  BCA: C77E       	CALL 0x077E
L111:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  BCB: 6895       	B0BSET 0x95.0
L112:
                  	                  	
                  	                  		/*若低电压连续有十次，则置低电压标志为1，清低电压计数*/
                  	                  		for( i=0; i<10; i++ )	
  BCC: 2BA7       	CLR 0xA7
  BCD: 8BDD       	JMP 0x0BDD
L78:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;		
  BCE: 2D01       	MOV A, #01h
  BCF: 1FA3       	MOV 0xA3, A
  BD0: C7A3       	CALL 0x07A3
L117:
                  	                  			/* FLBTO 1:低电压 0：正常电压 */
                  	                  			if( FLBTO )			
  BD1: 7995       	B0BTS1 0x95.1
  BD2: 8BD6       	JMP 0x0BD6
L118:
                  	                  			{
                  	                  				/*二级电压第一级标志位打开*/
                  	                  				uStaFlag.bits.MidBat = 1;
  BD3: 3700       	B0MOV 0x87, #00h
  BD4: 4D35       	BSET 0x35.5
L121:
                  	                  			}
  BD5: 8BDA       	JMP 0x0BDA
L82:
                  	                  			/*如果有一次未检测到*/
                  	                  			else
                  	                  			{
                  	                  				/*清除标志位并返回*/
                  	                  				uStaFlag.bits.MidBat = 0;		
  BD6: 3700       	B0MOV 0x87, #00h
  BD7: 4535       	BCLR 0x35.5
L126:
                  	                  				uStaFlag.bits.LowBat = 0 ;
  BD8: 4135       	BCLR 0x35.1
L127:
                  	                  				return;		
  BD9: 8BFF       	JMP 0x0BFF
L128:
                  	                  		for( i=0; i<10; i++ )	
  BDA: 3702       	B0MOV 0x87, #02h
  BDB: 16A7       	INCMS 0xA7
  BDC: 0000       	NOP
L81:
                  	                  		for( i=0; i<10; i++ )	
  BDD: 1EA7       	MOV A, 0xA7
  BDE: 240A       	SUB A, #0ah
  BDF: 7A86       	B0BTS1 0x86.2
  BE0: 8BCE       	JMP 0x0BCE
L134:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果连续十次小于2.7v，判断有没有低于2.6v*/
                  	                  		/*选择2.6v作为比较电压*/
                  	                  		LBTM = 0x10 ;		
  BE1: 2D10       	MOV A, #10h
  BE2: 2F95       	B0MOV LBTM, A
L137:
                  	                  		Delay50us(1) ;
  BE3: 2D01       	MOV A, #01h
  BE4: 1FA3       	MOV 0xA3, A
  BE5: C77E       	CALL 0x077E
L138:
                  	                  		//enable low-voltage detect	
                  	                  		FLBTEN = 1 ;		
  BE6: 6895       	B0BSET 0x95.0
L139:
                  	                  	
                  	                  		for( i=0; i<10; i++ )	
  BE7: 2BA7       	CLR 0xA7
  BE8: 8BF7       	JMP 0x0BF7
L90:
                  	                  		{
                  	                  			/*延迟10ms稳定*/
                  	                  			Delay10ms(1) ;	
  BE9: 2D01       	MOV A, #01h
  BEA: 1FA3       	MOV 0xA3, A
  BEB: C7A3       	CALL 0x07A3
L144:
                  	                  			/*FLBTO 1:低电压 0：正常电压*/
                  	                  			if( FLBTO )			
  BEC: 7995       	B0BTS1 0x95.1
  BED: 8BF1       	JMP 0x0BF1
L145:
                  	                  			{
                  	                  				/*二级电压第二级标志位打开*/
                  	                  				uStaFlag.bits.LowBat = 1 ;	
  BEE: 3700       	B0MOV 0x87, #00h
  BEF: 4935       	BSET 0x35.1
L148:
                  	                  			}
  BF0: 8BF4       	JMP 0x0BF4
L94:
                  	                  			else
                  	                  			{
                  	                  				/*如果有一次大于2.6V*/
                  	                  				uStaFlag.bits.LowBat = 0 ;
  BF1: 3700       	B0MOV 0x87, #00h
  BF2: 4135       	BCLR 0x35.1
L153:
                  	                  				return;		
  BF3: 8BFF       	JMP 0x0BFF
L154:
                  	                  		for( i=0; i<10; i++ )	
  BF4: 3702       	B0MOV 0x87, #02h
  BF5: 16A7       	INCMS 0xA7
  BF6: 0000       	NOP
L93:
                  	                  		for( i=0; i<10; i++ )	
  BF7: 1EA7       	MOV A, 0xA7
  BF8: 240A       	SUB A, #0ah
  BF9: 7A86       	B0BTS1 0x86.2
  BFA: 8BE9       	JMP 0x0BE9
L160:
                  	                  			}
                  	                  		}
                  	                  	
                  	                  		/*如果二级电压第二级标志位打开*/
                  	                  		if(uStaFlag.bits.LowBat == 1)
  BFB: 3700       	B0MOV 0x87, #00h
  BFC: 5935       	BTS1 0x35.1
  BFD: 8BFF       	JMP 0x0BFF
L163:
                  	                  		{
                  	                  			/*二级电压第一级标志位关闭*/
                  	                  			uStaFlag.bits.MidBat = 0;
  BFE: 4535       	BCLR 0x35.5
L166:
                  	                  		}
                  	                  		return;
                  	                  	}
  BFF: 0E00       	RET
_Function_Drv_Led_Set_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_LED.c
                  	                  	说    明：	LED驱动函数集合（中间层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	
                  	                  	//底层驱动（io is sink mode）
                  	                  	void Drv_Led_Set(void)
                  	                  	{
                  	                  		FP55M = 1;		//输出为0
  C00: 6DC5       	B0BSET 0xC5.5
L35:
                  	                  		FP56M = 1;		//输出为0
  C01: 6EC5       	B0BSET 0xC5.6
L36:
                  	                  		FP57M = 1;		//输出为0
  C02: 6FC5       	B0BSET 0xC5.7
L37:
                  	                  		LED_CloseAll();
  C03: CC05       	CALL 0x0C05
L38:
                  	                  	}
  C04: 0E00       	RET
_Function_LED_CloseAll_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  		CLose LED
                  	                  	**************************************************************************/
                  	                  	void LED_CloseAll( void )
                  	                  	{
                  	                  		LED_Red_Dis();
  C05: 6FD5       	B0BSET 0xD5.7
L46:
                  	                  		LED_Yellow_Dis();
  C06: 6DD5       	B0BSET 0xD5.5
L52:
                  	                  		LED_Green_Dis(); 
  C07: 6ED5       	B0BSET 0xD5.6
L58:
                  	                  		LED_White_Dis();
  C08: 68D1       	B0BSET 0xD1.0
L64:
                  	                  	}
  C09: 0E00       	RET
_Function_T0Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_Timer.c
                  	                  	说    明：	定时器设置（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	
                  	                  	/**************************************************************************
                  	                  		Timer 0 initialize(RTC，需使能外置32768 crystal)
                  	                  	**************************************************************************/
                  	                  	void T0Init( void )
                  	                  	{
                  	                  		FT0EN = 0;
  C0A: 67D8       	B0BCLR 0xD8.7
L35:
                  	                  		T0M = 0x00;
  C0B: 3700       	B0MOV 0x87, #00h
  C0C: 2BD8       	CLR 0xD8
L36:
                  	                  		FT0TB = 1;			//set RTC mode
  C0D: 68D8       	B0BSET 0xD8.0
L37:
                  	                  		FT0IEN = 0;
  C0E: 60C7       	B0BCLR 0xC7.0
L38:
                  	                  		FT0IRQ = 0;			//停止T0计时/中断/中断请求位
  C0F: 60C6       	B0BCLR 0xC6.0
L39:
                  	                  		FT0EN = 1;			//开启0.5s计时
  C10: 6FD8       	B0BSET 0xD8.7
L40:
                  	                  	}
  C11: 0E00       	RET
_Function_TC1Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  		TC1 initialize(10ms)
                  	                  		TC1R initial value = 65536 - (TC1 interrupt interval time * TC1 clock rate)
                  	                  		TC1D initial value = TC1R + (PWM high pulse width period / TC1 clock rate)
                  	                  	**************************************************************************/
                  	                  	void TC1Init( void )
                  	                  	{
                  	                  		TC1M = 0x40 ;		//0b01000000，Disable,Fcpu/8
  C12: 2D40       	MOV A, #40h
  C13: 2FE9       	B0MOV TC1M, A
L46:
                  	                  		TC1CL = 0x3C ;
  C14: 2D3C       	MOV A, #3ch
  C15: 2FEA       	B0MOV TC1CL, A
L47:
                  	                  		TC1RL = 0x3C ;		//10ms（Fcpu = 2M)
  C16: 2FEB       	B0MOV TC1RL, A
L48:
                  	                  		TC1CH = 0xF6 ;
  C17: 2DF6       	MOV A, #f6h
  C18: 2F9D       	B0MOV TC1CH, A
L49:
                  	                  		TC1RH = 0xF6 ;		//10ms（Fcpu = 2M)
  C19: 2F9E       	B0MOV TC1RH, A
L50:
                  	                  		FTC1IRQ = 0;		//清TC1中断请求位
  C1A: 62C6       	B0BCLR INTRQ1.2
L51:
                  	                  		FTC1IEN = 1;		//enable TC1中断
  C1B: 6AC7       	B0BSET INTEN1.2
L52:
                  	                  		FTC1ENB = 1 ;		//使能TC1定时器
  C1C: 6FE9       	B0BSET TC1M.7
L53:
                  	                  	}
  C1D: 0E00       	RET
_Function_TC2Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  		TC2 initialize(Buzzer 4KHZ，PT11口)
                  	                  		TC2R initial value = 65536 - (TC2 interrupt interval time * TC2 clock rate)
                  	                  		TC2D initial value = TC2R + (PWM high pulse width period / TC2 clock rate)
                  	                  	**************************************************************************/
                  	                  	void TC2Init( void )
                  	                  	{
                  	                  		TC2M = 0x40 ;		//0b01000000，Disable,Fcpu/8
  C1E: 2D40       	MOV A, #40h
  C1F: 2FEC       	B0MOV TC2M, A
L59:
                  	                  		TC2CL = 0xC1 ;
  C20: 2DC1       	MOV A, #c1h
  C21: 2FED       	B0MOV TC2CL, A
L60:
                  	                  		TC2RL = 0xC1 ;		//250us
  C22: 2FEE       	B0MOV TC2RL, A
L61:
                  	                  		TC2CH = 0xFF ;
  C23: 2DFF       	MOV A, #ffh
  C24: 2FAC       	B0MOV TC2CH, A
L62:
                  	                  		TC2RH = 0xFF ;		//250us
  C25: 2FAD       	B0MOV TC2RH, A
L63:
                  	                  		TC2DL6 = 0xE0 ;
  C26: 2DE0       	MOV A, #e0h
  C27: 370E       	B0MOV 0x87, #0Eh
  C28: 1F0A       	MOV 0x0A, A
L64:
                  	                  		TC2DH6 = 0xFF ;		//125us（1/2 duty)
  C29: 2DFF       	MOV A, #ffh
  C2A: 1F0B       	MOV 0x0B, A
L65:
                  	                  	}
  C2B: 0E00       	RET
_Function_Drv_UartTX_Init_code:
                  	                  	/**************************************************************************
                  	                  	文件名称：	Drv_Uart.c
                  	                  	说    明：	串口函数集合（驱动层）
                  	                  	作    者:	Liaoy
                  	                  	版    本：	V1.0
                  	                  	芯	  片:	SN8P29XX
                  	                  	修订记录：
                  	                  	**************************************************************************/
                  	                  	#include "Include.h"
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void Drv_UartTX_Init(void)
                  	                  	函数功能：	UART TX初始化
                  	                  	输入参数：	无
                  	                  	输出参数：	无
                  	                  	返回值  ：	无
                  	                  	占用空间：	TBD
                  	                  	备    注：	无
                  	                  	**************************************************************************/
                  	                  	void Drv_UartTX_Init(void)
                  	                  	{
                  	                  		FP14M = 1;			//TX输出
  C2C: 6CC1       	B0BSET 0xC1.4
L35:
                  	                  		URCR1 = B9600 ;
  C2D: 2DE6       	MOV A, #e6h
  C2E: 2F8D       	B0MOV URCR1, A
L36:
                  	                  		URRX1 = 0x04 ;		//Fuart (Fhosc=8Hz)=Fhosc/16，Disable UART RX，Disable UART RX parity bit function.	
  C2F: 2D04       	MOV A, #04h
  C30: 2F8C       	B0MOV URRX1, A
L37:
                  	                  		URTX1 = 0x84 ;		//Enable UART TX, Disable UART TX parity bit function.
  C31: 2D84       	MOV A, #84h
  C32: 2F8B       	B0MOV URTX1, A
L38:
                  	                  	}
  C33: 0E00       	RET
_Function_Drv_UartRX_Init_code:
                  	                  	
                  	                  	/**************************************************************************
                  	                  	函数名称：	void Drv_UartRX_Init(void)
                  	                  	函数功能：	UART RX初始化
